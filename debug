local function startJustificationWatch()
    notifiedJustifications = {}
    justificationWatchConn = RunService.Heartbeat:Connect(function()
        for _, countryData in ipairs(workspace.CountryData:GetChildren()) do
            local countryName = countryData.Name
            local diplomacy = countryData:FindFirstChild("Diplomacy")
            if diplomacy then
                local actions = diplomacy:FindFirstChild("Actions")
                if actions then
                    notifiedJustifications[countryName] = notifiedJustifications[countryName] or {}
                    local currentActions = {}
                    for _, action in ipairs(actions:GetChildren()) do
                        local targetCountry = action.Name
                        currentActions[targetCountry] = true
                        if not notifiedJustifications[countryName][targetCountry] then
                            Library:Notify({
                                Title = "Justification Started",
                                Description = string.format("%s has started justifying on %s", countryName, targetCountry),
                                Time = 5,
                            })
                            notifiedJustifications[countryName][targetCountry] = true
                        end
                    end
                    for prevTarget, _ in pairs(notifiedJustifications[countryName]) do
                        if not currentActions[prevTarget] then
                            notifiedJustifications[countryName][prevTarget] = nil
                        end
                    end
                else
                    notifiedJustifications[countryName] = {}
                end
            end
        end
    end)
end

local function stopJustificationWatch()
    if justificationWatchConn then
        justificationWatchConn:Disconnect()
        justificationWatchConn = nil
    end
    notifiedJustifications = {}
end

local function startJustificationWatchOwn()
    notifiedJustificationsOnOwn = {}
    justificationWatchOwnConn = RunService.Heartbeat:Connect(function()
        local myCountry = getCountryByLeader()
        if not myCountry then return end
        for _, countryData in ipairs(workspace.CountryData:GetChildren()) do
            local countryName = countryData.Name
            if countryName ~= myCountry then
                local diplomacy = countryData:FindFirstChild("Diplomacy")
                if diplomacy then
                    local actions = diplomacy:FindFirstChild("Actions")
                    if actions then
                        notifiedJustificationsOnOwn[countryName] = notifiedJustificationsOnOwn[countryName] or {}
                        local currentTargets = {}
                        for _, action in ipairs(actions:GetChildren()) do
                            local targetCountry = action.Name
                            if targetCountry == myCountry then
                                currentTargets[targetCountry] = true
                                if not notifiedJustificationsOnOwn[countryName][targetCountry] then
                                    Library:Notify({
                                        Title = "Justification Alert",
                                        Description = string.format("%s is starting to justify on your country %s", countryName, myCountry),
                                        Time = 5,
                                    })
                                    notifiedJustificationsOnOwn[countryName][targetCountry] = true
                                end
                            end
                        end
                        for prevTarget, _ in pairs(notifiedJustificationsOnOwn[countryName]) do
                            if not currentTargets[prevTarget] then
                                notifiedJustificationsOnOwn[countryName][prevTarget] = nil
                            end
                        end
                    else
                        notifiedJustificationsOnOwn[countryName] = {}
                    end
                else
                    notifiedJustificationsOnOwn[countryName] = {}
                end
            else
                notifiedJustificationsOnOwn[countryName] = {}
            end
        end
    end)
end

local function stopJustificationWatchOwn()
    if justificationWatchOwnConn then
        justificationWatchOwnConn:Disconnect()
        justificationWatchOwnConn = nil
    end
    notifiedJustificationsOnOwn = {}
end

