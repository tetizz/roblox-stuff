local AutomationsGroup = ScriptsTab:AddLeftGroupbox("Automations", "dollar-sign")

local developInterval = 35
local infrastructureInterval = 35

local developRunning = false
local infrastructureRunning = false

local function startDevelopCity()
    developRunning = true
    spawn(function()
        while developRunning do
            local myCountry = getCountryByLeader()
            if not myCountry then
                wait(1)
                continue
            end

            local citiesFolder = workspace:FindFirstChild("Baseplate") and workspace.Baseplate:FindFirstChild("Cities") and workspace.Baseplate.Cities:FindFirstChild(myCountry)
            if not citiesFolder then
                wait(1)
                continue
            end

            for _, city in ipairs(citiesFolder:GetChildren()) do
                local tierValue = city:GetAttribute("tier") or 0
                if tierValue < 10 then
                    local args = {
                        { city },
                        "Develop City"
                    }
                    workspace.GameManager.CreateBuilding:FireServer(unpack(args))
                end
            end

            wait(developInterval)
        end
    end)
end

local function stopDevelopCity()
    developRunning = false
end

local function startInfrastructure()
    infrastructureRunning = true
    spawn(function()
        while infrastructureRunning do
            local myCountry = getCountryByLeader()
            if not myCountry then
                wait(1)
                continue
            end

            local citiesFolder = workspace:FindFirstChild("Baseplate") and workspace.Baseplate:FindFirstChild("Cities") and workspace.Baseplate.Cities:FindFirstChild(myCountry)
            if not citiesFolder then
                wait(1)
                continue
            end

            for _, city in ipairs(citiesFolder:GetChildren()) do
                local infraValue = city:GetAttribute("infrastructure") or 0
                if infraValue < 10 then
                    local args = {
                        { city },
                        "Infrastructure"
                    }
                    workspace.GameManager.CreateBuilding:FireServer(unpack(args))
                end
            end

            wait(infrastructureInterval)
        end
    end)
end

local function stopInfrastructure()
    infrastructureRunning = false
end

local developToggle = AutomationsGroup:AddToggle("DevelopCityAutomation", {
    Text = "Develop City Automation",
    Default = false,
    Callback = function(on)
        if on then
            startDevelopCity()
            Library:Notify({ Title = "Develop City Automation", Description = "Enabled", Time = 3 })
        else
            stopDevelopCity()
            Library:Notify({ Title = "Develop City Automation", Description = "Disabled", Time = 3 })
        end
    end,
})

local developIntervalSlider = AutomationsGroup:AddSlider("DevelopCityInterval", {
    Text = "Develop City Interval (sec)",
    Default = 35,
    Min = 35,
    Max = 100,
    Rounding = 0,
    Compact = false,
    Suffix = "s",
    Callback = function(value)
        developInterval = value
    end,
})

local infrastructureToggle = AutomationsGroup:AddToggle("InfrastructureAutomation", {
    Text = "Infrastructure Automation",
    Default = false,
    Callback = function(on)
        if on then
            startInfrastructure()
            Library:Notify({ Title = "Infrastructure Automation", Description = "Enabled", Time = 3 })
        else
            stopInfrastructure()
            Library:Notify({ Title = "Infrastructure Automation", Description = "Disabled", Time = 3 })
        end
    end,
})

local infrastructureIntervalSlider = AutomationsGroup:AddSlider("InfrastructureInterval", {
    Text = "Infrastructure Interval (sec)",
    Default = 35,
    Min = 35,
    Max = 100,
    Rounding = 0,
    Compact = false,
    Suffix = "s",
    Callback = function(value)
        infrastructureInterval = value
    end,
})
