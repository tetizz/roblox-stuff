local AutomationsGroup = ScriptsTab:AddLeftGroupbox("Automations", "dollar-sign")

local developInterval = 35
local infrastructureInterval = 35

local developRunning = false
local infrastructureRunning = false

local function startDevelopCity()
    developRunning = true
    spawn(function()
        while developRunning do
            local myCountry = getCountryByLeader()
            if not myCountry then
                wait(1)
                continue
            end
            local citiesFolder = workspace:FindFirstChild("Baseplate") and workspace.Baseplate:FindFirstChild("Cities") and workspace.Baseplate.Cities:FindFirstChild(myCountry)
            if not citiesFolder then
                wait(1)
                continue
            end
            for _, city in ipairs(citiesFolder:GetChildren()) do
                local tierValue = city:GetAttribute("tier") or 0
                if tierValue < 10 then
                    local args = {
                        { city },
                        "Develop City"
                    }
                    workspace.GameManager.CreateBuilding:FireServer(unpack(args))
                end
            end
            wait(developInterval)
        end
    end)
end

local function stopDevelopCity()
    developRunning = false
end

local function startInfrastructure()
    infrastructureRunning = true
    spawn(function()
        while infrastructureRunning do
            local myCountry = getCountryByLeader()
            if not myCountry then
                wait(1)
                continue
            end
            local citiesFolder = workspace:FindFirstChild("Baseplate") and workspace.Baseplate:FindFirstChild("Cities") and workspace.Baseplate.Cities:FindFirstChild(myCountry)
            if not citiesFolder then
                wait(1)
                continue
            end
            for _, city in ipairs(citiesFolder:GetChildren()) do
                local infraValue = city:GetAttribute("infrastructure") or 0
                if infraValue < 10 then
                    local args = {
                        { city },
                        "Infrastructure"
                    }
                    workspace.GameManager.CreateBuilding:FireServer(unpack(args))
                end
            end
            wait(infrastructureInterval)
        end
    end)
end

local function stopInfrastructure()
    infrastructureRunning = false
end

