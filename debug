end

local function startPeace()
    processedWars = {}
    lastPeaceTime = 0
    peaceConn = RunService.Heartbeat:Connect(function()
        local now = os.clock()
        if now - lastPeaceTime < 1 then return end
        lastPeaceTime = now
        local myCountry = getCountryByLeader()
        if not myCountry then return end
        local warsFolder = workspace:FindFirstChild("Wars")
        if not warsFolder then return end
        for warName in pairs(processedWars) do
            if not warsFolder:FindFirstChild(warName) then
                processedWars[warName] = nil
            end
        end
        for _, war in ipairs(warsFolder:GetChildren()) do
            local warName = war.Name
            if not processedWars[warName] then
                local attacker = war:FindFirstChild("Attacker")
                if attacker and attacker:FindFirstChild(myCountry) then
                    local defender = war:FindFirstChild("Defender")
                    if defender then
                        for _, def in ipairs(defender:GetChildren()) do
                            local defName = def.Name
                            local args = {
                                defName,
                                "PeaceOut",
                                {
                                    warName,
                                    "Demand",
                                    {
                                        AnnexSome = {},
                                        Money = { Percentage = 75 },
                                        Resource = { Percentage = 75 },
                                    }
                                }
                            }
                            ManageAlliance:FireServer(unpack(args))
                            Library:Notify({ Title = "Auto Peace", Description = ("Sent PeaceOut to %s for %s"):format(defName, warName), Time = 3 })
                        end
                    end
                    processedWars[warName] = true
                end
            end
        end
    end)
end

local function stopPeace()
    if peaceConn then
        peaceConn:Disconnect()
        peaceConn = nil
    end
end

local function startRebelWatch()
    notifiedFunders = {}
    rebelWatchConn = RunService.Heartbeat:Connect(function()
        for _, countryData in ipairs(workspace.CountryData:GetChildren()) do
            local countryName = countryData.Name
            local rebelFolder = countryData:FindFirstChild("Rebel")
            if rebelFolder then
                notifiedFunders[countryName] = notifiedFunders[countryName] or {}
                local currentFunders = {}
                for _, funder in ipairs(rebelFolder:GetChildren()) do
                    local funderName = funder.Name
                    currentFunders[funderName] = true
                    if not notifiedFunders[countryName][funderName] then
                        Library:Notify({
                            Title = "Rebel Funding Detected",
                            Description = funderName .. " is funding rebels in " .. countryName,
                            Time = 5,
                        })
                        notifiedFunders[countryName][funderName] = true
                    end
                end
                for previousFunder, _ in pairs(notifiedFunders[countryName]) do
                    if not currentFunders[previousFunder] then
                        notifiedFunders[countryName][previousFunder] = nil
                    end
                end
            else
                notifiedFunders[countryName] = {}
            end
        end
    end)
end

local function stopRebelWatch()
    if rebelWatchConn then
        rebelWatchConn:Disconnect()
        rebelWatchConn = nil
    end
    notifiedFunders = {}
end

