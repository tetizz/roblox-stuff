-- Auto AI Trading (Authorized / Owner Setup)
-- Requires a server RemoteEvent: ReplicatedStorage.AutoTradeRequest
-- Server should validate:
-- - sender is leader
-- - target is AI
-- - target has >= 1 city in workspace.Baseplate.Cities[targetName]
-- - target net income = Revenue.Total - Expenses.Total > 0
-- - our flow >= 0
-- - units allow fractions (rounded)
-- - non-consumer goods cap <= 5
-- Then it should apply the trade and create/maintain:
-- workspace.CountryData[myCountry].Resources[resource].Trade[targetName]

local repo = "https://raw.githubusercontent.com/deividcomsono/Obsidian/main/"
local Library = loadstring(game:HttpGet(repo .. "Library.lua"))()
local SaveManager = loadstring(game:HttpGet(repo .. "addons/SaveManager.lua"))()
local ThemeManager = loadstring(game:HttpGet(repo .. "addons/ThemeManager.lua"))()

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer
local CountryData = workspace:WaitForChild("CountryData")

local Baseplate = workspace:WaitForChild("Baseplate")
local CitiesRoot = Baseplate:WaitForChild("Cities")

local Assets = ReplicatedStorage:WaitForChild("Assets")
local Resources = Assets:WaitForChild("Resources")

local TradeRemote = ReplicatedStorage:WaitForChild("AutoTradeRequest") -- you own this in your place

local CONFIG = {
	Enabled = false,
	ResourceName = "Consumer Goods",
	TargetPercent = 0.79, -- 0 -> 0.8
	DelaySeconds = 2.0, -- 0.0 -> 10.0
	MaxPartnersPerResource = 100,
	AttemptCheckDelay = 1.5,
	CooldownSeconds = 120,
	Debug = true
}

local function log(...)
	if CONFIG.Debug then
		print("[AutoTrade]", ...)
	end
end

local function countryHasAtLeastOneCity(countryName)
	local folder = CitiesRoot:FindFirstChild(countryName)
	if not folder then
		return false
	end
	return #folder:GetChildren() >= 1
end

local function getMyCountryFolder()
	local myName = LocalPlayer.Name
	for _, country in ipairs(CountryData:GetChildren()) do
		local leader = country:FindFirstChild("Leader")
		if leader and leader.Value == myName then
			return country
		end
	end
end

local function assertStillLeader()
	local c = getMyCountryFolder()
	if not c then
		return false
	end
	return true, c
end

local function isAICountry(country)
	local leader = country:FindFirstChild("Leader")
	return leader and string.find(leader.Value, "AI") ~= nil
end

local function getTradeFolder(country, resource)
	local rf = country:FindFirstChild("Resources")
	if not rf then return end
	local res = rf:FindFirstChild(resource)
	if not res then return end
	return res:FindFirstChild("Trade")
end

local function getTradeCount(country, resource)
	local trade = getTradeFolder(country, resource)
	return trade and #trade:GetChildren() or 0
end

local function hasTradeWith(country, resource, partner)
	local trade = getTradeFolder(country, resource)
	return trade and trade:FindFirstChild(partner) ~= nil
end

local function tradeExists(myCountry, resource, targetName)
	local trade = getTradeFolder(myCountry, resource)
	if not trade then return false end
	return trade:FindFirstChild(targetName) ~= nil
end

local function getMyFlow(country, resource)
	local rf = country:FindFirstChild("Resources")
	if not rf then return end
	local res = rf:FindFirstChild(resource)
	if not res then return end
	local flow = res:FindFirstChild("Flow")
	return flow and flow.Value
end

local function isFlowNonNegative(country, resource)
	local flow = getMyFlow(country, resource)
	if type(flow) ~= "number" then
		return true
	end
	return flow >= 0
end

local function getRevenueTotal(country)
	local econ = country:FindFirstChild("Economy")
	if not econ then return end
	local revenue = econ:FindFirstChild("Revenue")
	if not revenue then return end
	return revenue:GetAttribute("Total")
end

local function getExpensesTotal(country)
	local econ = country:FindFirstChild("Economy")
	if not econ then return end
	local expenses = econ:FindFirstChild("Expenses")
	if not expenses then return end
	return expenses:GetAttribute("Total")
end

local function getNetIncome(country)
	local rev = getRevenueTotal(country)
	local exp = getExpensesTotal(country)
	if type(rev) ~= "number" or type(exp) ~= "number" then
		return
	end
	return rev - exp
end

local function getUnitSellPrice(resource)
	local v = Resources:FindFirstChild(resource)
	if not v then return end
	return v.Value * 0.8
end

local function getTradeIncome(country)
	local econ = country:FindFirstChild("Economy")
	if not econ then return end
	local revenue = econ:FindFirstChild("Revenue")
	if not revenue then return end
	local tradeExport = revenue:FindFirstChild("TradeExport")
	if not tradeExport then return end
	return tradeExport.Value
end

-- Fractional units: rounded to 2 decimals
-- Non-consumer goods cap at 5
local function computeUnitsFromNet(netIncome, unitSellPrice)
	if type(netIncome) ~= "number" or netIncome <= 0 then
		return 0
	end

	local targetMoney = netIncome * CONFIG.TargetPercent
	local units = targetMoney / unitSellPrice

	units = math.floor(units * 100) / 100 -- 2 decimals

	if CONFIG.ResourceName ~= "Consumer Goods" and units > 5 then
		units = 5
	end

	-- If it would be too tiny, skip (server can also clamp)
	if units <= 0 then
		return 0
	end

	return units
end

local function sendTrade(targetName, resource, units)
	-- server enforces multiplier = 1
	TradeRemote:FireServer(targetName, resource, units, 1)
end

-- Cooldowns
local Cooldowns = {}
local Pending = {}

local function now()
	return os.clock()
end

local function isOnCooldown(name)
	local t = Cooldowns[name]
	return t and t > now()
end

local function setCooldown(name)
	Cooldowns[name] = now() + CONFIG.CooldownSeconds
end

local function clearCooldown(name)
	Cooldowns[name] = nil
end

