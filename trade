--============================================================
-- Auto Trade logic
--============================================================
local function getValidCandidates(myCountry, resource, unitSellPrice)
	local valid = {}

	for _, target in ipairs(CountryData:GetChildren()) do
		if target ~= myCountry and isAICountry(target) and countryHasAtLeastOneCity(target.Name) then
			if not hasTradeWith(myCountry, resource, target.Name) then
				if not shouldSkipTargetSlot(target, resource) then
					if not isOnCooldown(target.Name, resource) then
						local pKey = cooldownKey(target.Name, resource)
						if not PendingAttempts[pKey] then
							local net = getNetIncome(target)
							if net and net > 0 then
								local units = computeUnitsFromNet(net, unitSellPrice)
								if units > 0 then
									valid[#valid + 1] = {
										name = target.Name,
										net = net,
										units = units
									}
								end
							end
						end
					end
				end
			end
		end
	end

	table.sort(valid, function(a, b)
		return a.net > b.net
	end)

	return valid
end

local function attemptOneTrade()
	local ok, myCountry = assertStillLeader()
	if not ok then
		TradeAttemptingLabel:SetText("Attempting to trade: (not leader)")
		setTradeValidList({})
		return
	end

	if not isFlowNonNegative(myCountry, CONFIG.ResourceName) then
		log("Stopped: flow is negative for " .. CONFIG.ResourceName)
		TradeAttemptingLabel:SetText("Attempting to trade: (flow negative)")
		setTradeValidList({})
		return
	end

	local price = getUnitSellPrice(CONFIG.ResourceName)
	if not price then
		TradeAttemptingLabel:SetText("Attempting to trade: (no price)")
		setTradeValidList({})
		return
	end

	local candidates = getValidCandidates(myCountry, CONFIG.ResourceName, price)

	local namesOnly = {}
	for i = 1, #candidates do
		namesOnly[i] = candidates[i].name
	end
	setTradeValidList(namesOnly)

	local pick = candidates[1]
	if not pick then
		TradeAttemptingLabel:SetText("Attempting to trade: (none)")
		return
	end

	setTradeAttempting(CONFIG.ResourceName, pick.units, pick.name)

	local pendingKey = cooldownKey(pick.name, CONFIG.ResourceName)
	PendingAttempts[pendingKey] = true

	sendTrade(pick.name, CONFIG.ResourceName, pick.units)
	log("Attempted", pick.units, CONFIG.ResourceName, "to", pick.name, "(net:", pick.net .. ")")

	task.delay(CONFIG.AttemptCheckDelay, function()
		local ok2, myCountry2 = assertStillLeader()
		if not ok2 then
			PendingAttempts[pendingKey] = nil
			return
		end

		local accepted = tradeExists(myCountry2, CONFIG.ResourceName, pick.name)
		if accepted then
			clearCooldown(pick.name, CONFIG.ResourceName)
			log("Accepted:", pick.name)
		else
			setCooldown(pick.name, CONFIG.ResourceName)
			log("Rejected/Failed:", pick.name, "-> cooldown", CONFIG.CooldownSeconds .. "s")
		end

		PendingAttempts[pendingKey] = nil
	end)
end

--============================================================
-- Auto Build logic (NO delay: attempts continuously but is guarded per city/build)
--============================================================
local lastBuildAttempt = 0

local function attemptAutoBuildOnce()
	local ok = assertStillLeader()
	if not ok then
		BuildAttemptLabel:SetText("Attempt: (not leader)")
		return
	end

	local cities, folder = getAllMyCitiesSorted()
	BuildCitiesFolderLabel:SetText("Cities Folder: " .. (folder and folder.Name or "(none)"))
	BuildCitiesCountLabel:SetText("Cities Found: " .. tostring(#cities))

	if #cities == 0 then
		BuildAttemptLabel:SetText("Attempt: (no cities found)")
		return
	end

	local list = CONFIG.AutoBuildSelected
	if type(list) ~= "table" or #list == 0 then
		BuildAttemptLabel:SetText("Attempt: (no buildings selected)")
		return
	end

	if CONFIG.AutoBuildCityIndex > #cities then
		CONFIG.AutoBuildCityIndex = 1
	end

	local city
	local tries = 0
	while tries < #cities do
		city = cities[CONFIG.AutoBuildCityIndex]
		CONFIG.AutoBuildCityIndex = CONFIG.AutoBuildCityIndex + 1
		if CONFIG.AutoBuildCityIndex > #cities then
			CONFIG.AutoBuildCityIndex = 1
		end

		tries = tries + 1

		local tier = cityTier(city)
		if type(tier) == "number" and tier >= 10 then
			city = nil
			continue
		end

		break
	end

	if not city then
		BuildAttemptLabel:SetText("Attempt: (all cities tier 10)")
		return
	end

	local tier = cityTier(city)
	local infra = cityInfrastructure(city)
	local funds, source = getMyFunds()
	local qUnit = getQueueUnitValue(city)

	BuildCityLabel:SetText("City: " .. city.Name)
	BuildTierLabel:SetText("Tier: " .. tostring(tier))
	BuildInfraLabel:SetText("Infrastructure: " .. tostring(infra))
	BuildFundsLabel:SetText("Funds: " .. tostring(funds) .. " (" .. tostring(source) .. ")")
	BuildQueueLabel:SetText("Queue Unit: " .. tostring(qUnit))

	for i = 1, #list do
		local buildingName = list[i]

		if cityHasBuilding(city, buildingName) then
			continue
		end

		if buildingName == "Infrastructure" then
			if type(infra) == "number" and infra >= 10 then
				continue
			end
		end

		local okAfford, cost = canAffordBuilding(buildingName)
		if not okAfford then
			BuildAttemptLabel:SetText("Attempt: (can't afford " .. buildingName .. ") cost=" .. tostring(cost))
			return
		end

		BuildAttemptLabel:SetText("Attempt: building " .. buildingName .. " in " .. city.Name)
		logBuild("Building", buildingName, "in", city.Name)

		fireCreateBuilding(city, buildingName)
		return
	end

	BuildAttemptLabel:SetText("Attempt: (nothing to build)")
end

