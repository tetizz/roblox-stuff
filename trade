--============================================================
-- Auto Trade core
--============================================================
local function getValidCandidates(myCountry, resource, unitSellPrice)
	local valid = {}

	for _, target in ipairs(CountryData:GetChildren()) do
		if target ~= myCountry and countryHasAtLeastOneCity(target.Name) then
			if not hasTradeWith(myCountry, resource, target.Name) then
				if not shouldSkipTargetSlot(target, resource) then
					if not isOnCooldown(target.Name, resource) then
						local pendingKey = cooldownKey(target.Name, resource)
						if not PendingAttempts[pendingKey] then
							local net = getNetIncome(target)
							if net and net > 0 then
								local units = computeUnitsFromNet(net, unitSellPrice)
								if units > 0 then
									valid[#valid + 1] = { name = target.Name, net = net, units = units }
								end
							end
						end
					end
				end
			end
		end
	end

	table.sort(valid, function(a, b)
		return a.net > b.net
	end)

	return valid
end

local function attemptOneTrade()
	local ok, myCountry = assertStillLeader()
	if not ok then
		TradeAttemptingLabel:SetText("Attempting to trade: (not leader)")
		setTradeValidList({})
		return
	end

	local price = getUnitSellPrice(CONFIG.ResourceName)
	if not price then
		TradeAttemptingLabel:SetText("Attempting to trade: (no price)")
		setTradeValidList({})
		return
	end

	local candidates = getValidCandidates(myCountry, CONFIG.ResourceName, price)

	local namesOnly = {}
	for i = 1, #candidates do
		namesOnly[i] = candidates[i].name
	end
	setTradeValidList(namesOnly)

	local pick = candidates[1]
	if not pick then
		TradeAttemptingLabel:SetText("Attempting to trade: (none)")
		return
	end

	local allowed, reason = isTradeAllowedByFlow(myCountry, CONFIG.ResourceName, pick.units)
	if not allowed then
		TradeAttemptingLabel:SetText("Attempting to trade: (blocked: " .. tostring(reason) .. ")")
		return
	end

	setTradeAttempting(CONFIG.ResourceName, pick.units, pick.name)

	local pendingKey = cooldownKey(pick.name, CONFIG.ResourceName)
	PendingAttempts[pendingKey] = true

	sendTrade(pick.name, CONFIG.ResourceName, pick.units, "Sell")
	log("Attempted", pick.units, CONFIG.ResourceName, "to", pick.name, "(net:", pick.net .. ")")

	task.delay(CONFIG.AttemptCheckDelay, function()
		local ok2, myCountry2 = assertStillLeader()
		if not ok2 then
			PendingAttempts[pendingKey] = nil
			return
		end

		local accepted = tradeExists(myCountry2, CONFIG.ResourceName, pick.name)
		if accepted then
			clearCooldown(pick.name, CONFIG.ResourceName)
		else
			setCooldown(pick.name, CONFIG.ResourceName)
		end

		PendingAttempts[pendingKey] = nil
	end)
end

--============================================================
-- Auto Build core (unchanged)
--============================================================
local function attemptAutoBuildOnce()
	local ok = assertStillLeader()
	if not ok then
		BuildAttemptLabel:SetText("Attempt: (not leader)")
		return
	end

	local cities, folder = getAllMyCitiesSorted()
	BuildCitiesFolderLabel:SetText("Cities Folder: " .. (folder and folder.Name or "(none)"))
	BuildCitiesCountLabel:SetText("Cities Found: " .. tostring(#cities))

	if #cities == 0 then
		BuildAttemptLabel:SetText("Attempt: (no cities found)")
		return
	end

	local list = CONFIG.AutoBuildSelected
	if type(list) ~= "table" or #list == 0 then
		BuildAttemptLabel:SetText("Attempt: (no buildings selected)")
		return
	end

	if CONFIG.AutoBuildCityIndex > #cities then
		CONFIG.AutoBuildCityIndex = 1
	end

	local city = cities[CONFIG.AutoBuildCityIndex]
	CONFIG.AutoBuildCityIndex = CONFIG.AutoBuildCityIndex + 1
	if CONFIG.AutoBuildCityIndex > #cities then
		CONFIG.AutoBuildCityIndex = 1
	end

	local tier = cityTier(city)
	local infra = cityInfrastructure(city)
	local funds, source = getMyFunds()
	local qUnit = getQueueUnitValue(city)

	BuildCityLabel:SetText("City: " .. city.Name)
	BuildTierLabel:SetText("Tier: " .. tostring(tier))
	BuildInfraLabel:SetText("Infrastructure: " .. tostring(infra))
	BuildFundsLabel:SetText("Funds: " .. tostring(funds) .. " (" .. tostring(source) .. ")")
	BuildQueueLabel:SetText("Queue Unit: " .. tostring(qUnit))

	for i = 1, #list do
		local buildingName = list[i]

		if buildingName == "Infrastructure" then
			if type(infra) ~= "number" or infra < 10 then
				local okAfford, cost = canAffordBuilding("Infrastructure")
				if not okAfford then
					BuildAttemptLabel:SetText("Attempt: (can't afford Infrastructure) cost=" .. tostring(cost))
					return
				end
				BuildAttemptLabel:SetText("Attempt: Infrastructure in " .. city.Name)
				fireCreateBuilding(city, "Infrastructure")
				return
			end
			continue
		end

		if buildingName == "Develop City" then
			if type(tier) ~= "number" or tier < 10 then
				local okAfford, cost = canAffordBuilding("Develop City")
				if not okAfford then
					BuildAttemptLabel:SetText("Attempt: (can't afford Develop City) cost=" .. tostring(cost))
					return
				end
				BuildAttemptLabel:SetText("Attempt: Develop City in " .. city.Name)
				fireCreateBuilding(city, "Develop City")
				return
			end
			continue
		end

		if cityHasBuilding(city, buildingName) then
			continue
		end

		local okAfford, cost = canAffordBuilding(buildingName)
		if not okAfford then
			BuildAttemptLabel:SetText("Attempt: (can't afford " .. buildingName .. ") cost=" .. tostring(cost))
			return
		end

		BuildAttemptLabel:SetText("Attempt: " .. buildingName .. " in " .. city.Name)
		fireCreateBuilding(city, buildingName)
		return
	end

	BuildAttemptLabel:SetText("Attempt: (nothing to do)")
end

--============================================================
-- Watcher (rebel funding) - unchanged
--============================================================
local notifiedFunders = {}

local function countryMatchesFilter(countryName)
	local filter = tostring(CONFIG.WatcherCountryFilter or "")
	if filter == "" then
		return true
	end
	return string.find(countryName:lower(), filter:lower(), 1, true) ~= nil
end

local function checkRebelFunding()
	local newHits = 0

	for _, country in ipairs(CountryData:GetChildren()) do
		local countryName = country.Name
		if countryMatchesFilter(countryName) then
			local rebelFolder = country:FindFirstChild("Rebel")
			notifiedFunders[countryName] = notifiedFunders[countryName] or {}

			if rebelFolder then
				local currentFunders = {}

				for _, funder in ipairs(rebelFolder:GetChildren()) do
					local funderName = funder.Name
					currentFunders[funderName] = true

					if not notifiedFunders[countryName][funderName] then
						newHits = newHits + 1
						safeNotify("Rebel Funding Detected", funderName .. " is funding rebels in " .. countryName, 5)
						logWatch(funderName .. " is funding rebels in " .. countryName)
						notifiedFunders[countryName][funderName] = true
					end
				end

				for prev, _ in pairs(notifiedFunders[countryName]) do
					if not currentFunders[prev] then
						notifiedFunders[countryName][prev] = nil
					end
				end
			else
				notifiedFunders[countryName] = {}
			end
		end
	end

	return newHits
end

