-- Justification Watch (constant while enabled, fixed wait)
task.spawn(function()
	while true do
		if CONFIG.JustifyWatchEnabled then
			local myName, actions = getMyActionsFolder()
			if myName and actions then
				local entries = actions:GetChildren()
				local parts = {}

				for i = 1, #entries do
					local targetName = entries[i].Name
					local remaining = getJustificationTimeRemaining(myName, targetName)
					if remaining ~= nil then
						parts[#parts + 1] = targetName .. ": " .. formatTimeSeconds(remaining)
					end
				end

				if #parts == 0 then
					JustifyListLabel:SetText("Active Justifications: (none)")
				else
					table.sort(parts)
					local maxShow = 10
					local shown = {}
					for i = 1, math.min(#parts, maxShow) do
						shown[#shown + 1] = parts[i]
					end
					local suffix = ""
					if #parts > maxShow then
						suffix = " ... +" .. tostring(#parts - maxShow)
					end
					JustifyListLabel:SetText("Active Justifications: " .. table.concat(shown, " | ") .. suffix)
				end

				JustifyLastLabel:SetText("Last Check: " .. os.date("%X"))
			else
				JustifyListLabel:SetText("Active Justifications: (not leader)")
				JustifyLastLabel:SetText("Last Check: (not leader)")
			end
		end
		task.wait(0.10)
	end
end)

