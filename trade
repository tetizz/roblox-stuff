-- Rise of Nations - Auto AI Trading
-- Locked: TargetPercent = 80%, Multiplier = 1
-- Flow capped (never exceed production)
-- Max partners = 100
-- Consumer Goods ignores occupied trade slots
-- Live Trade Income: Economy.Revenue.TradeExport
-- UI: RightShift toggle + Unload UI button

local repo = "https://raw.githubusercontent.com/deividcomsono/Obsidian/main/"
local Library = loadstring(game:HttpGet(repo .. "Library.lua"))()
local SaveManager = loadstring(game:HttpGet(repo .. "addons/SaveManager.lua"))()
local ThemeManager = loadstring(game:HttpGet(repo .. "addons/ThemeManager.lua"))()

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer
local CountryData = workspace:WaitForChild("CountryData")
local GameManager = workspace:WaitForChild("GameManager")
local ManageAlliance = GameManager:WaitForChild("ManageAlliance")

local Assets = ReplicatedStorage:WaitForChild("Assets")
local Resources = Assets:WaitForChild("Resources")

local CONFIG = {
	Enabled = false,
	ResourceName = "Consumer Goods",
	Mode = "Sell",

	TargetPercent = 0.80,
	Multiplier = 1,

	DelaySeconds = 2,
	MaxPartnersPerResource = 100,

	FlowSafetyMultiplier = 0.9,
	MaxUnitsAbsolute = 999,
	MinUnits = 1,

	SkipIfTargetSlotOccupied = true,
	Debug = true
}

local function log(...)
	if CONFIG.Debug then
		print("[AutoTrade]", ...)
	end
end

local function getMyCountryFolder()
	local myName = LocalPlayer.Name
	for _, country in ipairs(CountryData:GetChildren()) do
		local leader = country:FindFirstChild("Leader")
		if leader and leader.Value == myName then
			return country
		end
	end
end

local function assertStillLeader()
	local country = getMyCountryFolder()
	if not country then
		return false
	end
	return true, country
end

local function isAICountry(country)
	local leader = country:FindFirstChild("Leader")
	return leader and string.find(leader.Value, "AI") ~= nil
end

local function getBalance(country)
	local econ = country:FindFirstChild("Economy")
	if not econ then return end
	local bal = econ:FindFirstChild("Balance")
	return bal and bal.Value
end

local function getUnitSellPrice(resource)
	local v = Resources:FindFirstChild(resource)
	if not v then return end
	return v.Value * 0.8
end

local function getTradeFolder(country, resource)
	local resourcesFolder = country:FindFirstChild("Resources")
	if not resourcesFolder then return end
	local res = resourcesFolder:FindFirstChild(resource)
	if not res then return end
	return res:FindFirstChild("Trade")
end

local function getTradeCount(country, resource)
	local trade = getTradeFolder(country, resource)
	return trade and #trade:GetChildren() or 0
end

local function hasTradeWith(country, resource, partner)
	local trade = getTradeFolder(country, resource)
	return trade and trade:FindFirstChild(partner) ~= nil
end

local function targetSlotsOccupied(country, resource)
	return getTradeCount(country, resource) > 0
end

local function shouldSkipTargetSlot(country, resource)
	if resource == "Consumer Goods" then
		return false
	end
	return CONFIG.SkipIfTargetSlotOccupied and targetSlotsOccupied(country, resource)
end

local function getMyFlow(country, resource)
	local resourcesFolder = country:FindFirstChild("Resources")
	if not resourcesFolder then return end
	local res = resourcesFolder:FindFirstChild(resource)
	if not res then return end
	local flow = res:FindFirstChild("Flow")
	return flow and flow.Value
end

local function computeSupplyCapUnits(country, resource)
	local flow = getMyFlow(country, resource)
	if not flow then
		return CONFIG.MaxUnitsAbsolute
	end

	local cap = math.floor(flow * CONFIG.FlowSafetyMultiplier)
	if cap < 0 then cap = 0 end

	return math.min(cap, CONFIG.MaxUnitsAbsolute)
end

local function computeOptimizedUnits(balance, price)
	local deficit = math.abs(balance)
	local targetMoney = deficit * CONFIG.TargetPercent
	local units = math.floor(targetMoney / price)

	if units < CONFIG.MinUnits then
		units = CONFIG.MinUnits
	end

	if units > CONFIG.MaxUnitsAbsolute then
		units = CONFIG.MaxUnitsAbsolute
	end

	return units
end

local function sendTrade(target, resource, units)
	local ok = assertStillLeader()
	if not ok then return end

	local args = {
		target,
		"ResourceTrade",
		{
			resource,
			"Sell",
			units,
			1,
			"Trade"
		}
	}

	ManageAlliance:FireServer(unpack(args))
end

local function getTradeIncome(country)
	local econ = country:FindFirstChild("Economy")
	if not econ then return end

	local revenue = econ:FindFirstChild("Revenue")
	if not revenue then return end

	local tradeExport = revenue:FindFirstChild("TradeExport")
	if not tradeExport then return end

	return tradeExport.Value
end

local function runOnceBestFirst()
	local ok, myCountry = assertStillLeader()
	if not ok then return end

	local price = getUnitSellPrice(CONFIG.ResourceName)
	if not price then return end

	local partners = getTradeCount(myCountry, CONFIG.ResourceName)
	if partners >= CONFIG.MaxPartnersPerResource then return end

	local supplyCap = computeSupplyCapUnits(myCountry, CONFIG.ResourceName)
	if supplyCap <= 0 then return end

	local candidates = {}

	for _, target in ipairs(CountryData:GetChildren()) do
		if target ~= myCountry and isAICountry(target) then
			local bal = getBalance(target)
			if bal and bal < 0 then
				if not hasTradeWith(myCountry, CONFIG.ResourceName, target.Name) then
					if not shouldSkipTargetSlot(target, CONFIG.ResourceName) then
						table.insert(candidates, {
							country = target,
							deficit = math.abs(bal)
						})
					end
				end
			end
		end
	end

	table.sort(candidates, function(a, b)
		return a.deficit > b.deficit
	end)

	local remaining = supplyCap

	for _, data in ipairs(candidates) do
		if remaining <= 0 then break end

		if getTradeCount(myCountry, CONFIG.ResourceName) >= CONFIG.MaxPartnersPerResource then
			break
		end

		local target = data.country

		local units = computeOptimizedUnits(-data.deficit, price)
		units = math.min(units, remaining)

		if units >= CONFIG.MinUnits then
			sendTrade(target.Name, CONFIG.ResourceName, units)
			remaining -= units
			log("Sent", units, CONFIG.ResourceName, "to", target.Name)
		end
	end
end

--============================================================
-- UI
--============================================================
local Window = Library:CreateWindow({
	Title = "Auto AI Trading",
	Footer = "RoN Auto Trader",
	NotifySide = "Right",
	Resizable = true,
	EnableSidebarResize = true
})

Library.ToggleKeybind = Enum.KeyCode.RightShift

local Tabs = {
	Main = Window:AddTab("Main", "user"),
	["UI Settings"] = Window:AddTab("UI Settings", "settings")
}

local Left = Tabs.Main:AddLeftGroupbox("Trading")
local Right = Tabs.Main:AddRightGroupbox("Status")

local Toggles = Library.Toggles
local Options = Library.Options

local StatusLabel = Right:AddLabel("Status: Idle")
local CountryLabel = Right:AddLabel("Country: ?")
local SupplyLabel = Right:AddLabel("Supply Cap: ?")
local PartnerLabel = Right:AddLabel("Partners: ?")
local TradeIncomeLabel = Right:AddLabel("Trade Income: ?")

Left:AddToggle("Enabled", {
	Text = "Enable Auto Trading",
	Default = false
}):OnChanged(function()
	CONFIG.Enabled = Toggles.Enabled.Value
	StatusLabel:SetText("Status: " .. (CONFIG.Enabled and "Running" or "Idle"))
end)

Left:AddDropdown("Resource", {
	Text = "Resource",
	Values = (function()
		local list = {}
		for _, r in ipairs(Resources:GetChildren()) do
			if r:IsA("NumberValue") then
				table.insert(list, r.Name)
			end
		end
		table.sort(list)
		return list
	end)(),
	Default = CONFIG.ResourceName,
	Searchable = true
}):OnChanged(function()
	CONFIG.ResourceName = Options.Resource.Value
end)

Left:AddSlider("Delay", {
	Text = "Loop Delay",
	Default = 2,
	Min = 1,
	Max = 10,
	Rounding = 1,
	Suffix = "s"
}):OnChanged(function(v)
	CONFIG.DelaySeconds = v
end)

Left:AddSlider("FlowSafety", {
	Text = "Flow Safety %",
	Default = 90,
	Min = 50,
	Max = 100,
	Rounding = 0,
	Suffix = "%"
}):OnChanged(function(v)
	CONFIG.FlowSafetyMultiplier = v / 100
end)

Left:AddSlider("MaxPartners", {
	Text = "Max Partners",
	Default = 100,
	Min = 1,
	Max = 100,
	Rounding = 0
}):OnChanged(function(v)
	CONFIG.MaxPartnersPerResource = v
end)

Left:AddButton("Run Once", function()
	runOnceBestFirst()
end)

Left:AddButton("Unload UI", function()
	if Window and Window.Destroy then
		Window:Destroy()
	else
		for _, gui in ipairs(CoreGui:GetChildren()) do
			if string.find(gui.Name:lower(), "obsidian") then
				gui:Destroy()
			end
		end
	end
end)

--============================================================
-- Theme + Save
--============================================================
ThemeManager:SetLibrary(Library)
SaveManager:SetLibrary(Library)

ThemeManager:SetFolder("RoN_AutoTrade")
SaveManager:SetFolder("RoN_AutoTrade")

SaveManager:IgnoreThemeSettings()
ThemeManager:ApplyToTab(Tabs["UI Settings"])
SaveManager:BuildConfigSection(Tabs["UI Settings"])
ThemeManager:LoadDefault()
SaveManager:LoadAutoloadConfig()

--============================================================
-- Loop
--============================================================
task.spawn(function()
	while true do
		local ok, myCountry = assertStillLeader()
		if ok then
			CountryLabel:SetText("Country: " .. myCountry.Name)

			local cap = computeSupplyCapUnits(myCountry, CONFIG.ResourceName)
			SupplyLabel:SetText("Supply Cap: " .. tostring(cap))

			local partners = getTradeCount(myCountry, CONFIG.ResourceName)
			PartnerLabel:SetText("Partners: " .. tostring(partners))

			local tradeIncome = getTradeIncome(myCountry)
			TradeIncomeLabel:SetText("Trade Income: " .. tostring(tradeIncome))
		else
			CountryLabel:SetText("Country: (not leader)")
			SupplyLabel:SetText("Supply Cap: ?")
			PartnerLabel:SetText("Partners: ?")
			TradeIncomeLabel:SetText("Trade Income: ?")
		end

		if CONFIG.Enabled then
			runOnceBestFirst()
		end

		task.wait(CONFIG.DelaySeconds)
	end
end)

Library:Notify("Auto AI Trader loaded! (RightShift toggles UI)", 4)
