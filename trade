--============================================================
-- Game Refs
--============================================================
local LocalPlayer    = Players.LocalPlayer
local CountryData    = workspace:WaitForChild("CountryData")
local GameManager    = workspace:WaitForChild("GameManager")
local ManageAlliance = GameManager:WaitForChild("ManageAlliance")

local Assets         = ReplicatedStorage:WaitForChild("Assets")
local Resources      = Assets:WaitForChild("Resources")

--============================================================
-- CONFIG
--============================================================
local CONFIG = {
	Enabled                  = false,

	ResourceName             = "Consumer Goods",
	Mode                     = "Sell",
	TargetPercent            = 0.80,
	Multiplier               = 1,

	DelaySeconds             = 2.0,
	MaxPartnersPerResource   = 10,

	ResourceReserveUnits     = 25,
	CapByFlow                = true,
	FlowSafetyMultiplier     = 0.90,
	MaxUnitsAbsolute         = 999,
	MinUnits                 = 1,

	SkipIfTargetSlotOccupied = true,
	Debug                    = true,
}

--============================================================
-- Backend Helpers
--============================================================
local function log(...)
	if CONFIG.Debug then
		print("[AutoTrade]", ...)
	end
end

local function getMyCountryFolder(): Instance?
	local myName = LocalPlayer.Name
	for _, countryFolder in ipairs(CountryData:GetChildren()) do
		local leader = countryFolder:FindFirstChild("Leader")
		if leader and leader:IsA("StringValue") and leader.Value == myName then
			return countryFolder
		end
	end
	return nil
end

local function assertStillLeader(): (boolean, Instance?)
	local myCountry = getMyCountryFolder()
	if not myCountry then
		return false, nil
	end
	return true, myCountry
end

local function isAICountry(countryFolder: Instance): boolean
	local leader = countryFolder:FindFirstChild("Leader")
	if not leader or not leader:IsA("StringValue") then
		return false
	end
	return string.find(leader.Value, "AI") ~= nil
end

local function getBalance(countryFolder: Instance): number?
	local econ = countryFolder:FindFirstChild("Economy")
	if not econ then return nil end

	local bal = econ:FindFirstChild("Balance")
	if not bal or not bal:IsA("NumberValue") then return nil end

	return bal.Value
end

local function getUnitSellPrice(resourceName: string): number?
	local v = Resources:FindFirstChild(resourceName)
	if not v or not v:IsA("NumberValue") then
		return nil
	end
	return v.Value * 0.80
end

local function getTradeFolder(countryFolder: Instance, resourceName: string): Instance?
	local resFolder = countryFolder:FindFirstChild("Resources")
	if not resFolder then return nil end

	local resObj = resFolder:FindFirstChild(resourceName)
	if not resObj then return nil end

	local trade = resObj:FindFirstChild("Trade")
	if trade and trade:IsA("Folder") then
		return trade
	end
	return nil
end

local function getTradeCount(countryFolder: Instance, resourceName: string): number
	local trade = getTradeFolder(countryFolder, resourceName)
	return trade and #trade:GetChildren() or 0
end

local function hasTradeWith(countryFolder: Instance, resourceName: string, partnerName: string): boolean
	local trade = getTradeFolder(countryFolder, resourceName)
	return trade and (trade:FindFirstChild(partnerName) ~= nil) or false
end

local function targetSlotsOccupied(targetCountry: Instance, resourceName: string): boolean
	return getTradeCount(targetCountry, resourceName) > 0
end

local function getMyResourceObj(myCountry: Instance, resourceName: string): NumberValue?
	local resFolder = myCountry:FindFirstChild("Resources")
	if not resFolder then return nil end
	local obj = resFolder:FindFirstChild(resourceName)
	return (obj and obj:IsA("NumberValue")) and obj or nil
end

local function getMyStockpile(myCountry: Instance, resourceName: string): number
	local obj = getMyResourceObj(myCountry, resourceName)
	return obj and obj.Value or 0
end

local function getMyFlow(myCountry: Instance, resourceName: string): number?
	local obj = getMyResourceObj(myCountry, resourceName)
	if not obj then return nil end

	local flow = obj:FindFirstChild("Flow")
	if flow and flow:IsA("NumberValue") then
		return flow.Value
	end
	return nil
end

local function computeSupplyCapUnits(myCountry: Instance, resourceName: string): number
	local stock = getMyStockpile(myCountry, resourceName)
	local flow  = getMyFlow(myCountry, resourceName)

	local availableFromStock = stock - (CONFIG.ResourceReserveUnits or 0)
	if availableFromStock < 0 then
		availableFromStock = 0
	end

	local capByFlow = CONFIG.MaxUnitsAbsolute
	if CONFIG.CapByFlow and flow then
		capByFlow = math.max(0, math.floor(flow * (CONFIG.FlowSafetyMultiplier or 1)))
	end

	return math.min(availableFromStock, capByFlow, CONFIG.MaxUnitsAbsolute)
end

local function computeOptimizedUnits(balance: number, unitSellPrice: number, multiplier: number): number
	local deficit     = math.abs(balance)
	local targetMoney = deficit * (CONFIG.TargetPercent or 0.80)

	local effectiveUnitPrice = unitSellPrice * multiplier
	if effectiveUnitPrice <= 0 then
		return 0
	end

	local units = math.floor(targetMoney / effectiveUnitPrice)
	if units < (CONFIG.MinUnits or 1) then
		units = CONFIG.MinUnits or 1
	end
	if units > (CONFIG.MaxUnitsAbsolute or 999) then
		units = CONFIG.MaxUnitsAbsolute or 999
	end

	return units
end

local function sendResourceTrade(targetCountryName: string, resourceName: string, mode: string, units: number, multiplier: number): (boolean, string)
	local ok = assertStillLeader()
	if not ok then
		return false, "Not leader"
	end

	local args = {
		targetCountryName,
		"ResourceTrade",
		{
			resourceName,
			mode,
			units,
			multiplier,
			"Trade"
		}
	}

	ManageAlliance:FireServer(unpack(args))
	return true, "Sent"
end

--============================================================
-- Best-first runner
--============================================================
local function runOnceBestFirst(pushLogFn: ((string)->())?)
	local ok, myCountry = assertStillLeader()
	if not ok or not myCountry then
		pushLogFn = pushLogFn or log
		pushLogFn("STOP: Not leader of any country.")
		return
	end

	if CONFIG.Multiplier < 1 then
		(pushLogFn or log)("STOP: Multiplier must be >= 1.")
		return
	end

	local unitSellPrice = getUnitSellPrice(CONFIG.ResourceName)
	if not unitSellPrice then
		(pushLogFn or log)("STOP: Missing price for " .. tostring(CONFIG.ResourceName))
		return
	end

	local myPartners = getTradeCount(myCountry, CONFIG.ResourceName)
	if myPartners >= (CONFIG.MaxPartnersPerResource or 999) then
		return
	end

	local supplyCap = computeSupplyCapUnits(myCountry, CONFIG.ResourceName)
	if supplyCap <= 0 then
		return
	end

	local candidates = {}

	for _, target in ipairs(CountryData:GetChildren()) do
		local stillLeader = assertStillLeader()
		if not stillLeader then
			(pushLogFn or log)("STOP: Lost leadership mid-scan.")
			return
		end

		if target ~= myCountry and isAICountry(target) then
			local bal = getBalance(target)
			if bal and bal < 0 then
				if not hasTradeWith(myCountry, CONFIG.ResourceName, target.Name) then
					if (not CONFIG.SkipIfTargetSlotOccupied) or (not targetSlotsOccupied(target, CONFIG.ResourceName)) then
						table.insert(candidates, {
							Target  = target,
							Balance = bal,
							Deficit = math.abs(bal),
						})
					end
				end
			end
		end
	end

	table.sort(candidates, function(a, b)
		return a.Deficit > b.Deficit
	end)

	local remainingCap = supplyCap
	for _, item in ipairs(candidates) do
		local stillLeader, refreshedMyCountry = assertStillLeader()
		if not stillLeader or not refreshedMyCountry then
			return
		end
		myCountry = refreshedMyCountry

		myPartners = getTradeCount(myCountry, CONFIG.ResourceName)
		if myPartners >= (CONFIG.MaxPartnersPerResource or 999) then
			break
		end
		if remainingCap <= 0 then
			break
		end

		local target = item.Target

		if not hasTradeWith(myCountry, CONFIG.ResourceName, target.Name) then
			if (not CONFIG.SkipIfTargetSlotOccupied) or (not targetSlotsOccupied(target, CONFIG.ResourceName)) then
				local unitsOptimized = computeOptimizedUnits(item.Balance, unitSellPrice, CONFIG.Multiplier)
				local unitsFinal     = math.min(unitsOptimized, remainingCap)

				if unitsFinal >= (CONFIG.MinUnits or 1) then
					local sent, reason = sendResourceTrade(target.Name, CONFIG.ResourceName, CONFIG.Mode, unitsFinal, CONFIG.Multiplier)
					local msg = ("%s | bal: %s | units: %d | %s"):format(
						target.Name,
						tostring(item.Balance),
						unitsFinal,
						sent and "✅ sent" or ("❌ " .. reason)
					)

					if pushLogFn then pushLogFn(msg) else log(msg) end
					remainingCap -= unitsFinal
				end
			end
		end
	end
end

