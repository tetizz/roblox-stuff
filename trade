--============================================================
-- Rebel Watcher
--============================================================
local notifiedFunders = {}

local function countryMatchesFilter(countryName)
	local filter = tostring(CONFIG.WatcherCountryFilter or "")
	if filter == "" then
		return true
	end
	return string.find(countryName:lower(), filter:lower(), 1, true) ~= nil
end

local function checkRebelFunding()
	local newHits = 0

	for _, country in ipairs(CountryData:GetChildren()) do
		local countryName = country.Name
		if countryMatchesFilter(countryName) then
			local rebelFolder = country:FindFirstChild("Rebel")
			notifiedFunders[countryName] = notifiedFunders[countryName] or {}

			if rebelFolder then
				local currentFunders = {}

				for _, funder in ipairs(rebelFolder:GetChildren()) do
					local funderName = funder.Name
					currentFunders[funderName] = true

					if not notifiedFunders[countryName][funderName] then
						newHits = newHits + 1
						Library:Notify({
							Title = "Rebel Funding",
							Description = funderName .. " funding rebels in " .. countryName,
							Time = 4
						})
						logWatch(funderName .. " funding rebels in " .. countryName)

						notifiedFunders[countryName][funderName] = true
					end
				end

				for prev, _ in pairs(notifiedFunders[countryName]) do
					if not currentFunders[prev] then
						notifiedFunders[countryName][prev] = nil
					end
				end
			else
				notifiedFunders[countryName] = {}
			end
		end
	end

	return newHits
end

--============================================================
-- Justification Watch (Diplomacy.Actions: Value.X elapsed, Value.Z total)
--============================================================
local function getJustificationTimeRemaining(attackerCountry, targetCountry)
	local attacker = CountryData:FindFirstChild(attackerCountry)
	if not attacker then return end

	local dip = attacker:FindFirstChild("Diplomacy")
	if not dip then return end

	local actions = dip:FindFirstChild("Actions")
	if not actions then return end

	local entry = actions:FindFirstChild(targetCountry)
	if not entry then return end

	if entry:IsA("Vector3Value") and typeof(entry.Value) == "Vector3" then
		local elapsed = entry.Value.X
		local total = entry.Value.Z
		return math.max(total - elapsed, 0), elapsed, total
	end
end

local function formatTimeSeconds(t)
	t = tonumber(t) or 0
	local mins = math.floor(t / 60)
	local secs = math.floor(t % 60)
	return mins .. "m " .. secs .. "s"
end

local function getMyActionsFolder()
	local ok, myCountry = assertStillLeader()
	if not ok then return end
	local dip = myCountry:FindFirstChild("Diplomacy")
	if not dip then return end
	return myCountry.Name, dip:FindFirstChild("Actions")
end

