task.spawn(function()
	while true do
		local ok, myCountry = assertStillLeader()
		if ok then
			TradeCountryLabel:SetText("Country: " .. myCountry.Name)

			local partners = getTradeCount(myCountry, CONFIG.ResourceName)
			TradePartnerLabel:SetText("Partners: " .. tostring(partners))

			local flow = getCountryResourceFlow(myCountry, CONFIG.ResourceName)
			TradeFlowLabel:SetText("Flow: " .. tostring(flow))

			local live = getLiveTradeExportValue()
			if live ~= nil then
				TradeIncomeLabel:SetText("Trade Export: " .. tostring(live))
			else
				TradeIncomeLabel:SetText("Trade Export: " .. tostring(getTradeIncomeFallback(myCountry)))
			end

			TradePercentLabel:SetText("Trade Percent: " .. tostring(math.floor(CONFIG.TargetPercent * 100 + 0.5)) .. "%")
		else
			TradeCountryLabel:SetText("Country: (not leader)")
		end

		if CONFIG.TradeEnabled then
			attemptOneTrade()
		end

		task.wait(CONFIG.DelaySeconds)
	end
end)

RunService.RenderStepped:Connect(function()
	-- Auto Build (60/sec allowed)
	if CONFIG.AutoBuildEnabled then
		attemptAutoBuildOnce()
	end

	-- Auto Resupply (spam allowed)
	if CONFIG.AutoResupplyEnabled then
		local ok, _ = assertStillLeader()
		local cities, folder = getAllMyCitiesSorted()

		SupplyCitiesLabel:SetText("Cities: " .. tostring(#cities) .. " (" .. tostring(folder and folder.Name or "none") .. ")")

		local fixed = scanAndResupplyOnce()
		if fixed and #fixed > 0 then
			SupplyLastLabel:SetText("Last: " .. os.date("%X"))
			SupplySuccessListLabel:SetText("Successfully resupplied: " .. formatFixedList(fixed))
			safeNotify("Resupply", "Successfully resupplied factories: " .. formatFixedList(fixed), 5)
		end
	end
end)

task.spawn(function()
	local last = 0
	while true do
		if CONFIG.WatcherEnabled then
			local t = now()
			if CONFIG.WatcherIntervalSeconds <= 0 or (t - last) >= CONFIG.WatcherIntervalSeconds then
				last = t
				local hits = checkRebelFunding()
				WatchHitsLabel:SetText("New Funders: " .. tostring(hits))
				WatchLastLabel:SetText("Last Check: " .. string.format("%.2fs", t))
			end
		end
		task.wait(0.05)
	end
end)

