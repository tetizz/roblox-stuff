local function setAttempting(resource, units, name)
	AttemptingLabel:SetText("Attempting to trade " .. tostring(units) .. " " .. tostring(resource) .. " to " .. tostring(name))
end

local function setValidList(names)
	ValidLabel:SetText("Valid countries: " .. tostring(#names))

	local maxShow = 12
	local shown = {}
	for i = 1, math.min(#names, maxShow) do
		shown[#shown + 1] = names[i]
	end

	local suffix = ""
	if #names > maxShow then
		suffix = " ... +" .. tostring(#names - maxShow)
	end

	if #shown == 0 then
		ValidListLabel:SetText("Valid list: (none)")
	else
		ValidListLabel:SetText("Valid list: " .. table.concat(shown, ", ") .. suffix)
	end
end

