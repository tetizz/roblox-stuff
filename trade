-- Trade status + trade loop (auto, no one-time)
task.spawn(function()
	while true do
		local ok, myCountry = assertStillLeader()
		if ok then
			TradeCountryLabel:SetText("Country: " .. myCountry.Name)

			local flow = getCountryResourceFlow(myCountry, CONFIG.ResourceName)
			TradeFlowLabel:SetText("Flow: " .. tostring(flow))

			local live = getLiveTradeExportValue()
			if live ~= nil then
				TradeIncomeLabel:SetText("Trade Export: " .. tostring(live))
			else
				TradeIncomeLabel:SetText("Trade Export: " .. tostring(getTradeIncomeFallback(myCountry)))
			end

			TradePercentLabel:SetText("Trade Percent: " .. tostring(math.floor(CONFIG.TargetPercent * 100 + 0.5)) .. "%")
			TradeFlowSafetyLabel:SetText("Flow Safety: " .. (CONFIG.TradeBypassFlowSafety and "BYPASS" or "ON"))
			TradeSkipPlayersLabel:SetText("Target Filter: " .. (CONFIG.TradeSkipPlayerCountries and "AI Only" or "All Countries"))

			refreshTradeCandidates()

			if CONFIG.TradeEnabled then
				attemptOneTrade()
			else
				if #TradeCandidates == 0 then
					TradeAttemptingLabel:SetText("Attempting: (none)")
				else
					local top = TradeCandidates[1]
					local meta = TradeCandidateMeta[top.name] or top.name
					TradeAttemptingLabel:SetText("Top: " .. meta .. " | Units: " .. tostring(top.units))
				end
			end
		else
			TradeCountryLabel:SetText("Country: (not leader)")
			TradeFlowLabel:SetText("Flow: ?")
			TradeIncomeLabel:SetText("Trade Export: ?")
			TradePercentLabel:SetText("Trade Percent: ?")
			TradeAttemptingLabel:SetText("Attempting: (not leader)")
			setTradeValidList({})
		end

		task.wait(CONFIG.DelaySeconds)
	end
end)

-- Auto Build loop (throttled, runs alongside trade)
task.spawn(function()
	local last = 0
	while true do
		if CONFIG.AutoBuildEnabled then
			local t = now()
			local interval = CONFIG.AutoBuildInterval or 0.15
			if (t - last) >= interval then
				last = t
				attemptAutoBuildOnce()
			end
		end
		task.wait(0.03)
	end
end)

-- Auto Resupply loop (fast but throttled + capped)
task.spawn(function()
	local last = 0
	while true do
		if CONFIG.AutoResupplyEnabled then
			local t = now()
			local interval = CONFIG.ResupplyScanInterval or 0.25
			if (t - last) >= interval then
				last = t
				local statuses, cityCount, folder = scanAndResupplyOnce()
				SupplyCitiesLabel:SetText("Cities: " .. tostring(cityCount) .. " (" .. tostring(folder and folder.Name or "none") .. ")")

				if statuses and #statuses > 0 then
					SupplyLastLabel:SetText("Last: " .. os.date("%X"))
					SupplyDebugLabel:SetText("Last details: " .. joinList(statuses, " | "))
					safeNotify("Resupply", "Updated " .. tostring(#statuses) .. " resources", 3)
				end
			end
		end
		task.wait(0.05)
	end
end)

