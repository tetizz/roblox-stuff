--============================================================
-- Status updater + loop
--============================================================
task.spawn(function()
	while true do
		local ok, myCountry = assertStillLeader()
		if ok and myCountry then
			CountryLabel:SetText("Country: " .. myCountry.Name)

			local stock = getMyStockpile(myCountry, CONFIG.ResourceName)
			local flow  = getMyFlow(myCountry, CONFIG.ResourceName)
			local partners = getTradeCount(myCountry, CONFIG.ResourceName)

			SupplyLabel:SetText(("Supply: %s | Flow: %s"):format(tostring(stock), tostring(flow)))
			PartnerLabel:SetText(("Partners (%s): %d/%d"):format(CONFIG.ResourceName, partners, CONFIG.MaxPartnersPerResource))
		else
			CountryLabel:SetText("Country: (not leader)")
			SupplyLabel:SetText("Supply: ?")
			PartnerLabel:SetText("Partners: ?")
		end

		if CONFIG.Enabled then
			runOnceBestFirst(pushUILog)
		end

		task.wait(CONFIG.DelaySeconds)
	end
end)

Library:Notify({ Title = "AutoTrade", Description = "Loaded. Configure and enable Auto Trading.", Time = 5 })
