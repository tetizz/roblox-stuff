local function getQueueUnitValue(city)
	local queue = city:FindFirstChild("Queue")
	if not queue then return end
	local unitOrder = queue:FindFirstChild("UnitOrder")
	if not unitOrder then return end
	local unit = unitOrder:FindFirstChild("Unit")
	if not unit then return end
	return unit.Value
end

local function getBuildingCost(buildingName)
	local b = BuildingsFolder:FindFirstChild(buildingName)
	if not b then return end
	local cost = b:FindFirstChild("Cost")
	return cost and cost.Value
end

local function getMyFunds()
	local ok, myCountry = assertStillLeader()
	if not ok then
		return nil, "not leader"
	end

	local econ = myCountry:FindFirstChild("Economy")
	if econ then
		for _, key in ipairs({ "Balance", "Money", "Stockpile" }) do
			local obj = econ:FindFirstChild(key)
			if obj and type(obj.Value) == "number" then
				return obj.Value, key
			end

			local attr = econ:GetAttribute(key)
			if type(attr) == "number" then
				return attr, key
			end
		end
	end

	return nil, "unknown"
end

local function canAffordBuilding(buildingName)
	local cost = getBuildingCost(buildingName)
	local funds = getMyFunds()

	if type(cost) ~= "number" then
		return false, cost, funds
	end

	if type(funds) ~= "number" then
		return true, cost, funds
	end

	return cost <= funds, cost, funds
end

local function fireCreateBuilding(city, buildingName)
	CreateBuilding:FireServer({ city }, buildingName)
end

--============================================================
-- Auto Resupply (FAST but throttled + delta-based)
--============================================================
local ResupplyState = {
	-- [resourceName] = { nextAllowed = number }
}

local function canResupplyResource(resName)
	local st = ResupplyState[resName]
	if not st then
		return true
	end
	return now() >= (st.nextAllowed or 0)
end

local function markResupplyCooldown(resName)
	ResupplyState[resName] = ResupplyState[resName] or {}
	ResupplyState[resName].nextAllowed = now() + (CONFIG.ResupplyConfirmDelay or 1.0)
end

local function parseOperationalReason(reason)
	if type(reason) ~= "string" then return end
	local res, needStr = reason:match("([%a%s%-%_]+)%s*%[Need:%s*([%d%.]+)%s*%]")
	if not res or not needStr then return end

	res = res:gsub("^%s+", ""):gsub("%s+$", "")
	local need = tonumber(needStr)

	if res == "" or type(need) ~= "number" or need <= 0 then
		return
	end

	return res, need
end

local function isBuildingOperational(b)
	local a = b:GetAttribute("Operational")
	if type(a) == "boolean" then
		return a
	end

	local obj = b:FindFirstChild("Operational")
	if obj and typeof(obj.Value) == "boolean" then
		return obj.Value
	end
end

local function getBuildingOperationalReason(b)
	local a = b:GetAttribute("Operational_Reason")
	if type(a) == "string" and a ~= "" then
		return a
	end

	local obj = b:FindFirstChild("Operational_Reason")
	if obj and typeof(obj.Value) == "string" then
		return obj.Value
	end
end

local function getMyResourceFolder(myCountry, resourceName)
	local rf = myCountry:FindFirstChild("Resources")
	if not rf then return end
	return rf:FindFirstChild(resourceName)
end

local function getTradeFolderForMyResource(myCountry, resourceName)
	local res = getMyResourceFolder(myCountry, resourceName)
	if not res then return end
	return res:FindFirstChild("Trade")
end

local function getTradeXFromEntry(entry)
	if entry:IsA("Vector3Value") and typeof(entry.Value) == "Vector3" then
		return tonumber(entry.Value.X) or 0
	end
	if entry.Value ~= nil and type(entry.Value) == "number" then
		return entry.Value
	end
	return 0
end

local function getMyCurrentTotalTradeX(myCountry, resourceName)
	local trade = getTradeFolderForMyResource(myCountry, resourceName)
	if not trade then
		return 0
	end

	local total = 0
	for _, entry in ipairs(trade:GetChildren()) do
		total = total + getTradeXFromEntry(entry)
	end
	return total
end

local function myHasTradeWithSupplier(myCountry, resourceName, supplierName)
	local trade = getTradeFolderForMyResource(myCountry, resourceName)
	if not trade then
		return false
	end
	return trade:FindFirstChild(supplierName) ~= nil
end

local function buildSupplierListPreferExistingTrades(myCountry, resourceName)
	local suppliers = {}

	for _, c in ipairs(CountryData:GetChildren()) do
		if c ~= myCountry then
			local flow = getCountryResourceFlow(c, resourceName)
			if type(flow) == "number" and flow > 0 then
				suppliers[#suppliers + 1] = {
					name = c.Name,
					flow = flow,
					hasTrade = myHasTradeWithSupplier(myCountry, resourceName, c.Name)
				}
			end
		end
	end

	table.sort(suppliers, function(a, b)
		if a.hasTrade ~= b.hasTrade then
			return a.hasTrade == true
		end
		return a.flow > b.flow
	end)

	return suppliers
end

local function sendBuy(targetCountry, resourceName, amount)
	ManageAlliance:FireServer(targetCountry, "ResourceTrade", {
		resourceName,
		"Buy",
		amount,
		1,
		"Trade"
	})
end

local function computeTotalNeedByResource(cities)
	local needByRes = {}
	local offendersByRes = {}

	for _, city in ipairs(cities) do
		local buildingsFolder = city:FindFirstChild("Buildings")
		if buildingsFolder then
			for _, b in ipairs(buildingsFolder:GetChildren()) do
				if isBuildingOperational(b) == false then
					local resName, need = parseOperationalReason(getBuildingOperationalReason(b))
					if resName and need then
						needByRes[resName] = (needByRes[resName] or 0) + need
						offendersByRes[resName] = offendersByRes[resName] or {}
						offendersByRes[resName][#offendersByRes[resName] + 1] = b.Name .. " in " .. city.Name
					end
				end
			end
		end
	end

	return needByRes, offendersByRes
end

local function buyDeltaAcrossSuppliers(myCountry, resourceName, delta, caps)
	local remaining = delta
	local bought = 0
	local suppliersUsed = 0

	local suppliers = buildSupplierListPreferExistingTrades(myCountry, resourceName)

	for i = 1, #suppliers do
		if remaining <= 0 then break end
		if suppliersUsed >= caps.maxSuppliers then break end

		local s = suppliers[i]
		local amt = math.min(remaining, s.flow, caps.maxPerSupplier)

		if amt > 0 then
			sendBuy(s.name, resourceName, amt)
			bought = bought + amt
			remaining = remaining - amt
			suppliersUsed = suppliersUsed + 1
		end
	end

	return bought
end

local function scanAndResupplyOnce()
	local statuses = {}

	local cities, folder, myCountry = getAllMyCitiesSorted()
	if not myCountry then
		return statuses, 0, folder
	end
	if #cities == 0 then
		return statuses, 0, folder
	end

	local needByRes, offendersByRes = computeTotalNeedByResource(cities)

	local totalBudgetLeft = CONFIG.MaxUnitsTotalPerCycle or 60
	local maxPerRes = CONFIG.MaxUnitsPerResourcePerCycle or 25
	local maxSuppliers = CONFIG.MaxSuppliersPerResourcePerCycle or 3

	for resName, needTotal in pairs(needByRes) do
		if totalBudgetLeft <= 0 then
			break
		end

		if canResupplyResource(resName) then
			local currentTradeX = getMyCurrentTotalTradeX(myCountry, resName)
			local delta = needTotal - currentTradeX

			if delta > 0 then
				local capThisRes = math.min(delta, maxPerRes, totalBudgetLeft)

				local bought = buyDeltaAcrossSuppliers(myCountry, resName, capThisRes, {
					maxSuppliers = maxSuppliers,
					maxPerSupplier = capThisRes
				})

				if bought > 0 then
					totalBudgetLeft = totalBudgetLeft - bought
					markResupplyCooldown(resName)

					local msg = resName
						.. " need=" .. tostring(needTotal)
						.. " tradeX=" .. tostring(currentTradeX)
						.. " delta=" .. tostring(delta)
						.. " bought=" .. tostring(bought)

					local offenders = offendersByRes[resName] or {}
					if #offenders > 0 then
						msg = msg .. " | " .. table.concat(offenders, ", ")
					end

					statuses[#statuses + 1] = msg
					logSupply(msg)
				end
			end
		end
	end

	return statuses, #cities, folder
end

