--============================================================
-- Candidate picker + loop
--============================================================
local function getValidCandidates(myCountry, resource, unitSellPrice)
	local valid = {}

	for _, target in ipairs(CountryData:GetChildren()) do
		if target ~= myCountry and isAICountry(target) and countryHasAtLeastOneCity(target.Name) then
			if not hasTradeWith(myCountry, resource, target.Name) then
				if not isOnCooldown(target.Name) and not Pending[target.Name] then
					local net = getNetIncome(target)

					if net and net > 0 then
						local units = computeUnitsFromNet(net, unitSellPrice)
						if units > 0 then
							valid[#valid + 1] = { name = target.Name, net = net, units = units }
						end
					end
				end
			end
		end
	end

	table.sort(valid, function(a, b)
		return a.net > b.net
	end)

	return valid
end

local function attemptOneTrade()
	local ok, myCountry = assertStillLeader()
	if not ok then
		AttemptingLabel:SetText("Attempting: (not leader)")
		setValidList({})
		return
	end

	if not isFlowNonNegative(myCountry, CONFIG.ResourceName) then
		AttemptingLabel:SetText("Attempting: (flow negative)")
		setValidList({})
		return
	end

	if getTradeCount(myCountry, CONFIG.ResourceName) >= CONFIG.MaxPartnersPerResource then
		AttemptingLabel:SetText("Attempting: (max partners reached)")
		setValidList({})
		return
	end

	local price = getUnitSellPrice(CONFIG.ResourceName)
	if not price then
		AttemptingLabel:SetText("Attempting: (no price)")
		setValidList({})
		return
	end

	local candidates = getValidCandidates(myCountry, CONFIG.ResourceName, price)

	local namesOnly = {}
	for i = 1, #candidates do
		namesOnly[i] = candidates[i].name
	end
	setValidList(namesOnly)

	local pick = candidates[1]
	if not pick then
		AttemptingLabel:SetText("Attempting: (none)")
		return
	end

	setAttempting(CONFIG.ResourceName, pick.units, pick.name)

	Pending[pick.name] = true
	sendTrade(pick.name, CONFIG.ResourceName, pick.units)
	log("Attempted", pick.units, CONFIG.ResourceName, "to", pick.name, "(net:", pick.net .. ")")

	task.delay(CONFIG.AttemptCheckDelay, function()
		local ok2, myCountry2 = assertStillLeader()
		if not ok2 then
			Pending[pick.name] = nil
			return
		end

		local accepted = tradeExists(myCountry2, CONFIG.ResourceName, pick.name)
		if accepted then
			clearCooldown(pick.name)
			log("Accepted:", pick.name)
		else
			setCooldown(pick.name)
			log("Rejected/Failed:", pick.name)
		end

		Pending[pick.name] = nil
	end)
end

task.spawn(function()
	while true do
		local ok, myCountry = assertStillLeader()
		if ok then
			CountryLabel:SetText("Country: " .. myCountry.Name)
			PartnerLabel:SetText("Partners: " .. tostring(getTradeCount(myCountry, CONFIG.ResourceName)))

			local flow = getMyFlow(myCountry, CONFIG.ResourceName)
			FlowLabel:SetText("Flow: " .. tostring(flow))

			local tradeIncome = getTradeIncome(myCountry)
			TradeIncomeLabel:SetText("Trade Income: " .. tostring(tradeIncome))

			PercentLabel:SetText("Trade Percent: " .. tostring(math.floor(CONFIG.TargetPercent * 100 + 0.5)) .. "%")
		else
			CountryLabel:SetText("Country: (not leader)")
			PartnerLabel:SetText("Partners: ?")
			FlowLabel:SetText("Flow: ?")
			TradeIncomeLabel:SetText("Trade Income: ?")
			PercentLabel:SetText("Trade Percent: ?")
			AttemptingLabel:SetText("Attempting: (none)")
			ValidLabel:SetText("Valid countries: 0")
			ValidListLabel:SetText("Valid list: (none)")
		end

		if CONFIG.Enabled then
			attemptOneTrade()
		end

		task.wait(CONFIG.DelaySeconds)
	end
end)

