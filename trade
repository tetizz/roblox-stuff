-- Trade UI helpers
local function setTradeAttempting(resource, units, name)
	TradeAttemptingLabel:SetText("Attempting to trade " .. tostring(units) .. " " .. tostring(resource) .. " to " .. tostring(name))
end

local function setTradeValidList(names)
	TradeValidLabel:SetText("Valid countries: " .. tostring(#names))

	local maxShow = 12
	local shown = {}
	for i = 1, math.min(#names, maxShow) do
		shown[#shown + 1] = names[i]
	end

	local suffix = ""
	if #names > maxShow then
		suffix = " ... +" .. tostring(#names - maxShow)
	end

	if #shown == 0 then
		TradeValidListLabel:SetText("Valid list: (none)")
	else
		TradeValidListLabel:SetText("Valid list: " .. table.concat(shown, ", ") .. suffix)
	end
end

local function formatFixedList(fixed)
	if not fixed or #fixed == 0 then
		return "(none)"
	end
	local parts = {}
	for i = 1, #fixed do
		parts[#parts + 1] = fixed[i].building .. " in " .. fixed[i].city
	end
	return table.concat(parts, " | ")
end

