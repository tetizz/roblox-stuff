-- Anti-AFK Setup
local function antiAFK(nonotify)
    local GC = getconnections or get_signal_cons
    if GC then
        for i,v in pairs(GC(plr.Idled)) do
            if v["Disable"] then
                v["Disable"](v)
            elseif v["Disconnect"] then
                v["Disconnect"](v)
            end
        end
    else
        local virtualUserService = game:GetService("VirtualUser")
        local VirtualUser = type(cloneref) == "function" and cloneref(virtualUserService) or virtualUserService
        trackRuntimeConnection(plr.Idled:Connect(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton2(Vector2.new())
        end))
    end
    if not nonotify then
        -- Optional notify here
    end
end

antiAFK(true)

