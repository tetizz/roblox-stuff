-- === Restart-safe alternating CollectZone size loop ===
local function alternateCollectZoneSize()
    sizeLoopActive = false
    task.wait(0.1)
    sizeLoopActive = true
    task.spawn(function()
        while sizeLoopActive do
            local myTycoon = Workspace.Map.Tycoons:FindFirstChild(localPlayer.Name)
            if myTycoon and myTycoon:FindFirstChild("TycoonTemplate") then
                local tCollectZone = myTycoon.TycoonTemplate:FindFirstChild("T_Collect_Zone")
                if tCollectZone then
                    local zonePart = tCollectZone:FindFirstChild("CollectZone")
                    if zonePart and zonePart:IsA("BasePart") then
                        zonePart.Size = Vector3.new(2050, 2050, 2050)
                        task.wait(2)
                        if not sizeLoopActive then break end
                        zonePart.Size = Vector3.new(1950, 1950, 1950)
                        task.wait(2)
                    else
                        task.wait(2)
                    end
                else
                    task.wait(2)
                end
            else
                task.wait(2)
            end
        end
    end)
end
alternateCollectZoneSize()

-- === Forcefield ignore ===
local function disableForcefields()
    local myTycoon = Workspace.Map.Tycoons:FindFirstChild(localPlayer.Name)
    if myTycoon then
        local ffFolder = myTycoon:FindFirstChild("F2_Forcefield")
        if ffFolder then
            for _, obj in ipairs(ffFolder:GetDescendants()) do
                if obj:IsA("BasePart") and obj.Name:lower():find("forcefield") then
                    obj.CanCollide = false
                    obj.Transparency = 1
                end
            end
        end
    end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name:lower():find("forcefield") then
            obj.CanCollide = false
        end
    end
end

