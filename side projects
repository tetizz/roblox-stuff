-- v1.9.31: version guard + full cleanup, Obsidian GUI removal, auto-rebirth, buttons/debris/weapons fixes, no anti-AFK

-- === Version Guard ===
if getgenv().AutoTycoonRunning then
    warn("Another Auto Tycoon instance detected — cleaning old one.")
    if getgenv().AutoTycoonCleanup then pcall(getgenv().AutoTycoonCleanup) end

    -- Extra Obsidian GUI nuke
    local cg = game:GetService("CoreGui")
    local oldGui = cg:FindFirstChild("10YcTQ")
    if oldGui and oldGui:FindFirstChild("pmx88e") then
        for _, v in ipairs(oldGui.pmx88e:GetDescendants()) do
            if v.Name == "Obsidian" then
                v:Destroy()
                warn("Removed lingering 'Obsidian' UI element")
            end
        end
    end
    return
end
getgenv().AutoTycoonRunning = true

-- Track connections/tasks for cleanup
getgenv().AutoTycoonRefs = {conns = {}, tasks = {}}
local function trackConnection(conn) table.insert(getgenv().AutoTycoonRefs.conns, conn) return conn end
local function trackTask(thread) table.insert(getgenv().AutoTycoonRefs.tasks, thread) return thread end

-- Cleanup function
getgenv().AutoTycoonCleanup = function()
    local cg = game:GetService("CoreGui")
    local oldGui = cg:FindFirstChild("10YcTQ")
    if oldGui then oldGui:Destroy() end

    for _, conn in ipairs(getgenv().AutoTycoonRefs.conns) do pcall(function() conn:Disconnect() end) end
    getgenv().AutoTycoonRefs.conns = {}

    for _, th in ipairs(getgenv().AutoTycoonRefs.tasks) do pcall(function() task.cancel(th) end) end
    getgenv().AutoTycoonRefs.tasks = {}

    warn("Old Auto Tycoon instance fully cleaned up")
end

