-- Minimal Auto Tycoon: Auto Buttons + Debris + v1.9.27-style Auto Rebirth

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local VirtualInputManager = game:GetService("VirtualInputManager")
local plr = Players.LocalPlayer

local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/deividcomsono/Obsidian/main/Library.lua"))()
local Window = Library:CreateWindow({
    Title = "Auto Tycoon v1.0.0+Rebirth",
    ToggleKeybind = Enum.KeyCode.RightControl,
    Center = true,
    AutoShow = true
})

-- UI toggles
local MainTab = Window:AddTab("Main", "home")
local MainBox = MainTab:AddLeftGroupbox("Autofarm")
local TglButtons = MainBox:AddToggle("AutoBtnToggle", {Text = "Auto Buttons", Default = false})
local TglDebris  = MainBox:AddToggle("AutoDebrisToggle", {Text = "Auto Collect Debris", Default = false})

local running = false
local debrisOn = false
local busy, rebirthing = false, false

-- Rebirth state variables
local rebirthStarted, rebirthCooldown = false, false
local rebirthStartTime, rebirthEndTime
local lastButtonValue, buttonPressCount = 0, 0
local REBIRTH_COOLDOWN_TIME = 5 -- seconds

-- Char bind
local char, hrp
if plr.Character then char = plr.Character hrp = char:WaitForChild("HumanoidRootPart") end
plr.CharacterAdded:Connect(function(c) char = c hrp = c:WaitForChild("HumanoidRootPart") end)

-- Helpers
local function getMana()
    local PD = plr:FindFirstChild("PlayerData")
    local ManaVal = PD and PD:FindFirstChild("Mana")
    return ManaVal and ManaVal.Value or 0
end
local function attrAnywhere(m, k)
    if m:GetAttribute(k) ~= nil then return true end
    for _,d in ipairs(m:GetDescendants()) do
        if d:GetAttribute(k) ~= nil then return true end
    end
    return false
end
local function getBtnPos(inst)
    local m = inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
    if not m then return nil end
    return m.PrimaryPart and m.PrimaryPart.Position or m:GetPivot().Position
end
local function validBtn(inst)
    local m = inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
    if not (m and m:FindFirstChild("Button_Indicator", true)) then return false end
    if not attrAnywhere(m, "Premium") and not attrAnywhere(m, "RebirthReq") then return false end
    if getMana() < (inst:GetAttribute("UnlockCost") or math.huge) then return false end
    return getBtnPos(inst) ~= nil
end
local function gatherCands(root)
    local res = {}
    for _, inst in ipairs(root:GetDescendants()) do
        if validBtn(inst) then table.insert(res, inst) end
    end
    return res
end
local function bringBtnAndTrigger(inst)
    if not hrp then return end
    local m = inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
    for _, p in ipairs(m:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = false p.Massless = true end
    end
    m:PivotTo(hrp.CFrame * CFrame.new(0, 0, -2))
    task.wait(0.05)
    local prompt = m:FindFirstChildOfClass("ProximityPrompt") or m:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        prompt.MaxActivationDistance, prompt.RequiresLineOfSight = 15, false
        prompt:InputHoldBegin()
        task.wait(prompt.HoldDuration + 0.05)
        prompt:InputHoldEnd()
        VirtualInputManager:SendKeyEvent(true,"E",false,game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false,"E",false,game)
    end
end

-- Debris collector
local function teleportDebrisParts()
    if not debrisOn or not hrp then return end
    local debris = Workspace:FindFirstChild("Debris")
    if not debris then return end
    for _, name in ipairs({"Premium_Manana", "Manana", "Purple_Crystal", "Blue_Crystal"}) do
        local part = debris:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            part.CanCollide, part.Massless = false, true
            part.CFrame = hrp.CFrame
            task.wait(0.05)
            break
        end
    end
end

-- Rebirth function
local function doRebirth()
    rebirthing = true
    ReplicatedStorage:WaitForChild("RemoteEvents").RebirthCallback:InvokeServer(plr)
    ReplicatedStorage.RemoteEvents.PickCallback:InvokeServer()
    rebirthing = false
end

-- Main loop with v1.9.27-style rebirth logic
task.spawn(function()
    while true do
        local bpObj = plr:FindFirstChild("ButtonProgress")
        local unld = bpObj and bpObj:FindFirstChild("UnlockedButtons")
        local tot  = bpObj and bpObj:FindFirstChild("TotalButtons")

        if unld and tot then
            -- Reset state after fresh rebirth
            if unld.Value == 0 then
                rebirthStarted = false
                rebirthStartTime = nil
                buttonPressCount = 0
                lastButtonValue = 0
                rebirthCooldown = false
            end

            -- Start tracking when first button pressed
            if not rebirthStarted and unld.Value > 0 and not rebirthStartTime then
                rebirthStartTime = tick()
                rebirthStarted = true
                buttonPressCount = 1
                lastButtonValue = unld.Value
            end

            -- Track button presses
            if rebirthStarted and unld.Value > lastButtonValue then
                buttonPressCount += (unld.Value - lastButtonValue)
                lastButtonValue = unld.Value
            end

            -- All buttons unlocked: do rebirth
            if rebirthStarted and unld.Value == tot.Value and not rebirthCooldown then
                rebirthCooldown = true
                rebirthEndTime = tick()
                rebirthStarted = false
                rebirthStartTime, rebirthEndTime, lastButtonValue = nil, nil, 0
                if running then
                    doRebirth()
                end
                task.delay(REBIRTH_COOLDOWN_TIME, function() rebirthCooldown = false end)
            end
        end

        teleportDebrisParts()

        if running and not busy and not rebirthing then
            busy = true
            local tycoon = Workspace.Map and Workspace.Map:FindFirstChild("Tycoons") and Workspace.Map.Tycoons:FindFirstChild(plr.Name)
            if tycoon then
                local cands = gatherCands(tycoon)
                if #cands > 0 then bringBtnAndTrigger(cands[1]) end
            end
            busy = false
        end
        task.wait(0.2)
    end
end)

-- UI toggle handlers
TglButtons:OnChanged(function(v) running = v end)
TglDebris:OnChanged(function(v) debrisOn = v end)
