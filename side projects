local AutofarmStatsBox = TabMain:AddLeftGroupbox("Autofarm Stats", "chart-line")
local SessionTimeLbl = AutofarmStatsBox:AddLabel("Session Time: 0m 0s")
local RebirthTimeLbl = AutofarmStatsBox:AddLabel("Rebirth Duration: N/A")
local AverageTimeLbl = AutofarmStatsBox:AddLabel("Average Duration: N/A")
local ButtonsPressedLbl = AutofarmStatsBox:AddLabel("Buttons Pressed: N/A")
local ButtonsPerMinLbl = AutofarmStatsBox:AddLabel("Buttons/min: N/A")

local StatusBox = TabMain:AddRightGroupbox("Status", "info")
local StatusLbl = StatusBox:AddLabel("Idle")
local ManaLbl = StatusBox:AddLabel("Mana: 0")
local ButtonsLbl = StatusBox:AddLabel("Buttons unlocked: N/A")

local StatsBox = TabMain:AddRightGroupbox("Stats", "clipboard-list")
local MasteryLbl = StatsBox:AddLabel("Mastery will appear here")

-- Vars
local running, autoWpnRunning, busy, rebirthing, didUpg = false, false, false, false, false
local char, hum, hrp
local PlayerData, ManaVal
local sessionStart = tick()
local rebirthStartTime, rebirthEndTime
local rebirthStarted, rebirthCooldown = false, false
local buttonPressCount = 0
local rebirthDurations, rebirthButtonCounts = {}, {}
local REBIRTH_STATS_HISTORY = 10

-- Helpers
local function notify(msg) Library:Notify({Title="Auto Tycoon", Description=msg, Time=2}) end
local function formatTime(sec) local m=math.floor(sec/60) sec=math.floor(sec%60) return ("%dm %ds"):format(m,sec) end

local function updateMasteryLabels(masteryStr)
    if not MasteryLbl then return end
    MasteryLbl:SetText(masteryStr)
    local width=MasteryLbl.AbsoluteSize and MasteryLbl.AbsoluteSize.X or 200
    local textSize=TextService:GetTextSize(masteryStr, MasteryLbl.TextSize or 14, MasteryLbl.Font or Enum.Font.SourceSans, Vector2.new(width, math.huge))
    MasteryLbl:SetSize(Vector2.new(width, textSize.Y+12))
end
local function updateAutofarmStats()
    local lastDuration=rebirthDurations[#rebirthDurations]
    if lastDuration then RebirthTimeLbl:SetText("Rebirth Duration: "..formatTime(lastDuration)) else RebirthTimeLbl:SetText("Rebirth Duration: N/A") end
    if #rebirthDurations>0 then
        local sum=0 for _,v in ipairs(rebirthDurations) do sum+=v end
        AverageTimeLbl:SetText(("Average Duration: %s"):format(formatTime(sum/#rebirthDurations)))
    else AverageTimeLbl:SetText("Average Duration: N/A") end
    local lastCount=rebirthButtonCounts[#rebirthButtonCounts]
    if lastCount and lastDuration then
        ButtonsPressedLbl:SetText(("Buttons Pressed: %d"):format(lastCount))
        ButtonsPerMinLbl:SetText(("Buttons/min: %.1f"):format(lastCount/(lastDuration/60)))
    else
        ButtonsPressedLbl:SetText("Buttons Pressed: N/A")
        ButtonsPerMinLbl:SetText("Buttons/min: N/A")
    end
    SessionTimeLbl:SetText(("Session Time: %s"):format(formatTime(tick()-sessionStart)))
end
local function getMasteryStr()
    if not PlayerData then return "No PlayerData" end
    local mastery=PlayerData:FindFirstChild("Mastery")
    if not mastery then return "No Mastery" end
    local t={} for _,c in ipairs(mastery:GetChildren()) do table.insert(t, c.Name..": "..tostring(c.Value)) end
    return table.concat(t,"\n")
end

-- Data init
task.spawn(function()
    repeat PlayerData=plr:FindFirstChild("PlayerData") task.wait() until PlayerData
    repeat ManaVal=PlayerData:FindFirstChild("Mana") task.wait() until ManaVal
    updateMasteryLabels(getMasteryStr())
end)

-- Char bind
local function bindChar(c) char=c hum=c:WaitForChild("Humanoid") hrp=c:WaitForChild("HumanoidRootPart") end
if plr.Character then bindChar(plr.Character) end
plr.CharacterAdded:Connect(bindChar)

local function getMana() return ManaVal and ManaVal.Value or 0 end

-- Buttons
local function attrAnywhere(m,k)
    if m:GetAttribute(k)~=nil then return true end
    for _,d in ipairs(m:GetDescendants()) do if d:GetAttribute(k)~=nil then return true end end
    return false
end
local function getBtnPos(inst)
    local m=inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
    if not m then return nil end
    if m.PrimaryPart then return m.PrimaryPart.Position end
    return m:GetPivot().Position
end
local function validBtn(inst)
    local m=inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
    if not m or not m:FindFirstChild("Button_Indicator",true) then return false end
    if not attrAnywhere(m,"Premium") and not attrAnywhere(m,"RebirthReq") then return false end
    if getMana() < (inst:GetAttribute("UnlockCost") or math.huge) then return false end
    if not getBtnPos(inst) then return false end
    return true
end
local function gatherCands(root)
    local res={} for _,inst in ipairs(root:GetDescendants()) do if validBtn(inst) then table.insert(res,{inst=inst}) end end
    return res
end
local function bringBtnAndTrigger(inst)
    if not hrp then return end
    local m=inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
    if not m then return end
    for _,p in ipairs(m:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide=false p.Massless=true end end
    m:PivotTo(hrp.CFrame * CFrame.new(0,0,-2))
    task.wait(0.05)
    local prompt=m:FindFirstChildOfClass("ProximityPrompt") or m:FindFirstChildWhichIsA("ProximityPrompt",true)
    if prompt then
        prompt.MaxActivationDistance, prompt.RequiresLineOfSight=15, false
        prompt:InputHoldBegin() task.wait(prompt.HoldDuration+0.05) prompt:InputHoldEnd()
        VirtualInputManager:SendKeyEvent(true,"E",false,game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false,"E",false,game)
    end
end

-- Debris
local function teleportDebrisParts()
    local debris=Workspace:FindFirstChild("Debris")
    if not debris or not hrp then return end
    for _,name in ipairs({"Premium_Manana","Manana","Purple_Crystal","Blue_Crystal"}) do
        local part=debris:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            part.CanCollide,part.Massless=false,true
            part.CFrame=hrp.CFrame
            task.wait(0.05) break
        end
    end
end

-- Weapons optimized with faster cooldowns
local weaponCollectionCooldown = 0
local collectedWeaponsCache = {}
local function updateBackpackCache()
    collectedWeaponsCache={}
    local backpack=plr:FindFirstChild("Backpack")
    if backpack then
        for _,tool in ipairs(backpack:GetChildren()) do collectedWeaponsCache[tool.Name]=true end
    end
end
local function autoGetWeaponsOptimized()
    if not hrp then return end
    local now=tick()
    if now < weaponCollectionCooldown then return end
    local tycoonsFolder=Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Tycoons")
    if not tycoonsFolder then return end
    updateBackpackCache()
    for _,tycoonModel in ipairs(tycoonsFolder:GetChildren()) do
        for _,stand in ipairs(tycoonModel:GetChildren()) do
            if stand:IsA("Model") and string.find(stand.Name,"SpellStand") then
                local prompts={} for _,d in ipairs(stand:GetDescendants()) do if d:IsA("ProximityPrompt") then table.insert(prompts,d) end end
                if #prompts<2 then continue end
                local weaponName
                for _,prompt in ipairs(prompts) do if prompt.ActionText and prompt.ActionText~="" then weaponName=prompt.ActionText end end
                if not weaponName or collectedWeaponsCache[weaponName] then continue end
                -- Found missing weapon
                local myPos=hrp.CFrame
                local targetPart=prompts[1].Parent:IsA("BasePart") and prompts[1].Parent or prompts[1].Parent:FindFirstChildWhichIsA("BasePart")
                if targetPart then hrp.CFrame=targetPart.CFrame * CFrame.new(0,0,-1) end
                task.wait(0.05) -- faster
                for _,prompt in ipairs(prompts) do
                    if prompt and prompt:IsA("ProximityPrompt") then
                        prompt.MaxActivationDistance=15; prompt.RequiresLineOfSight=false
                        if prompt.Enabled then prompt:InputHoldBegin() task.wait(prompt.HoldDuration+0.05) prompt:InputHoldEnd() end
                    end
                    VirtualInputManager:SendKeyEvent(true,"E",false,game)
                    task.wait(0.05)
                    VirtualInputManager:SendKeyEvent(false,"E",false,game)
                end
                local startTime=tick()
                repeat updateBackpackCache() if collectedWeaponsCache[weaponName] then break end task.wait(0.05)
                until tick()-startTime > 2
                hrp.CFrame=myPos
                task.wait(0.05)
                weaponCollectionCooldown = tick() + 0.3 -- lowered from 1s to 0.3s
                return
            end
        end
    end
    weaponCollectionCooldown = tick() + 1 -- lowered from 3s to 1s when nothing missing
end

-- Rebirth
local function doRebirth()
    rebirthing,didUpg=true,false
    notify("Starting rebirth...")
    local repEv=ReplicatedStorage:WaitForChild("RemoteEvents")
    repEv.RebirthCallback:InvokeServer(plr)
    task.wait(3)
    if not didUpg then
        local points=PlayerData and PlayerData.UpgradePoints
        if points and points.Value>0 then for _,s in ipairs({"Jump","Speed","Regen","Health"}) do repEv.UpgradeCallback:InvokeServer(s) end didUpg=true end
    end
    repEv.PickCallback:InvokeServer()
    rebirthing=false
    updateMasteryLabels(getMasteryStr())
end

-- Main loop
task.spawn(function()
    local lastButtonValue=0
    while true do
        updateAutofarmStats()
        local bpObj=plr:FindFirstChild("ButtonProgress")
        local unld=bpObj and bpObj:FindFirstChild("UnlockedButtons")
        local tot=bpObj and bpObj:FindFirstChild("TotalButtons")
        if unld and tot then
            ButtonsLbl:SetText(("Buttons unlocked: %d / %d"):format(unld.Value, tot.Value))
            if unld.Value == 0 then rebirthStarted=false; rebirthStartTime=nil; buttonPressCount=0; lastButtonValue=0; rebirthCooldown=false end
            if not rebirthStarted and unld.Value>0 and not rebirthStartTime then rebirthStartTime=tick(); rebirthStarted=true; buttonPressCount=1; lastButtonValue=unld.Value end
            if rebirthStarted and unld.Value > lastButtonValue then buttonPressCount += (unld.Value - lastButtonValue) lastButtonValue=unld.Value end
            if rebirthStarted and unld.Value == tot.Value and rebirthStartTime and not rebirthCooldown then
                rebirthCooldown=true
                rebirthEndTime = tick()
                table.insert(rebirthDurations, rebirthEndTime - rebirthStartTime)
                table.insert(rebirthButtonCounts, buttonPressCount)
                while #rebirthDurations > REBIRTH_STATS_HISTORY do table.remove(rebirthDurations, 1) end
                while #rebirthButtonCounts > REBIRTH_STATS_HISTORY do table.remove(rebirthButtonCounts, 1) end
                updateAutofarmStats()
                rebirthStarted=false; rebirthStartTime=nil; rebirthEndTime=nil; lastButtonValue=0
                if running then StatusLbl:SetText(">> Auto Rebirth starting...") doRebirth() else StatusLbl:SetText("All buttons unlocked, Auto Buttons OFF") end
                task.delay(5, function() rebirthCooldown=false end)
            end
        else
            ButtonsLbl:SetText("Buttons unlocked: N/A")
        end
        ManaLbl:SetText("Mana: "..tostring(getMana()))
        teleportDebrisParts()
        if running and not busy and not rebirthing then
            busy=true
            local tycoon=Workspace.Map.Tycoons:FindFirstChild(plr.Name)
            if tycoon then local cands=gatherCands(tycoon) if #cands>0 then bringBtnAndTrigger(cands[1].inst) end else StatusLbl:SetText("Tycoon not found") end
            busy=false
        end
        if autoWpnRunning and not busy and not rebirthing then
            busy=true autoGetWeaponsOptimized() busy=false
        end
        task.wait(SliderScan.Value or 0.3)
    end
end)

