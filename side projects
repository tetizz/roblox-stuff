local plr = Players.LocalPlayer
local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/deividcomsono/Obsidian/main/Library.lua"))()

local Win = Library:CreateWindow({
    Title = "Auto Tycoon Bot",
    Footer = "v1.9.21",
    ToggleKeybind = Enum.KeyCode.RightControl,
    Center = true,
    AutoShow = true,
})

-- UI setup
local TabMain = Win:AddTab("Main", "home")
local LeftBox = TabMain:AddLeftGroupbox("Control", "wrench")
local StatusBox = TabMain:AddRightGroupbox("Status", "info")
local StatusLbl = StatusBox:AddLabel("Idle")
StatusLbl.TextYAlignment = Enum.TextYAlignment.Top
StatusLbl.TextWrapped = true
StatusLbl.TextTruncate = Enum.TextTruncate.None
local StatsBox = TabMain:AddRightGroupbox("Stats", "clipboard-list")
local masteryLbls = {}
local ManaLbl = StatusBox:AddLabel("Mana: 0")
local ButtonsLbl = StatusBox:AddLabel("Buttons unlocked: N/A")

local TogAutoBtn = LeftBox:AddToggle("AutoBtn", {Text = "Auto path buttons", Default = false})
local TogAutoWpn = LeftBox:AddToggle("AutoWpn", {Text = "Auto get weapons", Default = false})
local SliderScan = LeftBox:AddSlider("ScanInt", {
    Text = "Scan Interval (sec)",
    Default = 0.3, Min = 0, Max = 2, Rounding = 1, Precision = 1
})

-- Vars
local running, autoWpnRunning, busy, rebirthing, didUpg = false, false, false, false, false
local char, hum, hrp
local PlayerData, ManaVal
local SCAN_INT = 0.3

-- Notify helper
local function notify(msg)
    Library:Notify({Title = "Auto Tycoon", Description = msg, Time = 2})
end

-- Mastery UI update
local function updateMasteryLabels(masteryStr)
    -- remove old
    for _, lbl in ipairs(masteryLbls) do
        if lbl and typeof(lbl.Remove) == "function" then
            pcall(function() lbl:Remove() end)
        end
    end
    masteryLbls = {}
    task.wait()
    -- add new
    for line in masteryStr:gmatch("[^\n]+") do
        local lbl = StatsBox:AddLabel(line)
        lbl.TextYAlignment = Enum.TextYAlignment.Top
        lbl.TextWrapped = true
        lbl.TextTruncate = Enum.TextTruncate.None
        table.insert(masteryLbls, lbl)
    end
end

-- Mastery string builder
local function getMasteryStr()
    if not PlayerData then return "No PlayerData" end
    local mastery = PlayerData:FindFirstChild("Mastery")
    if not mastery then return "No Mastery" end
    local t = {}
    for _, c in ipairs(mastery:GetChildren()) do
        local v = c.Value
        table.insert(t, string.format("%s: %s", c.Name, tostring(v)))
    end
    return table.concat(t, "\n")
end

-- Wait for PlayerData at init
task.spawn(function()
    repeat PlayerData = plr:FindFirstChild("PlayerData") task.wait(0.1) until PlayerData
    repeat ManaVal = PlayerData:FindFirstChild("Mana") task.wait(0.1) until ManaVal
    updateMasteryLabels(getMasteryStr())
end)

local function getMana() return (ManaVal and ManaVal.Value) or 0 end

local function bindChar(c)
