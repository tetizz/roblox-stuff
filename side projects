local function altCollectZone()
    sizeLoopActive = false
    task.wait(0.1)
    sizeLoopActive = true
    task.spawn(function()
        while sizeLoopActive do
            local myT = Workspace.Map.Tycoons:FindFirstChild(plr.Name)
            if myT and myT:FindFirstChild("TycoonTemplate") then
                local tCollect = myT.TycoonTemplate:FindFirstChild("T_Collect_Zone")
                if tCollect then
                    local z = tCollect:FindFirstChild("CollectZone")
                    if z and z:IsA("BasePart") then
                        z.Size = Vector3.new(2050, 2050, 2050)
                        task.wait(2)
                        if not sizeLoopActive then break end
                        z.Size = Vector3.new(1950, 1950, 1950)
                        task.wait(2)
                    else
                        task.wait(2)
                    end
                else
                    task.wait(2)
                end
            else
                task.wait(2)
            end
        end
    end)
end
altCollectZone()

local function attrAnywhere(m, key)
    if not m or not key then return false end
    if m:GetAttribute(key) ~= nil then return true end
    for _, d in ipairs(m:GetDescendants()) do
        if d:GetAttribute(key) ~= nil then return true end
    end
    return false
end

local function getAttrAnywhere(m, key)
    if not m or not key then return nil end
    local val = m:GetAttribute(key)
    if val ~= nil then return val end
    for _, d in ipairs(m:GetDescendants()) do
        val = d:GetAttribute(key)
        if val ~= nil then return val end
    end
    return nil
end

local function getBtnPos(inst)
    local m = inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
    if not m then return nil end
    local basep = m:FindFirstChild("Button_Base")
    if basep and basep:IsA("BasePart") then return basep.Position end
    if m.PrimaryPart then return m.PrimaryPart.Position end
    return m:GetPivot().Position
end

local function validBtn(inst)
    local m = inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
    if not (m and m:FindFirstChild("Button_Indicator", true)) then return false, "No Indicator" end
    if not attrAnywhere(m, "Premium") and not attrAnywhere(m, "RebirthReq") then return false, "No Premium/RebirthReq" end

    local hasCollidable = false
    for _, p in ipairs(m:GetDescendants()) do
        if p:IsA("BasePart") and p.CanCollide then
            hasCollidable = true
            break
        end
    end
    if not hasCollidable then return false, "No collidable parts" end

    local cost = inst:GetAttribute("UnlockCost")
    if type(cost) ~= "number" then return false, nil end
    if getMana() < cost then return false, "Not enough mana" end

    local rebirthVal = 0
    if PlayerData then
        local val = PlayerData:FindFirstChild("Rebirth")
        if val and typeof(val.Value) == "number" then
            rebirthVal = val.Value
        end
    end

    local rebReq = getAttrAnywhere(m, "RebirthReq")
    if rebReq and type(rebReq) == "number" and rebirthVal < rebReq then
        return false, "Rebirth requirement not met"
    end

    if not getBtnPos(inst) then return false, "No position" end
    return true, cost, getBtnPos(inst)
end

local function gatherCands(root)
    local res = {}
    for _, inst in ipairs(root:GetDescendants()) do
        local ok, costOrR = validBtn(inst)
        if ok then table.insert(res, { inst=inst, cost=costOrR }) end
    end
    return res
end

local function bringBtn(inst)
    if not hrp then return end
    local m = inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
    local targetCf = hrp.CFrame * CFrame.new(0, 0, -2)
    if not m then return end

    if not m.PrimaryPart then
        local prim = m:FindFirstChildWhichIsA("BasePart")
        if prim then m.PrimaryPart = prim end
    end

    if m.PrimaryPart then
        local offset = targetCf.Position - m.PrimaryPart.Position
        for _, p in ipairs(m:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CanCollide = false
                p.Massless = true
                p.CFrame = p.CFrame + offset
            end
        end
    else
        for _, p in ipairs(m:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CanCollide = false
                p.Massless = true
                p.CFrame = targetCf
            end
        end
    end
end

local function bringPartToPlayer(part)
    if not hrp or not part then return end
    part.CanCollide = false
    part.Massless = true
    part.CFrame = hrp.CFrame * CFrame.new(0, 0, -2)
end

local function triggerPrompt(tgt)
    local m = tgt:IsA("Model") and tgt or tgt:FindFirstAncestorWhichIsA("Model")
    local prompt = m and m:FindFirstChildOfClass("ProximityPrompt") or tgt:FindFirstChildOfClass("ProximityPrompt")
    if prompt and prompt.Enabled and hrp and (hrp.Position - prompt.Parent.Position).Magnitude <= prompt.MaxActivationDistance then
        prompt:InputHoldBegin()
        task.wait(prompt.HoldDuration + 0.05)
        prompt:InputHoldEnd()
    end
end

local function getMasteryStr()
    if not PlayerData then return "No PlayerData" end
    local mastery = PlayerData:FindFirstChild("Mastery")
    if not mastery then return "No Mastery" end
    local t = {}
    for _, c in ipairs(mastery:GetChildren()) do
        local val = c.Value
        if c:IsA("NumberValue") or c:IsA("IntValue") then
            table.insert(t, string.format("%s: %d", c.Name, val))
        elseif c:IsA("StringValue") then
            table.insert(t, string.format("%s: %s", c.Name, val))
        else
            table.insert(t, string.format("%s: %s", c.Name, tostring(val)))
        end
    end
    return table.concat(t, "\n")
end

local function doRebirth()
    rebirthing = true
    didUpg = false
    notify("Starting rebirth...")

    local repEv = ReplicatedStorage:WaitForChild("RemoteEvents")
    repEv.RebirthCallback:InvokeServer(Players:WaitForChild(plr.Name))
    task.wait(3)

    if not didUpg then
        local points = PlayerData and PlayerData.UpgradePoints
        if points and points.Value > 0 then
            for _, s in ipairs({ "Jump", "Speed", "Regen", "Health" }) do
                repEv.UpgradeCallback:InvokeServer(s)
            end
            didUpg = true
        end
    end

    local mastery = PlayerData and PlayerData:FindFirstChild("Mastery")
    if mastery then
        local minV, opts = math.huge, {}
        for _, el in ipairs(mastery:GetChildren()) do
            if type(el.Value) == "number" and el.Value >= 0 then
                if el.Value < minV then
                    opts = {el.Name}
                    minV = el.Value
                elseif el.Value == minV then
                    table.insert(opts, el.Name)
                end
            end
        end
        if #opts > 0 then
            repEv.ElementCallback:InvokeServer(opts[math.random(#opts)])
        end
    end
    repEv.PickCallback:InvokeServer()

    rebirthing = false
    altCollectZone()
    masteryPauseUntil = tick() + 10
end

-- Weapon bring logic (example path)
local spellStandPath = {"Map", "Tycoons", "dark776389", "F1_SpellStand_1"}
local baseState, baseOrigCFrame = {}, {}

local function findSpellStandModel()
    local obj = Workspace
    for _, part in ipairs(spellStandPath) do
        if obj then obj = obj:FindFirstChild(part) else break end
    end
    return obj
end

local function hasWeapon(name)
    local backpack = plr:FindFirstChild("Backpack")
    if not backpack then return false end
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool.Name == name then return true end
    end
    return false
end

local function bringModelToPlayer(model)
    if not (model and hrp) then return end
    if not model.PrimaryPart then
        local prim = model:FindFirstChildWhichIsA("BasePart")
        if prim then
            model.PrimaryPart = prim
        else
            return
        end
    end
    local targetCf = hrp.CFrame * CFrame.new(0, 0, -2)
    local offset = targetCf.Position - model.PrimaryPart.Position
    for _, p in ipairs(model:GetDescendants()) do
        if p:IsA("BasePart") then
            p.CanCollide = false
            p.Massless = true
            p.CFrame = p.CFrame + offset
        end
    end
end

local function returnModelToOriginal(model)
    if not model then return end
    local orig = baseOrigCFrame[model]
    if orig then
        for _, p in ipairs(model:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CanCollide = true
                p.Massless = false
            end
        end
        model:PivotTo(orig)
        baseOrigCFrame[model] = nil
        baseState[model] = nil
    end
end

local function autoGetWeapon()
    local model = findSpellStandModel()
    if not model then
        StatusLbl:SetText("Spell stand model not found")
        return
    end

    local prompts = {}
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("ProximityPrompt") then
            table.insert(prompts, d)
        end
    end

    if #prompts < 1 then
        StatusLbl:SetText("No proximity prompts found in spell stand")
        return
    end

    local weaponName = prompts[1].ActionText
    if not weaponName or weaponName == "" then
        StatusLbl:SetText("Weapon name missing from prompt")
        return
    end

    local st = baseState[model] or "idle"

    if st == "teleported" and hasWeapon(weaponName) then
        returnModelToOriginal(model)
        StatusLbl:SetText("Returned spell stand base for weapon: "..weaponName)
        return
    end

    if st == "idle" and not hasWeapon(weaponName) then
        baseOrigCFrame[model] = model:GetPivot()
        bringModelToPlayer(model)
        baseState[model] = "teleported"
        for _, p in ipairs(prompts) do
            if hrp and (hrp.Position - p.Parent.Position).Magnitude <= p.MaxActivationDistance and p.Enabled then
                p:InputHoldBegin()
                task.wait(p.HoldDuration + 0.1)
                p:InputHoldEnd()
            end
        end
        StatusLbl:SetText("Getting weapon: " .. weaponName)
        return
    end
end

-- Debris teleport to player (at, above, and below, instant)
local function teleportDebrisParts()
    local debris = Workspace:FindFirstChild("Debris")
    if not debris or not hrp then return end
    local offsets = {Vector3.new(0,2,0), Vector3.new(0,0,0), Vector3.new(0,-2,0)}
    for _, name in ipairs({"Premium_Manana", "Manana", "Purple_Crystal", "Blue_Crystal"}) do
        local part = debris:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            part.CanCollide = false
            part.Massless = true
            for _, v in ipairs(offsets) do
                part.CFrame = hrp.CFrame + v
            end
        end
    end
end

