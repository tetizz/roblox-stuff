-- =============================
-- Forcefield Ignore Setup
-- =============================
local function disableForcefields()
    local forcefieldFolder = Workspace.Map.Tycoons.AznDip:FindFirstChild("F2_Forcefield")
    if forcefieldFolder then
        for _, obj in ipairs(forcefieldFolder:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Name:lower():find("forcefield") then
                obj.CanCollide = false
                obj.Transparency = 1 -- optional: hide them
            end
        end
    end
    -- Also scan the whole workspace for rogue parts named "Forcefield"
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name:lower():find("forcefield") then
            obj.CanCollide = false
        end
    end
end
disableForcefields()

local function bindCharacter(c)
    char = c
    hum = c:WaitForChild("Humanoid")
    hrp = c:WaitForChild("HumanoidRootPart")
end
if localPlayer.Character then bindCharacter(localPlayer.Character) end
localPlayer.CharacterAdded:Connect(bindCharacter)

local function toast(txt)
    Library:Notify({ Title = "Auto Tycoon", Description = txt, Time = 2 })
end

local function getMyTycoon()
    local map = Workspace:FindFirstChild("Map")
    if not map then return nil end
    local tycoons = map:FindFirstChild("Tycoons")
    if not tycoons then return nil end
    return tycoons:FindFirstChild(localPlayer.Name)
end

local function getMana()
    local pd = localPlayer:FindFirstChild("PlayerData")
    local mana = pd and pd:FindFirstChild("Mana")
    return (mana and mana.Value) or 0
end

-- =============================
-- Validate Button Criteria
-- =============================
local function getButtonPivotPos(inst)
    local model = inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
    if model then
        local btnBase = model:FindFirstChild("Button_Base")
        if btnBase and btnBase:IsA("BasePart") then
            return btnBase.Position
        end
        if model.PrimaryPart then
            return model.PrimaryPart.Position
        end
        return model:GetPivot().Position
    elseif inst:IsA("BasePart") then
        return inst.Position
    end
end

local function isValidButton(inst)
    local name = string.lower(inst.Name)
    if not string.find(name, "button") then
        return false, "Missing 'button' in name"
    end
    -- must have a Button_Indicator descendant
    local model = inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
    if not model:FindFirstChild("Button_Indicator", true) then
        return false, "No Button_Indicator"
    end
    -- must have collidable part
    local collidable = false
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") and part.CanCollide then collidable = true break end
    end
    if not collidable then
        return false, "No collidable parts"
    end
    -- cost
    local cost = inst:GetAttribute("UnlockCost")
    if type(cost) ~= "number" then
        return false, nil
    end
    if getMana() < cost then
        return false, "Not enough mana"
    end
    return true, cost, getButtonPivotPos(inst)
end

local function gatherCandidates(root)
    local list = {}
    for _, inst in ipairs(root:GetDescendants()) do
        if string.find(string.lower(inst.Name), "button") then
            local ok, costOrReason, pos = isValidButton(inst)
            if ok then
                table.insert(list, { inst = inst, cost = costOrReason, pos = pos })
            end
        end
    end
    return list
end

-- =============================
-- Pathfinding
-- =============================
local function moveExactlyTo(pos)
    if not hrp or not hum then return false end
    disableForcefields()
    local path = PathfindingService:CreatePath(AGENT)
    local success, err = pcall(function()
        path:ComputeAsync(hrp.Position, pos)
    end)
    if not success or path.Status ~= Enum.PathStatus.Success then
        return false
    end
    for _, wp in ipairs(path:GetWaypoints()) do
        hum:MoveTo(wp.Position)
        if not hum.MoveToFinished:Wait(WAYPOINT_WAIT_TIME) then
            return false
        end
    end
    hum:MoveTo(pos)
    local startTime = os.clock()
    while os.clock() - startTime < FINAL_ARRIVAL_MAX_WAIT do
        if (hrp.Position - pos).Magnitude <= ARRIVAL_THRESHOLD then
            return true
        end
        if hum.MoveToFinished:Wait(0.1) then return true end
    end
    return false
end

local function autoTriggerPrompt(target)
    local model = target:IsA("Model") and target or target:FindFirstAncestorWhichIsA("Model")
    local prompt = model and model:FindFirstChildOfClass("ProximityPrompt") or target:FindFirstChildOfClass("ProximityPrompt")
    if not prompt then return end
    if prompt.Enabled and (hrp.Position - prompt.Parent.Position).Magnitude <= prompt.MaxActivationDistance then
        prompt:InputHoldBegin()
        task.wait(prompt.HoldDuration + 0.1)
        prompt:InputHoldEnd()
    end
end

-- =============================
-- Rebirth Sequence
-- =============================
local function startRebirthSequence()
    if rebirthInProgress then return end
    rebirthInProgress = true
    didUpgradeThisRebirth = false
    toast("Starting rebirth...")

    local repEvents = ReplicatedStorage:WaitForChild("RemoteEvents")
    repEvents.RebirthCallback:InvokeServer(Players:WaitForChild(localPlayer.Name))

    task.wait(3)
    if not didUpgradeThisRebirth then
        local upPoints = localPlayer.PlayerData.UpgradePoints.Value
        if upPoints > 0 then
            for _, stat in ipairs({ "Jump", "Speed", "Regen", "Health" }) do
                repEvents.UpgradeCallback:InvokeServer(stat)
            end
            didUpgradeThisRebirth = true
        end
    end
    local mastery = localPlayer.PlayerData:FindFirstChild("Mastery")
    if mastery then
        local minVal = math.huge
        local candidates = {}
        for _, el in ipairs(mastery:GetChildren()) do
            if type(el.Value) == "number" and el.Value >= 0 then
                if el.Value < minVal then
                    candidates = { el.Name }
                    minVal = el.Value
                elseif el.Value == minVal then
                    table.insert(candidates, el.Name)
                end
            end
        end
        if #candidates > 0 then
            local choice = candidates[math.random(#candidates)]
            repEvents.ElementCallback:InvokeServer(choice)
        end
    end
    repEvents.PickCallback:InvokeServer()

    rebirthInProgress = false
end

-- =============================
-- Auto Mana Collection
-- =============================
local function goCollectMana()
    local collectZone = Workspace.Map.Tycoons.AznDip:FindFirstChild("T_Collect_Zone")
    if collectZone and collectZone:IsA("BasePart") then
        StatusLabel:SetText("Going to collect mana...")
        moveExactlyTo(collectZone.Position)
        task.wait(1)
    end
end

-- =============================
-- Main Loop
-- =============================
task.spawn(function()
    while true do
        local bp = localPlayer:FindFirstChild("ButtonProgress")
        local unlocked = bp and bp:FindFirstChild("UnlockedButtons")
        local total = bp and bp:FindFirstChild("TotalButtons")
        if unlocked and total then
            TotalButtonsLabel:SetText(("Buttons unlocked: %d / %d"):format(unlocked.Value, total.Value))
            if unlocked.Value >= total.Value and not rebirthInProgress then
                startRebirthSequence()
            end
        end

        ManaLabel:SetText("Mana: " .. tostring(getMana()))

        if running and not busy and not rebirthInProgress then
            busy = true
            local tycoon = getMyTycoon()
            if tycoon then
                local cands = gatherCandidates(tycoon)
                if #cands > 0 then
                    local target = cands[1]
                    StatusLabel:SetText("Target: " .. target.inst.Name)
                    if moveExactlyTo(target.pos) then
                        autoTriggerPrompt(target.inst)
                    end
                else
                    -- No candidates — check if it's due to low mana
                    local autoCollectFlag = localPlayer:FindFirstChild("Gamepasses") and localPlayer.Gamepasses:FindFirstChild("AutoCollect")
                    if not (autoCollectFlag and autoCollectFlag.Value) then
                        goCollectMana()
                    end
                end
            end
            busy = false
        end
        task.wait(SCAN_INTERVAL)
    end
end)

AutoToggle:OnChanged(function(v)
    running = v
    StatusLabel:SetText(v and "Enabled" or "Disabled")
end)
