-- Function to bring button near player and trigger it using ProximityPrompt
local function bringBtnAndTrigger(inst)
    if not hrp then return end
    local m = inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
    for _, p in ipairs(m:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = false; p.Massless = true end
    end
    m:PivotTo(hrp.CFrame * CFrame.new(0, 0, -2))
    task.wait(0.05)
    local prompt = m:FindFirstChildOfClass("ProximityPrompt") or m:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        prompt.MaxActivationDistance = 15
        prompt.RequiresLineOfSight = false
        prompt:InputHoldBegin()
        task.wait(prompt.HoldDuration + 0.05)
        prompt:InputHoldEnd()
        VirtualInputManager:SendKeyEvent(true, "E", false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, "E", false, game)
    end
end

local function teleportDebrisParts()
    if not debrisOn or not hrp then return end
    local debrisFolder = Workspace:FindFirstChild("Debris")
    if debrisFolder then
        for _, obj in ipairs(debrisFolder:GetDescendants()) do
            if obj:IsA("BasePart") then
                local nameLower = string.lower(obj.Name)
                if nameLower:find("crystal") or nameLower:find("manana") then
                    obj.Anchored = false
                    obj.CanCollide = false
                    obj.Massless = true
                    obj.CFrame = hrp.CFrame
                    task.wait(0.02)
                end
            end
        end
    end
end

local function skipWeatherEvent()
    if not autoWeatherOn then return end
    local evObj = Players:FindFirstChild("Event_Values")
    if evObj then
        local timer = evObj:FindFirstChild("Timer")
        local eventName = evObj:FindFirstChild("EventDisplayName")
        if timer and timer.Value > 0 then
            local remote = ReplicatedStorage:WaitForChild("RemoteEvents"):FindFirstChild("SkipEvent")
            if remote then
                remote:FireServer()
                Library:Notify({
                    Title = "Auto Weather Skip",
                    Description = string.format("Skipped weather: %s (%d seconds left)", eventName and eventName.Value or "Unknown", timer.Value),
                    Time = 3
                })
            end
        end
    end
end

local collectResizerThread
local function resizeMyCollectZone()
    if collectResizerThread then
        task.cancel(collectResizerThread)
        collectResizerThread = nil
    end
    if not collectResizerOn then return end
    collectResizerThread = task.spawn(function()
        local myTycoon
        repeat
            task.wait(0.2)
            local tf = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Tycoons")
            myTycoon = tf and tf:FindFirstChild(plr.Name)
        until myTycoon
        local baseSize = Vector3.new(2000, 2000, 2000)
        local delta = Vector3.new(1, 1, 1)
        local flip = false
        while collectResizerOn do
            myTycoon = Workspace.Map.Tycoons:FindFirstChild(plr.Name)
            if myTycoon then
                local cz = myTycoon:FindFirstChild("T_Collect_Zone") and myTycoon.T_Collect_Zone:FindFirstChild("CollectZone")
                if cz and cz:IsA("BasePart") then
                    cz.Size = flip and (baseSize - delta) or (baseSize + delta)
                end
            end
            flip = not flip
            task.wait(0.5)
        end
    end)
end

local function doRebirth()
    rebirthing = true
    local repEv = ReplicatedStorage:WaitForChild("RemoteEvents")
    repEv.RebirthCallback:InvokeServer(plr)
    task.wait(2)
    local masteryFolder = plr:WaitForChild("PlayerData"):FindFirstChild("Mastery")
    if masteryFolder then
        local lowestValue = math.huge
        local candidates = {}
        for _, elem in ipairs(masteryFolder:GetChildren()) do
            if typeof(elem.Value) == "number" and elem.Value >= 0 then
                if elem.Value < lowestValue then
                    lowestValue = elem.Value
                    candidates = {elem.Name}
                elseif elem.Value == lowestValue then
                    table.insert(candidates, elem.Name)
                end
            end
        end
        if #candidates > 0 then
            local chosen = candidates[math.random(#candidates)]
            Library:Notify({
                Title = "Auto Rebirth",
                Description = string.format("Chose element '%s' (Mastery: %d)", chosen, lowestValue),
                Time = 3
            })
            repEv.ElementCallback:InvokeServer(chosen)
            repEv.PickCallback:InvokeServer()
        else
            Library:Notify({
                Title = "Auto Rebirth",
                Description = "No mastery elements ≥ 0 found!",
                Time = 3
            })
            repEv.PickCallback:InvokeServer()
        end
    else
        Library:Notify({
            Title = "Auto Rebirth",
            Description = "Mastery folder not found!",
            Time = 3
        })
        repEv.PickCallback:InvokeServer()
    end
    if collectResizerOn then resizeMyCollectZone() end
    rebirthing = false
end

local rebirthStarted, rebirthStartTime, lastButtonValue, buttonPressCount = false, nil, 0, 0
local REBIRTH_COOLDOWN_TIME = 5
local rebirthCooldown = false
local lastDebrisScan = 0
local lastWeatherCheck = 0

task.spawn(function()
    while true do
        local bpObj = plr:FindFirstChild("ButtonProgress")
        local unld = bpObj and bpObj:FindFirstChild("UnlockedButtons")
        local tot = bpObj and bpObj:FindFirstChild("TotalButtons")
        if unld and tot then
            if unld.Value == 0 then
                rebirthStarted = false
                rebirthStartTime = nil
                buttonPressCount = 0
                lastButtonValue = 0
                rebirthCooldown = false
            end
            if not rebirthStarted and unld.Value > 0 and not rebirthStartTime then
                rebirthStartTime = tick()
                rebirthStarted = true
                buttonPressCount = 1
                lastButtonValue = unld.Value
            end
            if rebirthStarted and unld.Value > lastButtonValue then
                buttonPressCount += (unld.Value - lastButtonValue)
                lastButtonValue = unld.Value
            end
            if rebirthStarted and unld.Value == tot.Value and not rebirthCooldown then
                rebirthCooldown = true
                rebirthCycleCount += 1
                local cycleTime = tick() - (rebirthStartTime or tick())
                if rebirthCycleCount > 1 then
                    table.insert(rebirthData, {totalTime = cycleTime})
                    if #rebirthData > MAX_REBIRTH_HISTORY then
                        table.remove(rebirthData, 1)
                    end
                    updateStatsUI()
                end
                Library:Notify({
                    Title = "Auto Rebirth",
                    Description = string.format("Cycle complete in %.2fs (%d buttons)", cycleTime, buttonPressCount),
                    Time = 3
                })
                rebirthStarted, rebirthStartTime, lastButtonValue, buttonPressCount = false, nil, 0, 0
                if running then doRebirth() end
                task.delay(REBIRTH_COOLDOWN_TIME, function() rebirthCooldown = false end)
            end
        end

        local now = tick()
        if now - lastDebrisScan >= 0.5 then
            lastDebrisScan = now
            teleportDebrisParts()
        end
        if now - lastWeatherCheck >= 5 then
            lastWeatherCheck = now
            skipWeatherEvent()
        end

        if running and not busy and not rebirthing then
            busy = true
            local myTycoon = Workspace:FindFirstChild("Map")
                and Workspace.Map:FindFirstChild("Tycoons")
                and Workspace.Map.Tycoons:FindFirstChild(plr.Name)
            if myTycoon then
                local cands = gatherCands(myTycoon)
                if #cands > 0 then bringBtnAndTrigger(cands[1]) end
            end
            busy = false
        end
        task.wait(0.2)
    end
end)

