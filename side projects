-- Restart-safe CollectZone pulse loop
local function altCollectZone()
    sizeLoopActive = false
    task.wait(0.1)
    sizeLoopActive = true
    task.spawn(function()
        while sizeLoopActive do
            local myT = Workspace.Map.Tycoons:FindFirstChild(plr.Name)
            if myT and myT:FindFirstChild("TycoonTemplate") then
                local tCollect = myT.TycoonTemplate:FindFirstChild("T_Collect_Zone")
                if tCollect then
                    local z = tCollect:FindFirstChild("CollectZone")
                    if z and z:IsA("BasePart") then
                        z.Size = Vector3.new(2050, 2050, 2050)
                        task.wait(2)
                        if not sizeLoopActive then break end
                        z.Size = Vector3.new(1950, 1950, 1950)
                        task.wait(2)
                    else task.wait(2) end
                else task.wait(2) end
            else task.wait(2) end
        end
    end)
end
altCollectZone()

-- Disable forcefields collisions
local function disableFF()
    local myT = Workspace.Map.Tycoons:FindFirstChild(plr.Name)
    if myT then
        local ff = myT:FindFirstChild("F2_Forcefield")
        if ff then
            for _, obj in ipairs(ff:GetDescendants()) do
                if obj:IsA("BasePart") and obj.Name:lower():find("forcefield") then
                    obj.CanCollide = false
                    obj.Transparency = 1
                end
            end
        end
    end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name:lower():find("forcefield") then
            obj.CanCollide = false
        end
    end
end

-- Helpers: attributes
local function attrAnywhere(m, key)
    if not m or not key then return false end
    if m:GetAttribute(key) ~= nil then return true end
    for _, d in ipairs(m:GetDescendants()) do
        if d:GetAttribute(key) ~= nil then return true end
    end
    return false
end

local function getAttrAnywhere(m, key)
    if not m or not key then return nil end
    local val = m:GetAttribute(key)
    if val ~= nil then return val end
    for _, d in ipairs(m:GetDescendants()) do
        val = d:GetAttribute(key)
        if val ~= nil then return val end
    end
    return nil
end

-- Buttons logic
local function getBtnPos(inst)
    local m = inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
    if not m then return nil end
    local basep = m:FindFirstChild("Button_Base")
    if basep and basep:IsA("BasePart") then return basep.Position end
    if m.PrimaryPart then return m.PrimaryPart.Position end
    return m:GetPivot().Position
end

local function validBtn(inst)
    local m = inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
    if not (m and m:FindFirstChild("Button_Indicator", true)) then
        return false, "No Indicator"
    end
    if not attrAnywhere(m, "Premium") and not attrAnywhere(m, "RebirthReq") then
        return false, "No Premium/RebirthReq"
    end
    local hasCollidable = false
    for _, p in ipairs(m:GetDescendants()) do
        if p:IsA("BasePart") and p.CanCollide then
            hasCollidable = true
            break
        end
    end
    if not hasCollidable then return false, "No collidable parts" end

    local cost = inst:GetAttribute("UnlockCost")
    if type(cost) ~= "number" then return false, nil end
    if getMana() < cost then return false, "Not enough mana" end

    local playerRebirth = 0
    if PlayerData then
        local rebVal = PlayerData:FindFirstChild("Rebirth")
        if rebVal and typeof(rebVal.Value) == "number" then
            playerRebirth = rebVal.Value
        end
    end

    local rebReq = getAttrAnywhere(m, "RebirthReq")
    if rebReq and type(rebReq) == "number" and playerRebirth < rebReq then
        return false, "Rebirth req not met"
    end

    if not getBtnPos(inst) then return false, "No pos" end
    return true, cost, getBtnPos(inst)
end

local function gatherCands(root)
    local res = {}
    for _, inst in ipairs(root:GetDescendants()) do
        local ok, costOrR = validBtn(inst)
        if ok then table.insert(res, { inst=inst, cost=costOrR }) end
    end
    return res
end

-- Teleport buttons (fixed)
local function bringBtn(inst)
    if not hrp then return end
    local m = inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
    local targetCf = hrp.CFrame * CFrame.new(0, 0, -2)

    if m then
        if not m.PrimaryPart then
            local prim = m:FindFirstChildWhichIsA("BasePart")
            if prim then m.PrimaryPart = prim end
        end
        if m.PrimaryPart then
            local offset = targetCf.Position - m.PrimaryPart.Position
            for _, p in ipairs(m:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.CanCollide = false
                    p.Massless = true
                    p.CFrame = p.CFrame + offset
                end
            end
        else
            for _, p in ipairs(m:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.CanCollide = false
                    p.Massless = true
                    p.CFrame = targetCf
                end
            end
        end
    elseif inst:IsA("BasePart") then
        inst.CanCollide = false
        inst.Massless = true
        inst.CFrame = targetCf
    end
end

local function triggerPrompt(tgt)
    local m = tgt:IsA("Model") and tgt or tgt:FindFirstAncestorWhichIsA("Model")
    local prompt = m and m:FindFirstChildOfClass("ProximityPrompt") or tgt:FindFirstChildOfClass("ProximityPrompt")
    if prompt and prompt.Enabled and hrp and (hrp.Position - prompt.Parent.Position).Magnitude <= prompt.MaxActivationDistance then
        prompt:InputHoldBegin()
        task.wait(prompt.HoldDuration + 0.05)
        prompt:InputHoldEnd()
    end
end

-- Mastery stat string
local function getMasteryStr()
    if not PlayerData then return "No PlayerData" end
    local mastery = PlayerData:FindFirstChild("Mastery")
    if not mastery then return "No Mastery" end
    local t = {}
    for _, c in ipairs(mastery:GetChildren()) do
        local val = c.Value
        if c:IsA("NumberValue") or c:IsA("IntValue") then
            table.insert(t, string.format("%s: %d", c.Name, val))
        elseif c:IsA("StringValue") then
            table.insert(t, string.format("%s: %s", c.Name, val))
        else
            table.insert(t, string.format("%s: %s", c.Name, tostring(val)))
        end
    end
    return table.concat(t, "\n")
end

-- Rebirth sequence
local function doRebirth()
    rebirthing = true
    didUpg = false
    notify("Starting rebirth...")

    local repEv = ReplicatedStorage:WaitForChild("RemoteEvents")
    repEv.RebirthCallback:InvokeServer(Players:WaitForChild(plr.Name))

    task.wait(3)

    if not didUpg then
        local points = PlayerData and PlayerData.UpgradePoints
        if points and points.Value > 0 then
            for _, s in ipairs({ "Jump", "Speed", "Regen", "Health" }) do
                repEv.UpgradeCallback:InvokeServer(s)
            end
            didUpg = true
        end
    end

    local mastery = PlayerData and PlayerData:FindFirstChild("Mastery")
    if mastery then
        local minV, opts = math.huge, {}
        for _, el in ipairs(mastery:GetChildren()) do
            if type(el.Value) == "number" and el.Value >= 0 then
                if el.Value < minV then
                    opts = { el.Name }
                    minV = el.Value
                elseif el.Value == minV then
                    table.insert(opts, el.Name)
                end
            end
        end
        if #opts > 0 then
            repEv.ElementCallback:InvokeServer(opts[math.random(#opts)])
        end
    end
    repEv.PickCallback:InvokeServer()

    rebirthing = false

    altCollectZone()
    masteryPauseUntil = tick() + 10
end

-- Auto get weapons enhancements

local baseOrigCFrames = {}
local baseStates = {}
-- state: "idle", "teleported", "returned"

-- Check if weapon owned
local function hasWeapon(name)
    local backpack = plr:FindFirstChild("Backpack")
    if not backpack then return false end
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool.Name == name then return true end
    end
    return false
end

-- Get all spell stand bases from all tycoons
local function getAllBases()
    local res = {}
    local TFolder = Workspace.Map:FindFirstChild("Tycoons")
    if not TFolder then return res end

    for _, tycoon in ipairs(TFolder:GetChildren()) do
        if tycoon:IsA("Folder") or tycoon:IsA("Model") then
            for _, spFolder in ipairs(tycoon:GetChildren()) do
                if spFolder:IsA("Folder") or spFolder:IsA("Model") then
                    for _, c in ipairs(spFolder:GetChildren()) do
                        if c.Name == "Base" and c:IsA("BasePart") then
                            local prompts = {}
                            for _, child in ipairs(c:GetChildren()) do
                                if child:IsA("ProximityPrompt") then
                                    table.insert(prompts, child)
                                end
                            end
                            if #prompts == 2 then
                                local wpnName = prompts[1].ActionText
                                if wpnName and wpnName ~= "" then
                                    table.insert(res, {
                                        base = c,
                                        weapon = wpnName,
                                        origCFrame = c.CFrame,
                                    })
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    return res
end

local function bringBase(b)
    if not hrp then return end
    b.CanCollide = false
    b.Massless = true
    b.CFrame = hrp.CFrame * CFrame.new(0,0,-2)
end

local function returnBase(data)
    if data and data.base and data.origCFrame then
        data.base.CanCollide = true
        data.base.Massless = false
        data.base.CFrame = data.origCFrame
        baseOrigCFrames[data.base] = nil
        baseStates[data.base] = nil
    end
end

local function autoGetWpn()
    local bases = getAllBases()

    -- Return bases for owned weapons, one per loop
    for _, data in ipairs(bases) do
        local b = data.base
        local wpn = data.weapon
        local st = baseStates[b]
        if st == "teleported" and hasWeapon(wpn) then
            returnBase(data)
            StatusLbl:SetText("Returned base for weapon: " .. wpn)
            return
        end
    end

    -- Teleport bases needing pickup, one per loop
    for _, data in ipairs(bases) do
        local b = data.base
        local wpn = data.weapon
        local st = baseStates[b] or "idle"
        if st == "idle" and not hasWeapon(wpn) then
            if not baseOrigCFrames[b] then baseOrigCFrames[b] = b.CFrame end
            bringBase(b)
            baseStates[b] = "teleported"

            -- Trigger both prompts once
            for _, p in ipairs(b:GetChildren()) do
                if p:IsA("ProximityPrompt") then
                    if hrp and (hrp.Position - p.Parent.Position).Magnitude <= p.MaxActivationDistance then
                        p:InputHoldBegin()
                        task.wait(p.HoldDuration + 0.1)
                        p:InputHoldEnd()
                    end
                end
            end
            StatusLbl:SetText("Getting Weapon: " .. wpn)
            return
        end
    end

    StatusLbl:SetText(getMasteryStr()) -- nothing else to do
end

-- Mastery update task with pause after rebirth
task.spawn(function()
    MasteryLbl:SetText(getMasteryStr()) -- immediate at start
    while true do
        if tick() >= masteryPauseUntil then
            local s, e = pcall(function()
                MasteryLbl:SetText(getMasteryStr())
            end)
            if not s then warn("Mastery update err:", e) end
        end
        task.wait(3)
    end
end)

-- Main
task.spawn(function()
    while true do
        local bp = plr:FindFirstChild("ButtonProgress")
        local unld = bp and bp:FindFirstChild("UnlockedButtons")
        local tot = bp and bp:FindFirstChild("TotalButtons")
        if unld and tot then
            ButtonsLbl:SetText(("Buttons unlocked: %d / %d"):format(unld.Value, tot.Value))
            if unld.Value >= tot.Value and not rebirthing then
                doRebirth()
            end
        else
            ButtonsLbl:SetText("Buttons unlocked: N/A")
        end

        ManaLbl:SetText("Mana: " .. tostring(getMana()))

        if not busy then
            -- Mastery updated by separate loop
        end

        if running and not busy and not rebirthing then
            busy = true
            local tycoon = Workspace.Map.Tycoons:FindFirstChild(plr.Name)
            if tycoon then
                local cands = gatherCands(tycoon)
                if #cands > 0 then
                    local targ = cands[1]
                    StatusLbl:SetText("Bringing: " .. targ.inst.Name)
                    bringBtn(targ.inst)
                    task.wait(0.05)
                    triggerPrompt(targ.inst)
                    StatusLbl:SetText("Activated: " .. targ.inst.Name)
                else
                    StatusLbl:SetText(getMasteryStr())
                end
            else
                StatusLbl:SetText("Tycoon not found")
            end
            busy = false
        end

        if autoWpnRunning and not busy and not rebirthing then
            busy = true
            autoGetWpn()
            busy = false
        end

        task.wait(SliderScan.Value or SCAN_INT)
    end
end)

