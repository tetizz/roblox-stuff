        ButtonProgress = plr:FindFirstChild("ButtonProgress")
        task.wait()
    until ButtonProgress
    UnlockedButtons = ButtonProgress:WaitForChild("UnlockedButtons", 10)
    TotalButtons = ButtonProgress:WaitForChild("TotalButtons", 10)
end
bindButtonProgress()
trackConnection(plr.ChildAdded:Connect(function(c)
    if c.Name == "ButtonProgress" then bindButtonProgress() end
