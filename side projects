local function formatTime(seconds)
    local m = math.floor(seconds / 60)
    local s = math.floor(seconds % 60)
    return string.format("%dm %02ds", m, s)
end

local function getAverageRebirthTime()
    local sum, ct = 0, 0
    for _, v in ipairs(rebirthData) do
        if v.totalTime then sum = sum + v.totalTime; ct = ct + 1 end
    end
    if ct == 0 then return nil end
    return sum / ct
end

local function updateStatsUI()
    local avgRebirth = getAverageRebirthTime()
    if avgRebirth then
        AvgTimeLabel:SetText("Average Rebirth: " .. formatTime(avgRebirth))
    else
        AvgTimeLabel:SetText("Average Rebirth: Calculating...")
    end
    local rebirthVal = plr:FindFirstChild("PlayerData") and plr.PlayerData:FindFirstChild("Rebirth")
    local cur = (rebirthVal and rebirthVal.Value) or 0
    TargetSlider:SetMin(cur + 1)
    local tVal = TargetSlider.Value
    if tVal < cur + 1 then
        TargetSlider:SetValue(cur + 1)
    end
    if avgRebirth then
        local left = math.max(0, TargetSlider.Value - cur)
        local etaSec = left * avgRebirth
        local h = math.floor(etaSec / 3600)
        local m = math.floor((etaSec % 3600) / 60)
        local etaText = (h > 0 and string.format("%dh ", h) or "") .. string.format("%dm", m)
        ETALabel:SetText("ETA: " .. etaText)
    else
        ETALabel:SetText("ETA: Calculating...")
    end
end

TargetSlider:OnChanged(function()
    updateStatsUI()
end)

local function getMana()
    local PD = plr:FindFirstChild("PlayerData")
    local ManaVal = PD and PD:FindFirstChild("Mana")
    return ManaVal and ManaVal.Value or 0
end

local function getRebirths()
    local PD = plr:FindFirstChild("PlayerData")
    local rVal = PD and PD:FindFirstChild("Rebirth")
    return (rVal and typeof(rVal.Value) == "number") and rVal.Value or 0
end

local function getBtnPos(inst)
    local m = inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
    if not m then return nil end
    return m.PrimaryPart and m.PrimaryPart.Position or m:GetPivot().Position
end

local function validBtn(inst, mana, rebirths)
    local m = inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
    if not (m and m:FindFirstChild("Button_Indicator", true)) then return false end
    local rebirthReq = m:GetAttribute("RebirthReq")
    if type(rebirthReq) ~= "number" then return false end
    if rebirthReq > rebirths then return false end
    if mana < (inst:GetAttribute("UnlockCost") or math.huge) then return false end
    return getBtnPos(inst) ~= nil
end

local function gatherCands(root)
    local res = {}
    local mana = getMana()
    local rebirths = getRebirths()
    for _, inst in ipairs(root:GetDescendants()) do
        if validBtn(inst, mana, rebirths) then table.insert(res, inst) end
    end
    return res
end

