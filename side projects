-- === Auto Get Weapons ===
local function autoGetWeaponsOptimized()
    if not hrp or tick() < weaponCollectionCooldown then return end
    local tycoonsFolder = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Tycoons")
    if not tycoonsFolder then return end

    -- Backpack scan
    local ownedWeapons = {}
    for _, tool in ipairs(plr.Backpack:GetChildren()) do
        ownedWeapons[tool.Name] = true
    end

    for _, tycoonModel in ipairs(tycoonsFolder:GetChildren()) do
        for _, stand in ipairs(tycoonModel:GetChildren()) do
            if stand:IsA("Model") and stand.Name:find("SpellStand") then
                local prompts = {}
                for _, d in ipairs(stand:GetDescendants()) do
                    if d:IsA("ProximityPrompt") then table.insert(prompts, d) end
                end
                if #prompts < 1 then continue end
                local weaponName
                for _, pr in ipairs(prompts) do
                    if pr.ActionText and pr.ActionText ~= "" then
                        weaponName = pr.ActionText
                        break
                    end
                end
                if not weaponName or ownedWeapons[weaponName] then continue end

                -- Teleport and pickup
                local originalPos = hrp.CFrame
                local targetPart = prompts[1].Parent:IsA("BasePart") and prompts[1].Parent
                                or prompts[1].Parent:FindFirstChildWhichIsA("BasePart")
                if targetPart then hrp.CFrame = targetPart.CFrame * CFrame.new(0,0,-1) end
                task.wait()
                local startTime = tick()
                while tick() - startTime < 3 do
                    for _, pr in ipairs(prompts) do
                        if pr:IsA("ProximityPrompt") then
                            pr.MaxActivationDistance=15 pr.RequiresLineOfSight=false
                            if pr.Enabled then pr:InputHoldBegin() task.wait(pr.HoldDuration+0.01) pr:InputHoldEnd() end
                        end
                        VirtualInputManager:SendKeyEvent(true,"E",false,game) task.wait()
                        VirtualInputManager:SendKeyEvent(false,"E",false,game)
                        -- Fast exit
                        if plr.Backpack:FindFirstChild(weaponName) then
                            hrp.CFrame = originalPos
                            weaponCollectionCooldown = tick() + 0.3
                            return
                        end
                    end
                end
                hrp.CFrame = originalPos
                weaponCollectionCooldown = tick() + 1
                return
            end
        end
    end
    weaponCollectionCooldown = tick() + 1
end

-- === Rebirth with Smart Upgrades + Element Pick ===
local function doRebirth()
    rebirthing = true
    notify("Rebirthing...")
    local ev = ReplicatedStorage:WaitForChild("RemoteEvents")
    ev.RebirthCallback:InvokeServer(plr)
    task.wait(2)

    -- Upgrades
    local upgFolder = PlayerData:FindFirstChild("Upgrades")
    local pointsVal = PlayerData:FindFirstChild("UpgradePoints")
    local points = pointsVal and pointsVal.Value or 0
    local upgradeData = {
        Jump={max=1,cost=100},
        Speed={max=8,cost=5},
        Regen={max=10,cost=10},
        Health={max=10,cost=5}
    }
    if upgFolder and points > 0 then
        local bought = true
        while bought do
            bought = false
            points = pointsVal.Value
            for statName, cfg in pairs(upgradeData) do
                local statVal = upgFolder:FindFirstChild(statName)
                local cur = statVal and statVal.Value or 0
                if cur < cfg.max and points >= cfg.cost then
                    ev.UpgradeCallback:InvokeServer(statName)
                    task.wait(0.05)
                    bought = true
                    break
                end
            end
        end
    end

    -- Pick element with lowest mastery
    local masteryFolder = PlayerData:FindFirstChild("Mastery")
    local chosen, lowVal = nil, math.huge
    if masteryFolder then
        for _, elem in ipairs(masteryFolder:GetChildren()) do
            if elem.Value < lowVal then
                lowVal = elem.Value
                chosen = elem.Name
            end
        end
    end
    if chosen then
        ev.ElementCallback:InvokeServer(chosen)
        print("[Auto Tycoon] Picked element:", chosen)
    end

    ev.PickCallback:InvokeServer()
    refreshMastery()
    rebirthing = false
end

-- === Main Loop ===
trackTask(task.spawn(function()
    while true do
        if UnlockedButtons and TotalButtons then
            ButtonsLbl:SetText(("Buttons unlocked: %d / %d"):format(UnlockedButtons.Value, TotalButtons.Value))
            if running and UnlockedButtons.Value == TotalButtons.Value and not rebirthCooldown then
                rebirthCooldown = true
                table.insert(RebirthTimes, tick() - sessionStart)
                table.insert(RebirthButtons, UnlockedButtons.Value)
                doRebirth()
                task.delay(5, function() rebirthCooldown = false end)
            end
        else
            ButtonsLbl:SetText("Buttons unlocked: Loading...")
        end
        ManaLbl:SetText("Mana: "..tostring(ManaVal and ManaVal.Value or 0))
        if running and not busy and not rebirthing then
            busy = true
            local tycoon = Workspace.Map.Tycoons:FindFirstChild(plr.Name)
            if tycoon then
                local cands = {}
                for _, inst in ipairs(tycoon:GetDescendants()) do
                    if inst:IsA("Model") and inst:FindFirstChild("Button_Indicator",true) then
                        table.insert(cands, inst)
                    end
                end
                if #cands > 0 then
                    local m = cands[1]
                    m:PivotTo(hrp.CFrame * CFrame.new(0,0,-2))
                    task.wait()
                    local prompt = m:FindFirstChildWhichIsA("ProximityPrompt",true)
                    if prompt then
                        prompt.MaxActivationDistance=15 prompt.RequiresLineOfSight=false
                        prompt:InputHoldBegin() task.wait(prompt.HoldDuration+0.01) prompt:InputHoldEnd()
                        VirtualInputManager:SendKeyEvent(true,"E",false,game)
                        task.wait()
                        VirtualInputManager:SendKeyEvent(false,"E",false,game)
                    end
                end
            end
            busy = false
        end
        if autoWpnRunning and not busy and not rebirthing then
            busy = true autoGetWeaponsOptimized() busy = false
        end
        task.wait(SliderScan.Value or 0.3)
    end
end))

