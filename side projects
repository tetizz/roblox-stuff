-- Stores original positions & states of bases moved to player
local weaponBaseOriginalCFrames = {}
local weaponBaseStates = {} 
-- state = "idle", "teleported", or "returned"

-- Check if weapon name is in local player's backpack
local function hasWeaponInBackpack(weaponName)
    local backpack = localPlayer:FindFirstChild("Backpack")
    if not backpack then return false end
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool.Name == weaponName then
            return true
        end
    end
    return false
end

-- Get all spell stand bases from all players' tycoons in workspace.Map.Tycoons
local function getAllSpellStandsBases()
    local bases = {} -- array of { basePart, weaponName, originalCFrame }
    
    local tycoonsFolder = Workspace.Map:FindFirstChild("Tycoons")
    if not tycoonsFolder then return bases end

    for _, playerTycoon in ipairs(tycoonsFolder:GetChildren()) do
        if playerTycoon:IsA("Folder") or playerTycoon:IsA("Model") then
            for _, spellFolder in ipairs(playerTycoon:GetChildren()) do
                if spellFolder:IsA("Folder") or spellFolder:IsA("Model") then
                    for _, candidate in ipairs(spellFolder:GetChildren()) do
                        if candidate.Name == "Base" and candidate:IsA("BasePart") then
                            -- Check if has exactly two ProximityPrompts
                            local prompts = {}
                            for _, child in ipairs(candidate:GetChildren()) do
                                if child:IsA("ProximityPrompt") then
                                    table.insert(prompts, child)
                                end
                            end
                            if #prompts == 2 then
                                -- Use first ProximityPrompt's ActionText as weaponName
                                local weaponName = prompts[1].ActionText
                                if weaponName and weaponName ~= "" then
                                    table.insert(bases, {
                                        base = candidate,
                                        weaponName = weaponName,
                                        originalCFrame = candidate.CFrame
                                    })
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    return bases
end

local function bringBaseToPlayer(basePart)
    if not hrp then return end
    basePart.CanCollide = false
    basePart.Massless = true
    basePart.CFrame = hrp.CFrame * CFrame.new(0, 0, -2)
end

local function returnBaseToOriginal(baseData)
    if baseData and baseData.base and baseData.originalCFrame then
        baseData.base.CanCollide = true
        baseData.base.Massless = false
        baseData.base.CFrame = baseData.originalCFrame
        weaponBaseOriginalCFrames[baseData.base] = nil
        weaponBaseStates[baseData.base] = nil
    end
end

local function autoGetWeapons()
    local bases = getAllSpellStandsBases()
    -- Process bases that were teleported and weapon acquired: return them
    for _, baseData in ipairs(bases) do
        local base = baseData.base
        local weaponName = baseData.weaponName
        local state = weaponBaseStates[base]
        if state == "teleported" and hasWeaponInBackpack(weaponName) then
            returnBaseToOriginal(baseData)
            StatusLabel:SetText("Returned base for weapon: "..weaponName)
            return -- do 1 action per loop for smoothness
        end
    end

    -- Teleport bases for weapons not owned and not already teleported
    for _, baseData in ipairs(bases) do
        local base = baseData.base
        local weaponName = baseData.weaponName
        local state = weaponBaseStates[base] or "idle"
        if state == "idle" and not hasWeaponInBackpack(weaponName) then
            if not weaponBaseOriginalCFrames[base] then
                weaponBaseOriginalCFrames[base] = base.CFrame
            end
            bringBaseToPlayer(base)
            weaponBaseStates[base] = "teleported"

            -- Trigger both proximity prompts
            for _, child in ipairs(base:GetChildren()) do
                if child:IsA("ProximityPrompt") then
                    if hrp and (hrp.Position - child.Parent.Position).Magnitude <= child.MaxActivationDistance then
                        child:InputHoldBegin()
                        task.wait(child.HoldDuration + 0.1)
                        child:InputHoldEnd()
                    end
                end
            end

            StatusLabel:SetText("Getting Weapon: "..weaponName)
            return -- one weapon per loop
        end
    end

    -- If nothing to get:
    StatusLabel:SetText(getMasteryStatus())
end

