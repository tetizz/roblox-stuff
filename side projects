-- === Buttons ===
local function attrAnywhere(m,k) if m:GetAttribute(k)~=nil then return true end for _,d in ipairs(m:GetDescendants()) do if d:GetAttribute(k)~=nil then return true end end return false end
local function getBtnPos(inst) local m=inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model") if not m then return nil end return m.PrimaryPart and m.PrimaryPart.Position or m:GetPivot().Position end
local function validBtn(inst) local m=inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model") if not(m and m:FindFirstChild("Button_Indicator",true)) then return false end if not attrAnywhere(m,"Premium") and not attrAnywhere(m,"RebirthReq") then return false end if getMana()<(inst:GetAttribute("UnlockCost") or math.huge) then return false end return getBtnPos(inst)~=nil end
local function gatherCands(root) local res={} for _,inst in ipairs(root:GetDescendants()) do if validBtn(inst) then table.insert(res,{inst=inst}) end end return res end
local function bringBtnAndTrigger(inst) if not hrp then return end local m=inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model") for _,p in ipairs(m:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide=false p.Massless=true end end m:PivotTo(hrp.CFrame * CFrame.new(0,0,-2)) task.wait() local prompt=m:FindFirstChildOfClass("ProximityPrompt") or m:FindFirstChildWhichIsA("ProximityPrompt",true) if prompt then prompt.MaxActivationDistance, prompt.RequiresLineOfSight=15, false prompt:InputHoldBegin() task.wait(prompt.HoldDuration+0.01) prompt:InputHoldEnd() VirtualInputManager:SendKeyEvent(true,"E",false,game) task.wait() VirtualInputManager:SendKeyEvent(false,"E",false,game) end end

-- === Debris ===
local function teleportDebrisParts() local debris=Workspace:FindFirstChild("Debris") if not debris or not hrp then return end for _,name in ipairs({"Premium_Manana","Manana","Purple_Crystal","Blue_Crystal"}) do local part=debris:FindFirstChild(name) if part and part:IsA("BasePart") then part.CanCollide,part.Massless=false,true part.CFrame=hrp.CFrame task.wait() break end end end

-- === Weapons ===
local weaponCollectionCooldown = 0
local function autoGetWeaponsOptimized()
    if not hrp or tick() < weaponCollectionCooldown then return end
    local folder=Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Tycoons")
    if not folder then return end
    for _,tycoonModel in ipairs(folder:GetChildren()) do
        for _,stand in ipairs(tycoonModel:GetChildren()) do
            if stand:IsA("Model") and stand.Name:find("SpellStand") then
                local prompts={} for _,d in ipairs(stand:GetDescendants()) do if d:IsA("ProximityPrompt") then table.insert(prompts,d) end end
                local weaponName for _,prompt in ipairs(prompts) do if prompt.ActionText and prompt.ActionText~="" then weaponName=prompt.ActionText end end
                if not weaponName or plr.Backpack:FindFirstChild(weaponName) then continue end
                local originalPos=hrp.CFrame
                local targetPart=prompts[1].Parent:IsA("BasePart") and prompts[1].Parent or prompts[1].Parent:FindFirstChildWhichIsA("BasePart")
                if targetPart then hrp.CFrame=targetPart.CFrame * CFrame.new(0,0,-1) end
                task.wait()
                local startTime=tick()
                while not plr.Backpack:FindFirstChild(weaponName) and tick()-startTime<3 do
                    for _,prompt in ipairs(prompts) do
                        if prompt:IsA("ProximityPrompt") then
                            prompt.MaxActivationDistance, prompt.RequiresLineOfSight = 15, false
                            if prompt.Enabled then prompt:InputHoldBegin() task.wait(prompt.HoldDuration+0.01) prompt:InputHoldEnd() end
                        end
                        VirtualInputManager:SendKeyEvent(true,"E",false,game)
                        task.wait()
                        VirtualInputManager:SendKeyEvent(false,"E",false,game)
                    end
                    task.wait()
                end
                hrp.CFrame=originalPos
                weaponCollectionCooldown = tick() + (plr.Backpack:FindFirstChild(weaponName) and 0.3 or 1)
                return
            end
        end
    end
    weaponCollectionCooldown = tick() + 1
end

-- === Rebirth ===
local function doRebirth()
    rebirthing=true didUpg=false
    notify("Starting rebirth…")
    local ev=ReplicatedStorage:WaitForChild("RemoteEvents")
    ev.RebirthCallback:InvokeServer(plr)
    task.wait(2)
    local points=PlayerData and PlayerData:FindFirstChild("UpgradePoints")
    if not didUpg and points and points.Value>0 then for _,s in ipairs({"Jump","Speed","Regen","Health"}) do ev.UpgradeCallback:InvokeServer(s) end didUpg=true end
    ev.PickCallback:InvokeServer()
    rebirthing=false
end

-- === Main Loop ===
trackTask(task.spawn(function()
    while true do
        teleportDebrisParts()
        if running and not busy and not rebirthing then busy=true local tyc=Workspace.Map.Tycoons:FindFirstChild(plr.Name) if tyc then local cands=gatherCands(tyc) if #cands>0 then bringBtnAndTrigger(cands[1].inst) end end busy=false end
        if autoWpnRunning and not busy and not rebirthing then busy=true autoGetWeaponsOptimized() busy=false end
        task.wait(SliderScan.Value or 0.3)
    end
end))

