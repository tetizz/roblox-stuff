local SCAN_INTERVAL = 0.3  -- Default scan interval (seconds)
local AGENT = { AgentRadius = 2, AgentHeight = 5, AgentCanJump = true }
local WAYPOINT_WAIT_TIME = 3 -- seconds waiting per waypoint
local FINAL_ARRIVAL_MAX_WAIT = 2 -- timeout for arriving at final position

local char, hum, hrp
local running = false
local busy = false
local selectionMode = "Closest" -- default target selection

