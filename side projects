local InfoBox = MainTab:AddRightGroupbox("Status", "info")

local StatusLabel = InfoBox:AddLabel("Idle")
local ManaLabel = InfoBox:AddLabel("Mana: 0")
local TotalButtonsLabel = InfoBox:AddLabel("Buttons unlocked: N/A")

local AutoToggle = LeftGroupbox:AddToggle("AutoPathButtons", { Text = "Auto path to buttons", Default = false })
local TargetSelectDropdown = LeftGroupbox:AddDropdown("TargetSelection", { Text = "Target Selection", Default = "Closest", Values = { "Closest", "Cheapest", "Most Expensive" }, Multi = false })
local ScanIntervalSlider = LeftGroupbox:AddSlider("ScanInterval", { Text = "Scan Interval (seconds)", Default = 0.3, Min = 0, Max = 2, Rounding = 1, Precision = 1 })

-- Settings
local SCAN_INTERVAL = 0.3
local ARRIVAL_THRESHOLD = 0.3  -- Kept for potential future use but unused now

-- State
local running, busy, rebirthInProgress, didUpgradeThisRebirth = false, false, false, false
local selectionMode, char, hum, hrp = "Closest"

-- Helpers
local function toast(msg) Library:Notify({ Title = "Auto Tycoon", Description = msg, Time = 2 }) end

-- Forcefield ignore (still useful to avoid any physical obstruction)
local function disableForcefields()
    local myTycoon = Workspace.Map.Tycoons:FindFirstChild(localPlayer.Name)
    if myTycoon then
        local ffFolder = myTycoon:FindFirstChild("F2_Forcefield")
        if ffFolder then
            for _, obj in ipairs(ffFolder:GetDescendants()) do
                if obj:IsA("BasePart") and obj.Name:lower():find("forcefield") then
                    obj.CanCollide = false
                    obj.Transparency = 1
                end
            end
        end
    end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name:lower():find("forcefield") then
            obj.CanCollide = false
        end
    end
end

local function bindCharacter(c)
    char = c
    hum = c:WaitForChild("Humanoid")
    hrp = c:WaitForChild("HumanoidRootPart")
end
if localPlayer.Character then bindCharacter(localPlayer.Character) end
localPlayer.CharacterAdded:Connect(bindCharacter)

local function getMyTycoon()
    local tycoons = Workspace.Map:FindFirstChild("Tycoons")
    return tycoons and tycoons:FindFirstChild(localPlayer.Name)
end

local function getMana()
    local pd = localPlayer:FindFirstChild("PlayerData")
    return (pd and pd:FindFirstChild("Mana") and pd.Mana.Value) or 0
end

-- Buttons
local function getButtonPivotPos(inst)
    local model = inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
    if not model then return nil end
    local btnBase = model:FindFirstChild("Button_Base")
    if btnBase and btnBase:IsA("BasePart") then return btnBase.Position end
    if model.PrimaryPart then return model.PrimaryPart.Position end
    return model:GetPivot().Position
end

local function isValidButton(inst)
    local name = string.lower(inst.Name)
    if not name:find("button") then return false, "No 'button' in name" end
    local model = inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
    if not (model and model:FindFirstChild("Button_Indicator", true)) then return false, "No Button_Indicator" end
    local hasCollidable = false
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") and part.CanCollide then hasCollidable = true break end
    end
    if not hasCollidable then return false, "No collidable parts" end
    local cost = inst:GetAttribute("UnlockCost")
    if type(cost) ~= "number" then return false, nil end
    if getMana() < cost then return false, "Not enough mana" end
    -- Active RebirthReq check
    local playerRebirth = 0
    local pd = localPlayer:FindFirstChild("PlayerData")
    if pd then
        local rebirthValue = pd:FindFirstChild("Rebirth")
        if rebirthValue and typeof(rebirthValue.Value) == "number" then playerRebirth = rebirthValue.Value end
    end
    local rebirthReq = inst:GetAttribute("RebirthReq")
    if rebirthReq and type(rebirthReq) == "number" and playerRebirth < rebirthReq then
        return false, "Rebirth requirement not met"
    end
    local pos = getButtonPivotPos(inst)
    if not pos then return false, "No position" end
    return true, cost, pos
end

local function gatherCandidates(root)
    local list = {}
    for _, inst in ipairs(root:GetDescendants()) do
        if inst.Name:lower():find("button") then
            local ok, costOrReason, pos = isValidButton(inst)
            if ok then table.insert(list, { inst = inst, cost = costOrReason, pos = pos }) end
        end
    end
    return list
end

-- Teleport the button to the player's HumanoidRootPart
local function bringButtonToPlayer(buttonInstance)
    local character = localPlayer.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local buttonModel = buttonInstance:IsA("Model") and buttonInstance or buttonInstance:FindFirstAncestorWhichIsA("Model")
    if buttonModel then
        if not buttonModel.PrimaryPart then
            local primary = buttonModel:FindFirstChildWhichIsA("BasePart")
            if primary then buttonModel.PrimaryPart = primary end
        end
        if buttonModel.PrimaryPart then
            -- Move the button model to 2 studs in front of the player
            buttonModel:SetPrimaryPartCFrame(hrp.CFrame * CFrame.new(0, 0, -2))
        elseif buttonInstance:IsA("BasePart") then
            -- Single part button fallback
            buttonInstance.CFrame = hrp.CFrame * CFrame.new(0, 0, -2)
        end
    end
end

local function autoTriggerPrompt(target)
    local model = target:IsA("Model") and target or target:FindFirstAncestorWhichIsA("Model")
    local prompt = model and model:FindFirstChildOfClass("ProximityPrompt") or target:FindFirstChildOfClass("ProximityPrompt")
    if prompt and prompt.Enabled and hrp and (hrp.Position - prompt.Parent.Position).Magnitude <= prompt.MaxActivationDistance then
        prompt:InputHoldBegin()
        task.wait(prompt.HoldDuration + 0.1)
        prompt:InputHoldEnd()
    end
end

-- Rebirth procedure
local function startRebirthSequence()
    rebirthInProgress = true
    didUpgradeThisRebirth = false
    toast("Starting rebirth...")
    local repEvents = ReplicatedStorage:WaitForChild("RemoteEvents")
    repEvents.RebirthCallback:InvokeServer(Players:WaitForChild(localPlayer.Name))
    task.wait(3)
    if not didUpgradeThisRebirth then
        local upPoints = localPlayer.PlayerData.UpgradePoints.Value
        if upPoints > 0 then
            for _, stat in ipairs({ "Jump", "Speed", "Regen", "Health" }) do
                repEvents.UpgradeCallback:InvokeServer(stat)
            end
            didUpgradeThisRebirth = true
        end
    end
    local mastery = localPlayer.PlayerData:FindFirstChild("Mastery")
    if mastery then
        local minVal, candidates = math.huge, {}
        for _, el in ipairs(mastery:GetChildren()) do
            if type(el.Value) == "number" and el.Value >= 0 then
                if el.Value < minVal then
                    candidates = { el.Name }
                    minVal = el.Value
                elseif el.Value == minVal then
                    table.insert(candidates, el.Name)
                end
            end
        end
        if #candidates > 0 then
            repEvents.ElementCallback:InvokeServer(candidates[math.random(#candidates)])
        end
    end
    repEvents.PickCallback:InvokeServer()
    rebirthInProgress = false
end

-- Main loop
task.spawn(function()
    while true do
        local bp = localPlayer:FindFirstChild("ButtonProgress")
        local unlocked = bp and bp:FindFirstChild("UnlockedButtons")
        local total = bp and bp:FindFirstChild("TotalButtons")
        if unlocked and total then
            TotalButtonsLabel:SetText(("Buttons unlocked: %d / %d"):format(unlocked.Value, total.Value))
            if unlocked.Value >= total.Value and not rebirthInProgress then
                startRebirthSequence()
            end
        else
            TotalButtonsLabel:SetText("Buttons unlocked: N/A")
        end

        ManaLabel:SetText("Mana: " .. tostring(getMana()))

        if running and not busy and not rebirthInProgress then
            busy = true
            local tycoon = getMyTycoon()
            if tycoon then
                local cands = gatherCandidates(tycoon)
                if #cands > 0 then
                    local target = cands[1]
                    StatusLabel:SetText("Bringing button: " .. target.inst.Name)
                    bringButtonToPlayer(target.inst)
                    task.wait(0.1)  -- brief pause to allow teleport
                    autoTriggerPrompt(target.inst)
                    StatusLabel:SetText("Activated button: " .. target.inst.Name)
                else
                    StatusLabel:SetText("No valid target (check console)")
                end
            else
                StatusLabel:SetText("Tycoon not found")
            end
            busy = false
        end

        task.wait(SCAN_INTERVAL)
    end
end)

AutoToggle:OnChanged(function(v)
    running = v
    StatusLabel:SetText(v and "Enabled" or "Disabled")
end)
