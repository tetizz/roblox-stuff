-- Weapon check
local function hasWeapon(name)
    local backpack = plr:FindFirstChild("Backpack")
    if not backpack then return false end
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool.Name == name then return true end
    end
    return false
end

-- Teleport to SpellStand prompt, trigger, teleport back
local function autoGetWeapon()
    if not hrp then return end
    local tycoonsFolder = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Tycoons")
    if not tycoonsFolder then return end

    for _, tycoonModel in ipairs(tycoonsFolder:GetChildren()) do
        for _, stand in ipairs(tycoonModel:GetChildren()) do
            if stand:IsA("Model") and string.find(stand.Name, "SpellStand") then
                local prompts = {}
                for _, d in ipairs(stand:GetDescendants()) do
                    if d:IsA("ProximityPrompt") then
                        table.insert(prompts, d)
                    end
                end
                if #prompts < 2 then continue end

                local weaponName
                for _, prompt in ipairs(prompts) do
                    if prompt.ActionText and prompt.ActionText ~= "" then
                        weaponName = prompt.ActionText
                    end
                end
                if not weaponName or hasWeapon(weaponName) then continue end

                local myPos = hrp.CFrame
                local targetPrompt = prompts[1]
                if targetPrompt then
                    local targetPart = targetPrompt.Parent:IsA("BasePart") and targetPrompt.Parent or targetPrompt.Parent:FindFirstChildWhichIsA("BasePart")
                    if targetPart then
                        hrp.CFrame = targetPart.CFrame * CFrame.new(0, 0, -1)
                    end
                    task.wait(0.15)

                    for _, prompt in ipairs(prompts) do
                        if prompt and prompt:IsA("ProximityPrompt") then
                            prompt.MaxActivationDistance = 15
                            prompt.RequiresLineOfSight = false
                            if prompt.Enabled then
                                prompt:InputHoldBegin()
                                task.wait(prompt.HoldDuration + 0.05)
                                prompt:InputHoldEnd()
                            end
                        end
                        task.wait(0.1)
                    end
                end

                task.wait(0.2)
                hrp.CFrame = myPos
                StatusLbl:SetText("Got weapon: " .. weaponName)
                return
            end
        end
    end
end

-- Main loop
task.spawn(function()
    local lastButtonValue
    while true do
        updateAutofarmStats()
        local bp = plr:FindFirstChild("ButtonProgress")
        local unld = bp and bp:FindFirstChild("UnlockedButtons")
        local tot = bp and bp:FindFirstChild("TotalButtons")
        if unld and tot then
            ButtonsLbl:SetText(("Buttons unlocked: %d / %d"):format(unld.Value, tot.Value))
            if unld.Value == 0 then
                rebirthStarted = false
                rebirthStartTime = nil
                buttonPressCount = 0
                lastButtonValue = 0
            end
            if not rebirthStarted and unld.Value > 0 and not rebirthStartTime then
                rebirthStartTime = tick()
                rebirthStarted = true
                buttonPressCount = 1
                lastButtonValue = unld.Value
            end
            if rebirthStarted and unld.Value > lastButtonValue then
                buttonPressCount += (unld.Value - lastButtonValue)
                lastButtonValue = unld.Value
            end
            if rebirthStarted and unld.Value == tot.Value and rebirthStartTime then
                rebirthEndTime = tick()
                local dur = rebirthEndTime - rebirthStartTime
                table.insert(rebirthDurations, dur)
                table.insert(rebirthButtonCounts, buttonPressCount)
                while #rebirthDurations > REBIRTH_STATS_HISTORY do table.remove(rebirthDurations, 1) end
                while #rebirthButtonCounts > REBIRTH_STATS_HISTORY do table.remove(rebirthButtonCounts, 1) end
                updateAutofarmStats()
                rebirthStarted = false
                rebirthStartTime, rebirthEndTime, lastButtonValue = nil, nil, 0
                if running then doRebirth() else notify("All buttons unlocked. Auto Buttons off.") end
            end
        else
            ButtonsLbl:SetText("Buttons unlocked: N/A")
        end
        ManaLbl:SetText("Mana: " .. tostring(getMana()))
        teleportDebrisParts()
        if running and not busy and not rebirthing then
            busy = true
            local tycoon = Workspace.Map.Tycoons:FindFirstChild(plr.Name)
            if tycoon then
                local cands = gatherCands(tycoon)
                if #cands > 0 then
                    local targ = cands[1]
                    StatusLbl:SetText("Bringing: " .. targ.inst.Name)
                    bringBtn(targ.inst)
                    task.wait(0.05)
                    local prompt = targ.inst:FindFirstChildOfClass("ProximityPrompt")
                    if prompt then triggerPrompt(prompt) end
                end
            else
                StatusLbl:SetText("Tycoon not found")
            end
            busy = false
        end
        if autoWpnRunning and not busy and not rebirthing then
            busy = true
            autoGetWeapon()
            busy = false
        end
        task.wait(SliderScan.Value or SCAN_INT)
    end
end)

