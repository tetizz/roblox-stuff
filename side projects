local RuntimeCleanupKey = "TycoonAutomationRuntimeCleanup"
if _G and type(_G[RuntimeCleanupKey]) == "function" then
    pcall(_G[RuntimeCleanupKey])
end

local Runtime = {
    Alive = true,
    Connections = {},
    LastWarn = {}
}

local function disconnectRuntimeConnections()
    for _, conn in ipairs(Runtime.Connections) do
        if conn and conn.Disconnect then
            pcall(function()
                conn:Disconnect()
            end)
        end
    end
    Runtime.Connections = {}
end

local function trackRuntimeConnection(conn)
    Runtime.Connections[#Runtime.Connections + 1] = conn
    return conn
end

local function safeRun(label, fn)
    local ok, err = pcall(fn)
    if ok then return true end

    local t = tick()
    if not Runtime.LastWarn[label] or (t - Runtime.LastWarn[label]) > 10 then
        Runtime.LastWarn[label] = t
        warn("[Tycoon Automation]", tostring(label), tostring(err))
    end
    return false
end

if _G then
    _G[RuntimeCleanupKey] = function()
        Runtime.Alive = false
        disconnectRuntimeConnections()
        if collectResizerThread then
            task.cancel(collectResizerThread)
            collectResizerThread = nil
        end
        if Library then
            pcall(function()
                if type(Library.Unload) == "function" then
                    Library:Unload()
                elseif Win and type(Win.Destroy) == "function" then
                    Win:Destroy()
                end
            end)
        end
    end
end

