local SCAN_INTERVAL = 1.25
local AGENT = { AgentRadius = 2, AgentHeight = 5, AgentCanJump = true }

local char, hum, hrp
local running = false
local busy = false
local selectionMode = "Closest" -- default selection mode

local function bindCharacter(c)
    char = c
    hum = c:WaitForChild("Humanoid")
    hrp = c:WaitForChild("HumanoidRootPart")
end

if localPlayer.Character then
    bindCharacter(localPlayer.Character)
end
localPlayer.CharacterAdded:Connect(bindCharacter)

local function toast(txt)
    Library:Notify({ Title = "Auto Tycoon", Description = txt, Time = 2 })
end

-- Dynamic getMyTycoon for any player, fetching TycoonTemplate under player's folder
local function getMyTycoon()
    local map = workspace:FindFirstChild("Map")
    if not map then return nil end

    local tycoons = map:FindFirstChild("Tycoons")
    if not tycoons then return nil end

    local playerTycoonFolder = tycoons:FindFirstChild(localPlayer.Name)
    if not playerTycoonFolder then return nil end

    local tycoonTemplate = playerTycoonFolder:FindFirstChild("TycoonTemplate")
    if tycoonTemplate and tycoonTemplate:IsA("Model") then
        return tycoonTemplate
    end

    return nil
end

local function getMana()
    local pd = localPlayer:FindFirstChild("PlayerData")
    local mana = pd and pd:FindFirstChild("Mana")
    local amount = (mana and mana.Value) or 0
    print("Mana checked. Value:", amount)
    return amount
end

local function getButtonPivotPos(inst)
    local model = inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
    if model then
        local btnBase = model:FindFirstChild("Button_Base")
        if btnBase and btnBase:IsA("BasePart") then
            return btnBase:GetPivot().Position
        end
        if model.PrimaryPart then
            return model.PrimaryPart:GetPivot().Position
        end
        return model:GetPivot().Position
    elseif inst:IsA("BasePart") then
        return inst:GetPivot().Position
    end
    return nil
end

local function isValidButton(inst)
    local name = string.lower(inst.Name)
    if not string.find(name, "button") then return false end
    if string.find(name, "premium") then return false end
    local cost = inst:GetAttribute("UnlockCost")
    if typeof(cost) ~= "number" then return false end
    if getMana() < cost then return false end
    local pos = getButtonPivotPos(inst)
    if not pos then return false end
    -- Removed max range check as requested
    return true, cost, pos
end

local function gatherCandidates(root)
    local list = {}
    for _, inst in ipairs(root:GetDescendants()) do
        if inst:IsA("Model") or inst:IsA("BasePart") then
            local ok, cost, pos = isValidButton(inst)
            if ok then
                table.insert(list, { inst = inst, cost = cost, pos = pos })
            end
        end
    end
    return list
end

local function pickTargetBySelection(cands)
    if #cands == 0 then return nil end
    if not hrp then return nil end

    if selectionMode == "Closest" then
        local best, bestD
        for _, c in ipairs(cands) do
            local d = (hrp.Position - c.pos).Magnitude
            if not best or d < bestD then
                best = c
                bestD = d
            end
        end
        return best

    elseif selectionMode == "Cheapest" then
        local best, bestCost = nil, math.huge
        for _, c in ipairs(cands) do
            if c.cost < bestCost then
                bestCost = c.cost
                best = c
            end
        end
        return best

    elseif selectionMode == "Most Expensive" then
        local best, bestCost = nil, -math.huge
        for _, c in ipairs(cands) do
            if c.cost > bestCost then
                bestCost = c.cost
                best = c
            end
        end
        return best

    else
        -- fallback to closest
        local best, bestD
        for _, c in ipairs(cands) do
            local d = (hrp.Position - c.pos).Magnitude
            if not best or d < bestD then
                best = c
                bestD = d
            end
        end
        return best
    end
end

local function moveExactlyTo(pos)
    if not hrp or not hum then return false end
    print("Pathfinding to:", pos)
    local path = PathfindingService:CreatePath(AGENT)
    path:ComputeAsync(hrp.Position, pos)
    if path.Status ~= Enum.PathStatus.Success then
        print("Pathfinding failed")
        return false
    end
    for _, wp in ipairs(path:GetWaypoints()) do
        print("Moving to waypoint:", wp.Position)
        hum:MoveTo(wp.Position)
        local ok = hum.MoveToFinished:Wait(6)
        if not ok then
            print("Failed to reach waypoint.")
            return false
        end
    end
    print("Moving to final position:", pos)
    hum:MoveTo(pos)
    hum.MoveToFinished:Wait(3)
    return true
end

local function connectPressOnce(modelOrPart)
    local model = modelOrPart:IsA("Model") and modelOrPart or modelOrPart:FindFirstAncestorWhichIsA("Model")
    if not model then return end
    local prompt = model:FindFirstChildOfClass("ProximityPrompt") or modelOrPart:FindFirstChildOfClass("ProximityPrompt")
    if not prompt then return end
    local conn
    conn = prompt.Triggered:Connect(function(p)
        if p == localPlayer then
            toast("Pressed target: " .. (modelOrPart.Name))
            print("ProximityPrompt triggered for:", modelOrPart.Name)
            if conn then conn:Disconnect() end
        end
    end)
end

local function getButtonProgressRatio()
    local bp = localPlayer:FindFirstChild("ButtonProgress")
    if not bp then
        return nil, nil, nil
    end
    local unlocked = bp:FindFirstChild("UnlockedButtons")
    local total = bp:FindFirstChild("TotalButtons")
    if not unlocked or not total then
        return nil, nil, nil
    end
    local unlockedVal = unlocked.Value
    local totalVal = total.Value
    if type(unlockedVal) ~= "number" or type(totalVal) ~= "number" or totalVal <= 0 then
        return nil, nil, nil
    end
    return unlockedVal / totalVal, unlockedVal, totalVal
end

task.spawn(function()
    while true do
        local ratio, unlocked, total = getButtonProgressRatio()
        if ratio then
            local percent = string.format("%.2f", ratio * 100)
            TotalButtonsLabel:SetText(("Buttons unlocked: %d / %d (%s%%)"):format(unlocked, total, percent))
        else
            TotalButtonsLabel:SetText("Buttons unlocked: N/A")
        end

        ManaLabel:SetText("Mana: " .. tostring(getMana()))

        if running and not busy and hrp and hum then
            busy = true
            toast("Searching for valid target...")
            print("Searching for valid target buttons...")
            local tycoon = getMyTycoon()
            if not tycoon then
                StatusLabel:SetText("Tycoon not found")
                print("Tycoon not found for player.")
                busy = false
                task.wait(SCAN_INTERVAL)
                continue
            end
            local cands = gatherCandidates(tycoon)
            local target = pickTargetBySelection(cands)
            if target then
                StatusLabel:SetText("Target: " .. target.inst.Name)
                print("Valid target found:", target.inst.Name)
                toast("Valid target found: " .. target.inst.Name)
                toast("Pathfinding to valid target: " .. target.inst.Name)
                connectPressOnce(target.inst)
                local ok = moveExactlyTo(target.pos)
                StatusLabel:SetText("Arrived: " .. target.inst.Name)
                if ok then
                    print("Arrived at:", target.inst.Name)
                else
                    print("Move failed for:", target.inst.Name)
                end
            else
                StatusLabel:SetText("No valid target")
                print("No valid target button found!")
            end
            busy = false
        end
        task.wait(SCAN_INTERVAL)
    end
end)

