-- Auto Tycoon Script with Rebirth Timing and ETA Slider, Fully Integrated

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local VirtualInputManager = game:GetService("VirtualInputManager")
local plr = Players.LocalPlayer

local Library = loadstring(game:HttpGet(
    "https://raw.githubusercontent.com/deividcomsono/Obsidian/main/Library.lua"
))()

math.randomseed(tick())

-- === UI Setup ===
local Win = Library:CreateWindow({
    Title = "Auto Tycoon with Smart Rebirth + ETA",
    ToggleKeybind = Enum.KeyCode.RightControl,
    Center = true,
    AutoShow = true
})
local Tab = Win:AddTab("Main", "home")
local Controls = Tab:AddLeftGroupbox("Controls")
local TglButtons = Controls:AddToggle("AutoBtns", {Text = "Auto Buttons", Default = true})
local TglDebris = Controls:AddToggle("AutoDebris", {Text = "Auto Collect Debris", Default = true})
local TglCollect = Controls:AddToggle("AutoCollectResize", {Text = "CollectZone Resizer", Default = true})
local TglWeather = Controls:AddToggle("AutoWeather", {Text = "Auto Weather", Default = true})

-- Add Rebirth Stats Panel
local StatsPanel = Tab:AddLeftGroupbox("Rebirth Timing & ETA")

local AvgTimeLabel = StatsPanel:AddLabel("Average Rebirth Time: Calculating...")
local TargetSlider = StatsPanel:AddSlider("TargetRebirth", {
    Text = "Target Rebirth",
    Default = plr.PlayerData.Rebirth.Value + 1,
    Min = plr.PlayerData.Rebirth.Value + 1,
    Max = plr.PlayerData.Rebirth.Value + 500,
    Rounding = 1
})
local ETALabel = StatsPanel:AddLabel("ETA to Target: Calculating...")

-- === State Vars ===
local running = true
local debrisOn = true
local collectResizerOn = true
local autoWeatherOn = true
local busy = false
local rebirthing = false

-- Timing and rebirth tracking
local MAX_REBIRTH_HISTORY = 10
local rebirthData = {}   -- stores last 10 rebirth cycles: { totalTime, buttonTimes }
local currentCycle = {
    startTime = nil,
    lastButtonTime = nil,
    lastButtonCount = 0,
    buttonTimes = {}
}

-- Utility function to format seconds as "Xm YYs"
local function formatTime(seconds)
    local m = math.floor(seconds / 60)
    local s = math.floor(seconds % 60)
    return string.format("%dm %02ds", m, s)
end

-- Average across last 10 rebirths
local function getAverageRebirthTime()
    local sum, count = 0, 0
    for _, cycle in ipairs(rebirthData) do
        if cycle.totalTime then
            sum = sum + cycle.totalTime
            count = count + 1
        end
    end
    if count == 0 then return nil end
    return sum / count
end

-- Average time for a button across last 10 rebirths
local function getAverageButtonTime(buttonName)
    local sum, count = 0, 0
    for _, cycle in ipairs(rebirthData) do
        local t = cycle.buttonTimes[buttonName]
        if t then
            sum = sum + t
            count = count + 1
        end
    end
    if count == 0 then return nil end
    return sum / count
end

-- Current target rebirth from slider
local targetRebirth = TargetSlider.Value

local function updateStatsUI()
    local avgRebirth = getAverageRebirthTime()
    if avgRebirth then
        AvgTimeLabel:SetText("Average Rebirth Time: " .. formatTime(avgRebirth))
    else
        AvgTimeLabel:SetText("Average Rebirth Time: Calculating...")
    end

    local currentRebirth = plr.PlayerData.Rebirth.Value or 0
    if targetRebirth < currentRebirth + 1 then
        targetRebirth = currentRebirth + 1
        TargetSlider:SetValue(targetRebirth)
    end

    if avgRebirth then
        local rebirthsLeft = math.max(0, targetRebirth - currentRebirth)
        local etaSeconds = rebirthsLeft * avgRebirth
        -- convert etaSeconds to h m format
        local h = math.floor(etaSeconds / 3600)
        local m = math.floor((etaSeconds % 3600) / 60)
        local etaText = (h > 0 and string.format("%dh ", h) or "") .. string.format("%dm", m)
        ETALabel:SetText("ETA to Target: " .. etaText)
    else
        ETALabel:SetText("ETA to Target: Calculating...")
    end
end

TargetSlider:OnChanged(function(val)
    targetRebirth = val
    updateStatsUI()
end)

-- === Timing Tracking Hooks ===

-- Called when UnlockedButtons goes 0 -> 1: start new rebirth cycle
local function startCycle()
    currentCycle.startTime = tick()
    currentCycle.lastButtonTime = currentCycle.startTime
    currentCycle.lastButtonCount = 1
    currentCycle.buttonTimes = {}
    print("[Cycle] Started new rebirth cycle at " .. os.date("%X"))
end

-- Called when UnlockedButtons increases, record time for that button
local function logButtonPress(buttonName, newCount)
    local now = tick()
    if currentCycle.lastButtonTime then
        local elapsed = now - currentCycle.lastButtonTime
        currentCycle.buttonTimes[buttonName] = elapsed
        print(string.format("[Button] Pressed %s took %.2f seconds", buttonName, elapsed))
    end
    currentCycle.lastButtonTime = now
    currentCycle.lastButtonCount = newCount
end

-- Called on rebirth completion: finalize and save timing data
local function endCycle()
    if not currentCycle.startTime then return end

    local totalTime = tick() - currentCycle.startTime
    print(string.format("[Cycle] Rebirth cycle ended. Total time: %.2f seconds", totalTime))

    table.insert(rebirthData, {
        totalTime = totalTime,
        buttonTimes = currentCycle.buttonTimes
    })

    if #rebirthData > MAX_REBIRTH_HISTORY then
        table.remove(rebirthData, 1)
    end

    currentCycle.startTime = nil
    currentCycle.lastButtonTime = nil
    currentCycle.lastButtonCount = 0
    currentCycle.buttonTimes = {}

    updateStatsUI()
end

-- === Connect to UnlockedButtons changes ===
local unlockedButtons = plr.ButtonProgress:WaitForChild("UnlockedButtons")
local lastUnlockedValue = unlockedButtons.Value or 0

unlockedButtons:GetPropertyChangedSignal("Value"):Connect(function()
    local val = unlockedButtons.Value

    -- Detect cycle start: going from 0 to 1
    if val == 1 and lastUnlockedValue == 0 then
        startCycle()
    end

    -- Log button press when value increments
    if currentCycle.startTime and val > lastUnlockedValue then
        local buttonName = "Button_" .. tostring(val)
        logButtonPress(buttonName, val)
    end

    -- Detect cycle end: going from >0 to 0
    if val == 0 and lastUnlockedValue > 0 then
        endCycle()
    end

    lastUnlockedValue = val
end)

-- === Auto Buttons ===
local function validBtn(inst)
    local m = inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
    if not (m and m:FindFirstChild("Button_Indicator", true)) then return false end
    local rebirthReq = m:GetAttribute("RebirthReq")
    if type(rebirthReq) ~= "number" then return false end
    if rebirthReq > (plr.PlayerData.Rebirth.Value or 0) then return false end
    if (plr.PlayerData.Mana and plr.PlayerData.Mana.Value or 0) < (inst:GetAttribute("UnlockCost") or math.huge) then return false end
    local pos = m.PrimaryPart and m.PrimaryPart.Position or m:GetPivot().Position
    return pos ~= nil
end

local function gatherCands(root)
    local res = {}
    for _, inst in ipairs(root:GetDescendants()) do
        if validBtn(inst) then
            table.insert(res, inst)
        end
    end
    return res
end

local hrp = nil
if plr.Character then
    hrp = plr.Character:FindFirstChild("HumanoidRootPart")
end
plr.CharacterAdded:Connect(function(c)
    hrp = c:WaitForChild("HumanoidRootPart")
end)

local function bringBtnAndTrigger(inst)
    if not hrp then return end
    local m = inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
    for _, p in ipairs(m:GetDescendants()) do
        if p:IsA("BasePart") then
            p.CanCollide = false
            p.Massless = true
        end
    end
    m:PivotTo(hrp.CFrame * CFrame.new(0, 0, -2))
    task.wait(0.05)
    local prompt = m:FindFirstChildOfClass("ProximityPrompt") or m:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        prompt.MaxActivationDistance = 15
        prompt.RequiresLineOfSight = false
        prompt:InputHoldBegin()
        task.wait(prompt.HoldDuration + 0.05)
        prompt:InputHoldEnd()
        VirtualInputManager:SendKeyEvent(true, "E", false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, "E", false, game)
    end
end

-- === Smart Debris ===
local function teleportDebrisParts()
    if not debrisOn or not hrp then return end
    local debrisFolder = Workspace:FindFirstChild("Debris")
    if debrisFolder then
        for _, obj in ipairs(debrisFolder:GetDescendants()) do
            if obj:IsA("BasePart") then
                local nameLower = string.lower(obj.Name)
                if nameLower:find("crystal") or nameLower:find("manana") then
                    obj.Anchored = false
                    obj.CanCollide = false
                    obj.Massless = true
                    obj.CFrame = hrp.CFrame
                    task.wait(0.02)
                end
            end
        end
    end
end

-- === CollectZone Resizer (deep search) ===
local collectResizerThread
local function resizeMyCollectZone()
    if collectResizerThread then
        task.cancel(collectResizerThread)
        collectResizerThread = nil
    end
    if not collectResizerOn then return end

    collectResizerThread = task.spawn(function()
        local myTycoon
        repeat
            task.wait(0.2)
            local tf = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Tycoons")
            myTycoon = tf and tf:FindFirstChild(plr.Name)
        until myTycoon

        local baseSize = Vector3.new(2000, 2000, 2000)
        local delta = Vector3.new(1, 1, 1)
        local flip = false

        while collectResizerOn do
            myTycoon = Workspace.Map.Tycoons:FindFirstChild(plr.Name)
            if myTycoon then
                local cz
                for _, d in ipairs(myTycoon:GetDescendants()) do
                    if d:IsA("BasePart") and d.Name == "CollectZone" then
                        cz = d
                        break
                    end
                end
                if cz then
                    cz.Size = flip and (baseSize - delta) or (baseSize + delta)
                end
            end
            flip = not flip
            task.wait(0.5)
        end
    end)
end

-- === Rebirth Function with integrated endCycle call ===
local rebirthCooldown = false
local function doRebirth()
    rebirthing = true
    local repEv = ReplicatedStorage:WaitForChild("RemoteEvents")
    repEv.RebirthCallback:InvokeServer(plr)
    task.wait(2)

    local masteryFolder = plr:WaitForChild("PlayerData"):FindFirstChild("Mastery")
    if masteryFolder then
        local lowestValue = math.huge
        local candidates = {}
        for _, elem in ipairs(masteryFolder:GetChildren()) do
            if typeof(elem.Value) == "number" and elem.Value >= 0 then
                if elem.Value < lowestValue then
                    lowestValue = elem.Value
                    candidates = {elem.Name}
                elseif elem.Value == lowestValue then
                    table.insert(candidates, elem.Name)
                end
            end
        end
        if #candidates > 0 then
            local chosen = candidates[math.random(#candidates)]
            Library:Notify({
                Title = "Auto Rebirth",
                Description = string.format("Chose element '%s' (Mastery: %d)", chosen, lowestValue),
                Time = 3
            })
            repEv.ElementCallback:InvokeServer(chosen)
            repEv.PickCallback:InvokeServer()
        else
            Library:Notify({Title = "Auto Rebirth", Description = "No mastery elements ≥ 0 found!", Time = 3})
            repEv.PickCallback:InvokeServer()
        end
    else
        Library:Notify({Title = "Auto Rebirth", Description = "Mastery folder not found!", Time = 3})
        repEv.PickCallback:InvokeServer()
    end

    if collectResizerOn then resizeMyCollectZone() end
    rebirthing = false

    -- Call endCycle here to log the rebirth completion timing
    endCycle()
end

-- === Main Loop ===
task.spawn(function()
    while true do
        if running and not busy and not rebirthing then
            busy = true

            local myTycoon = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Tycoons") and Workspace.Map.Tycoons:FindFirstChild(plr.Name)
            if myTycoon then
                local cands = gatherCands(myTycoon)
                if #cands > 0 then
                    bringBtnAndTrigger(cands)
                end
            end

            local bpObj = plr:FindFirstChild("ButtonProgress")
            local unld = bpObj and bpObj:FindFirstChild("UnlockedButtons")
            local tot = bpObj and bpObj:FindFirstChild("TotalButtons")

            if unld and tot then
                if unld.Value == tot.Value and not rebirthCooldown then
                    rebirthCooldown = true
                    doRebirth()
                    task.delay(5, function() rebirthCooldown = false end)
                end
            end

            busy = false
        end

        teleportDebrisParts()

        -- Auto Weather Skip (with notification)
        if autoWeatherOn then
            local ev = Players:FindFirstChild("Event_Values")
            if ev then
                local timer = ev:FindFirstChild("Timer")
                local eventName = ev:FindFirstChild("EventDisplayName")
                if timer and timer.Value > 0 then
                    local remote = ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("SkipEvent")
                    remote:FireServer()
                    Library:Notify({
                        Title = "Auto Weather",
                        Description = string.format("Skipped weather: %s (%d seconds left)", eventName and eventName.Value or "Unknown", timer.Value),
                        Time = 3
                    })
                end
            end
        end

        task.wait(0.2)
    end
end)

-- === Toggle bindings for features ===
TglButtons:OnChanged(function(v) running = v end)
TglDebris:OnChanged(function(v) debrisOn = v end)
TglCollect:OnChanged(function(v)
    collectResizerOn = v
    resizeMyCollectZone()
end)
TglWeather:OnChanged(function(v) autoWeatherOn = v end)

-- Start initial resize zone if toggled on
if collectResizerOn then
    resizeMyCollectZone()
end

-- Update UI periodically just in case
task.spawn(function()
    while true do
        updateStatsUI()
        task.wait(5)
    end
end)
