-- Auto Tycoon Script with Advanced Rebirth Logic and Element Pick by Mastery
-- Features: Auto Buttons + Auto Debris (OFF default) + Smart Auto Rebirth + Element Selection

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local VirtualInputManager = game:GetService("VirtualInputManager")
local plr = Players.LocalPlayer

-- For random tie break
math.randomseed(tick())

-- Load Obsidian UI library
local Library = loadstring(game:HttpGet(
    "https://raw.githubusercontent.com/deividcomsono/Obsidian/main/Library.lua"
))()
local Win = Library:CreateWindow({
    Title = "Auto Tycoon with Smart Rebirth",
    ToggleKeybind = Enum.KeyCode.RightControl,
    Center = true,
    AutoShow = true
})
local Tab = Win:AddTab("Main", "home")
local Controls = Tab:AddLeftGroupbox("Controls")
local TglButtons = Controls:AddToggle("AutoBtns", {Text = "Auto Buttons", Default = false})
local TglDebris  = Controls:AddToggle("AutoDebris", {Text = "Auto Collect Debris", Default = false})

-- Runtime Variables
local running = false
local debrisOn = false
local busy = false
local rebirthing = false

-- Rebirth State Tracking
local rebirthStarted = false
local rebirthCooldown = false
local rebirthStartTime, rebirthEndTime
local lastButtonValue = 0
local buttonPressCount = 0
local REBIRTH_COOLDOWN_TIME = 5 -- seconds cooldown

-- Character and HumanoidRootPart reference
local char, hrp
if plr.Character then
    char = plr.Character
    hrp = char:WaitForChild("HumanoidRootPart")
end
plr.CharacterAdded:Connect(function(c)
    char = c
    hrp = c:WaitForChild("HumanoidRootPart")
end)

-- Utility functions
local function getMana()
    local PD = plr:FindFirstChild("PlayerData")
    local ManaVal = PD and PD:FindFirstChild("Mana")
    return ManaVal and ManaVal.Value or 0
end

local function attrAnywhere(m, k)
    if m:GetAttribute(k) ~= nil then return true end
    for _, d in ipairs(m:GetDescendants()) do
        if d:GetAttribute(k) ~= nil then return true end
    end
    return false
end

local function getBtnPos(inst)
    local m = inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
    if not m then return nil end
    return m.PrimaryPart and m.PrimaryPart.Position or m:GetPivot().Position
end

local function validBtn(inst)
    local m = inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
    if not (m and m:FindFirstChild("Button_Indicator", true)) then return false end
    if not attrAnywhere(m, "Premium") and not attrAnywhere(m, "RebirthReq") then return false end
    if getMana() < (inst:GetAttribute("UnlockCost") or math.huge) then return false end
    return getBtnPos(inst) ~= nil
end

local function gatherCands(root)
    local res = {}
    for _, inst in ipairs(root:GetDescendants()) do
        if validBtn(inst) then table.insert(res, inst) end
    end
    return res
end

local function bringBtnAndTrigger(inst)
    if not hrp then return end
    local m = inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
    for _, p in ipairs(m:GetDescendants()) do
        if p:IsA("BasePart") then
            p.CanCollide = false
            p.Massless = true
        end
    end
    m:PivotTo(hrp.CFrame * CFrame.new(0, 0, -2))
    task.wait(0.05)
    local prompt = m:FindFirstChildOfClass("ProximityPrompt") or m:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        prompt.MaxActivationDistance = 15
        prompt.RequiresLineOfSight = false
        prompt:InputHoldBegin()
        task.wait(prompt.HoldDuration + 0.05)
        prompt:InputHoldEnd()
        VirtualInputManager:SendKeyEvent(true, "E", false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, "E", false, game)
    end
end

-- Debris Collector
local function teleportDebrisParts()
    if not debrisOn or not hrp then return end
    local debris = Workspace:FindFirstChild("Debris")
    if not debris then return end
    for _, name in ipairs({"Premium_Manana", "Manana", "Purple_Crystal", "Blue_Crystal"}) do
        local part = debris:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            part.CanCollide = false
            part.Massless = true
            part.CFrame = hrp.CFrame
            task.wait(0.05)
            break
        end
    end
end

-- doRebirth with mastery-based element pick
local function doRebirth()
    rebirthing = true
    local repEv = ReplicatedStorage:WaitForChild("RemoteEvents")

    -- Trigger rebirth
    repEv.RebirthCallback:InvokeServer(plr)
    task.wait(2) -- allow server state update before next calls

    -- Select element that has the lowest mastery value
    local masteryFolder = plr:WaitForChild("PlayerData"):FindFirstChild("Mastery")
    if masteryFolder then
        local lowestValue = math.huge
        local candidates = {}

        for _, elem in ipairs(masteryFolder:GetChildren()) do
            if typeof(elem.Value) == "number" then
                if elem.Value < lowestValue then
                    lowestValue = elem.Value
                    candidates = {elem.Name}
                elseif elem.Value == lowestValue then
                    table.insert(candidates, elem.Name)
                end
            end
        end

        if #candidates > 0 then
            local chosen = candidates[math.random(1, #candidates)]
            print(string.format("[Auto Rebirth] Chose element '%s' (Mastery: %d)", chosen, lowestValue))
            repEv.ElementCallback:InvokeServer(chosen)
            repEv.PickCallback:InvokeServer()
        else
            warn("[Auto Tycoon] No elements found in Mastery folder")
            repEv.PickCallback:InvokeServer()
        end
    else
        warn("[Auto Tycoon] Mastery folder not found")
        repEv.PickCallback:InvokeServer()
    end

    rebirthing = false
end

-- Main loop: buttons farm, debris collect, rebirth detection
task.spawn(function()
    while true do
        local bpObj = plr:FindFirstChild("ButtonProgress")
        local unld = bpObj and bpObj:FindFirstChild("UnlockedButtons")
        local tot  = bpObj and bpObj:FindFirstChild("TotalButtons")

        if unld and tot then
            -- Reset on new rebirth (buttons reset)
            if unld.Value == 0 then
                rebirthStarted = false
                rebirthStartTime = nil
                buttonPressCount = 0
                lastButtonValue = 0
                rebirthCooldown = false
            end

            -- Start tracking after first button unlocked
            if not rebirthStarted and unld.Value > 0 and not rebirthStartTime then
                rebirthStartTime = tick()
                rebirthStarted = true
                buttonPressCount = 1
                lastButtonValue = unld.Value
            end

            -- Count button increments
            if rebirthStarted and unld.Value > lastButtonValue then
                buttonPressCount += (unld.Value - lastButtonValue)
                lastButtonValue = unld.Value
            end

            -- Trigger rebirth when all buttons unlocked
            if rebirthStarted and unld.Value == tot.Value and not rebirthCooldown then
                rebirthCooldown = true
                rebirthEndTime = tick()
                local duration = rebirthEndTime - (rebirthStartTime or rebirthEndTime)
                print(string.format("[Auto Rebirth] Cycle complete in %.2fs (%d buttons)", duration, buttonPressCount))
                rebirthStarted = false
                rebirthStartTime, rebirthEndTime, lastButtonValue = nil, nil, 0
                buttonPressCount = 0
                if running then
                    doRebirth()
                end
                task.delay(REBIRTH_COOLDOWN_TIME, function() rebirthCooldown = false end)
            end
        end

        teleportDebrisParts()

        if running and not busy and not rebirthing then
            busy = true
            local tycoon = Workspace.Map and Workspace.Map:FindFirstChild("Tycoons") and Workspace.Map.Tycoons:FindFirstChild(plr.Name)
            if tycoon then
                local cands = gatherCands(tycoon)
                if #cands > 0 then bringBtnAndTrigger(cands[1]) end
            end
            busy = false
        end

        task.wait(0.2)
    end
end)

-- UI event handlers
TglButtons:OnChanged(function(v)
    running = v
end)
TglDebris:OnChanged(function(v)
    debrisOn = v
end)
