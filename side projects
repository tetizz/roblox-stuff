local function checkWhitelist()
    for _, player in ipairs(Players:GetPlayers()) do
        if not whitelist[player.UserId] then
            plr:Kick("A non-whitelisted player is in the game. Script stopped for your safety.")
            return true
        end
    end
    return false
end

