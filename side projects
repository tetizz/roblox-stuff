task.spawn(function()
    while true do
        local bp = plr:FindFirstChild("ButtonProgress")
        local unld = bp and bp:FindFirstChild("UnlockedButtons")
        local tot = bp and bp:FindFirstChild("TotalButtons")
        if unld and tot then
            ButtonsLbl:SetText(("Buttons unlocked: %d / %d"):format(unld.Value, tot.Value))
            if unld.Value >= tot.Value and not rebirthing then
                doRebirth()
            end
        else
            ButtonsLbl:SetText("Buttons unlocked: N/A")
        end

        ManaLbl:SetText("Mana: " .. tostring(getMana()))

        teleportDebrisParts()

        if running and not busy and not rebirthing then
            busy = true
            local tycoon = Workspace.Map.Tycoons:FindFirstChild(plr.Name)
            if tycoon then
                local cands = gatherCands(tycoon)
                if #cands > 0 then
                    local targ = cands[1]
                    StatusLbl:SetText("Bringing: " .. targ.inst.Name)
                    bringBtn(targ.inst)
                    task.wait(0.05)
                    triggerPrompt(targ.inst)
                    StatusLbl:SetText("Activated: " .. targ.inst.Name)
                else
                    MasteryLbl:SetText(getMasteryStr()) -- Mastery only in stats box
                end
            else
                StatusLbl:SetText("Tycoon not found")
            end
            busy = false
        end

        if autoWpnRunning and not busy and not rebirthing then
            busy = true
            autoGetWeapon()
            busy = false
        end

        task.wait(SliderScan.Value or SCAN_INT)
    end
end)

