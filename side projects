-- Helpers to check/get attributes anywhere
local function hasAttributeAnywhere(model, attrName)
    if not model or not attrName then return false end
    if model:GetAttribute(attrName) ~= nil then return true end
    for _, desc in ipairs(model:GetDescendants()) do
        if desc:GetAttribute(attrName) ~= nil then return true end
    end
    return false
end

local function getAttributeAnywhere(model, attrName)
    if not model or not attrName then return nil end
    local val = model:GetAttribute(attrName)
    if val ~= nil then return val end
    for _, desc in ipairs(model:GetDescendants()) do
        val = desc:GetAttribute(attrName)
        if val ~= nil then return val end
    end
    return nil
end

-- Button helper functions
local function getButtonPivotPos(inst)
    local model = inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
    if not model then return nil end
    local btnBase = model:FindFirstChild("Button_Base")
    if btnBase and btnBase:IsA("BasePart") then return btnBase.Position end
    if model.PrimaryPart then return model.PrimaryPart.Position end
    return model:GetPivot().Position
end

local function isValidButton(inst)
    local model = inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")

    if not (model and model:FindFirstChild("Button_Indicator", true)) then
        return false, "No Button_Indicator"
    end

    local hasPremium = hasAttributeAnywhere(model, "Premium")
    local hasRebirthReq = hasAttributeAnywhere(model, "RebirthReq")

    if not hasPremium and not hasRebirthReq then
        return false, "No Premium or RebirthReq"
    end

    local hasCollidable = false
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") and part.CanCollide then
            hasCollidable = true
            break
        end
    end
    if not hasCollidable then
        return false, "No collidable parts"
    end

    local cost = inst:GetAttribute("UnlockCost")
    if type(cost) ~= "number" then
        return false, nil
    end
    if getMana() < cost then
        return false, "Not enough mana"
    end

    local playerRebirth = 0
    local pd = localPlayer:FindFirstChild("PlayerData")
    if pd then
        local rebirthValue = pd:FindFirstChild("Rebirth")
        if rebirthValue and typeof(rebirthValue.Value) == "number" then
            playerRebirth = rebirthValue.Value
        end
    end

    local rebirthReq = getAttributeAnywhere(model, "RebirthReq")
    if rebirthReq and type(rebirthReq) == "number" and playerRebirth < rebirthReq then
        return false, "Rebirth requirement not met"
    end

    local pos = getButtonPivotPos(inst)
    if not pos then
        return false, "No position"
    end

    return true, cost, pos
end

local function gatherCandidates(root)
    local list = {}
    for _, inst in ipairs(root:GetDescendants()) do
        local ok, costOrReason, pos = isValidButton(inst)
        if ok then
            table.insert(list, { inst = inst, cost = costOrReason, pos = pos })
        end
    end
    return list
end

-- Teleport button to player (move all BaseParts)
local function bringButtonToPlayer(buttonInstance)
    if not hrp then return end

    local buttonModel = buttonInstance:IsA("Model") and buttonInstance or buttonInstance:FindFirstAncestorWhichIsA("Model")
    local targetCFrame = hrp.CFrame * CFrame.new(0, 0, -2)

    if buttonModel then
        if not buttonModel.PrimaryPart then
            local primary = buttonModel:FindFirstChildWhichIsA("BasePart")
            if primary then buttonModel.PrimaryPart = primary end
        end

        if buttonModel.PrimaryPart then
            local offset = targetCFrame.Position - buttonModel.PrimaryPart.Position
            for _, part in ipairs(buttonModel:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                    part.Massless = true
                    part.CFrame = part.CFrame + offset
                end
            end
        else
            for _, part in ipairs(buttonModel:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                    part.Massless = true
                    part.CFrame = targetCFrame
                end
            end
        end
    elseif buttonInstance:IsA("BasePart") then
        buttonInstance.CanCollide = false
        buttonInstance.Massless = true
        buttonInstance.CFrame = targetCFrame
    end
end

-- Proximity prompt trigger on target
local function autoTriggerPrompt(target)
    local model = target:IsA("Model") and target or target:FindFirstAncestorWhichIsA("Model")
    local prompt = model and model:FindFirstChildOfClass("ProximityPrompt") or target:FindFirstChildOfClass("ProximityPrompt")
    if prompt and prompt.Enabled and hrp and (hrp.Position - prompt.Parent.Position).Magnitude <= prompt.MaxActivationDistance then
        prompt:InputHoldBegin()
        task.wait(prompt.HoldDuration + 0.05)
        prompt:InputHoldEnd()
    end
end

-- Function to get mastery status string for StatusLabel
local function getMasteryStatus()
    local pd = localPlayer:FindFirstChild("PlayerData")
    if not pd then return "No PlayerData" end
    local mastery = pd:FindFirstChild("Mastery")
    if not mastery then return "No Mastery" end

    local parts = {}
    for _, child in ipairs(mastery:GetChildren()) do
        if child:IsA("NumberValue") or child:IsA("IntValue") then
            table.insert(parts, string.format("%s: %d", child.Name, child.Value))
        elseif child:IsA("StringValue") then
            table.insert(parts, string.format("%s: %s", child.Name, child.Value))
        else
            table.insert(parts, string.format("%s: %s", child.Name, tostring(child.Value)))
        end
    end

    return table.concat(parts, "\n")
end

-- Rebirth process with upgrades and mastery element pick
local function startRebirthSequence()
    rebirthInProgress = true
    didUpgradeThisRebirth = false
    toast("Starting rebirth...")

    local repEvents = ReplicatedStorage:WaitForChild("RemoteEvents")
    repEvents.RebirthCallback:InvokeServer(Players:WaitForChild(localPlayer.Name))
    task.wait(3)

    if not didUpgradeThisRebirth then
        local upPoints = localPlayer.PlayerData.UpgradePoints.Value
        if upPoints > 0 then
            for _, stat in ipairs({ "Jump", "Speed", "Regen", "Health" }) do
                repEvents.UpgradeCallback:InvokeServer(stat)
            end
            didUpgradeThisRebirth = true
        end
    end

    local mastery = localPlayer.PlayerData:FindFirstChild("Mastery")
    if mastery then
        local minVal, candidates = math.huge, {}
        for _, el in ipairs(mastery:GetChildren()) do
            if type(el.Value) == "number" and el.Value >= 0 then
                if el.Value < minVal then
                    candidates = { el.Name }
                    minVal = el.Value
                elseif el.Value == minVal then
                    table.insert(candidates, el.Name)
                end
            end
        end
        if #candidates > 0 then
            repEvents.ElementCallback:InvokeServer(candidates[math.random(#candidates)])
        end
    end
    repEvents.PickCallback:InvokeServer()

    rebirthInProgress = false

    -- Restart CollectZone size alternating after rebirth
    alternateCollectZoneSize()
end

-- === Auto get weapons implementation ===

-- Stores the original CFrame of bases currently moved to player
local weaponBaseOriginalCFrames = {}

local function hasWeaponInBackpack(weaponName)
    local backpack = localPlayer:FindFirstChild("Backpack")
    if not backpack then return false end
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool.Name == weaponName then
            return true
        end
    end
    return false
end

local function getSpellStandsBases()
    local bases = {} -- { basePart, weaponName, originalCFrame }

    local myTycoon = getMyTycoon()
    if not myTycoon then return bases end

    for _, folder in ipairs(myTycoon:GetChildren()) do
        -- For each child folder (like F1_SpellStand_1)
        if folder:IsA("Model") or folder:IsA("Folder") then
            for _, candidate in ipairs(folder:GetChildren()) do
                if candidate.Name == "Base" and candidate:IsA("BasePart") then
                    -- Check if it has exactly 2 ProximityPrompt children
                    local prompts = {}
                    for _, child in ipairs(candidate:GetChildren()) do
                        if child:IsA("ProximityPrompt") then
                            table.insert(prompts, child)
                        end
                    end
                    if #prompts == 2 then
                        -- Check ActionText on prompts for weapon name(s)
                        -- We'll pick the first prompt's ActionText as the weapon name to check in backpack
                        local weaponName = prompts[1].ActionText

                        if weaponName and weaponName ~= "" then
                            table.insert(bases, {
                                base = candidate,
                                weaponName = weaponName,
                                originalCFrame = candidate.CFrame,
                            })
                        end
                    end
                end
            end
        end
    end
    return bases
end

local function bringBaseToPlayer(basePart)
    if not hrp then return end
    basePart.CanCollide = false
    basePart.Massless = true
    basePart.CFrame = hrp.CFrame * CFrame.new(0, 0, -2)
end

local function returnBaseToOriginal(baseData)
    if baseData and baseData.base and baseData.originalCFrame then
        baseData.base.CanCollide = true
        baseData.base.Massless = false
        baseData.base.CFrame = baseData.originalCFrame
        weaponBaseOriginalCFrames[baseData.base] = nil
    end
end

local function autoGetWeapons()
    -- Get all spellstand bases with weapon names
    local bases = getSpellStandsBases()
    for _, baseData in ipairs(bases) do
        local base = baseData.base
        local weaponName = baseData.weaponName

        -- If we moved this base before and weapon already acquired, move base back to original position
        if weaponBaseOriginalCFrames[base] and hasWeaponInBackpack(weaponName) then
            returnBaseToOriginal(baseData)
        end
    end

    -- Try to find a weapon base not yet acquired
    for _, baseData in ipairs(bases) do
        local base = baseData.base
        local weaponName = baseData.weaponName

        if not hasWeaponInBackpack(weaponName) then
            -- Store original CFrame if not stored
            if not weaponBaseOriginalCFrames[base] then
                weaponBaseOriginalCFrames[base] = base.CFrame
            end
            -- Teleport to player
            bringBaseToPlayer(base)

            -- Trigger both ProximityPrompts on base to pick up weapon(s)
            for _, child in ipairs(base:GetChildren()) do
                if child:IsA("ProximityPrompt") then
                    if hrp and (hrp.Position - child.Parent.Position).Magnitude <= child.MaxActivationDistance then
                        child:InputHoldBegin()
                        task.wait(child.HoldDuration + 0.1)
                        child:InputHoldEnd()
                    end
                end
            end

            -- Only attempt one weapon at a time
            StatusLabel:SetText("Getting Weapon: " .. weaponName)
            return
        end
    end

    -- If no weapons to get, clear status except mastery
    StatusLabel:SetText(getMasteryStatus())
end

-- === Main loop ===
task.spawn(function()
    while true do
        local bp = localPlayer:FindFirstChild("ButtonProgress")
        local unlocked = bp and bp:FindFirstChild("UnlockedButtons")
        local total = bp and bp:FindFirstChild("TotalButtons")
        if unlocked and total then
            TotalButtonsLabel:SetText(("Buttons unlocked: %d / %d"):format(unlocked.Value, total.Value))
            if unlocked.Value >= total.Value and not rebirthInProgress then
                startRebirthSequence()
            end
        else
            TotalButtonsLabel:SetText("Buttons unlocked: N/A")
        end

        ManaLabel:SetText("Mana: " .. tostring(getMana()))

        -- Update mastery status in StatusLabel every cycle
        if not busy then -- avoid clobbering during busy actions
            StatusLabel:SetText(getMasteryStatus())
        end

        if running and not busy and not rebirthInProgress then
            busy = true
            local tycoon = getMyTycoon()
            if tycoon then
                local cands = gatherCandidates(tycoon)
                if #cands > 0 then
                    local target = cands[1]
                    StatusLabel:SetText("Bringing: " .. target.inst.Name)
                    bringButtonToPlayer(target.inst)
                    task.wait(0.05)
                    autoTriggerPrompt(target.inst)
                    StatusLabel:SetText("Activated: " .. target.inst.Name)
                else
                    StatusLabel:SetText(getMasteryStatus())
                end
            else
                StatusLabel:SetText("Tycoon not found")
            end
            busy = false
        end

        -- Auto get weapons loop
        if autoGetWeaponsRunning and not busy and not rebirthInProgress then
            busy = true
            autoGetWeapons()
            busy = false
        end

        task.wait(SCAN_INTERVAL)
    end
end)

