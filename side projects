-- Auto Tycoon Script: Buttons + Smart Debris + Smart Rebirth + Lowest Mastery ≥ 0 + Player-only CollectZone Resize
-- Buttons require RebirthReq <= your current Rebirth value
-- Both toggles OFF by default.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local VirtualInputManager = game:GetService("VirtualInputManager")
local plr = Players.LocalPlayer

math.randomseed(tick())

-- Load Obsidian UI
local Library = loadstring(game:HttpGet(
    "https://raw.githubusercontent.com/deividcomsono/Obsidian/main/Library.lua"
))()
local Win = Library:CreateWindow({
    Title = "Auto Tycoon with Smart Rebirth",
    ToggleKeybind = Enum.KeyCode.RightControl,
    Center = true,
    AutoShow = true
})
local Tab = Win:AddTab("Main", "home")
local Controls = Tab:AddLeftGroupbox("Controls")
local TglButtons = Controls:AddToggle("AutoBtns", {Text = "Auto Buttons", Default = false})
local TglDebris = Controls:AddToggle("AutoDebris", {Text = "Auto Collect Debris", Default = false})

local running = false
local debrisOn = false
local busy = false
local rebirthing = false

-- Rebirth state
local rebirthStarted = false
local rebirthCooldown = false
local rebirthStartTime, rebirthEndTime
local lastButtonValue = 0
local buttonPressCount = 0
local REBIRTH_COOLDOWN_TIME = 5

-- Setup HRP references
local char, hrp
if plr.Character then
    char = plr.Character
    hrp = char:WaitForChild("HumanoidRootPart")
end
plr.CharacterAdded:Connect(function(c)
    char = c
    hrp = c:WaitForChild("HumanoidRootPart")
end)

-- === Utilities ===
local function getMana()
    local PD = plr:FindFirstChild("PlayerData")
    local ManaVal = PD and PD:FindFirstChild("Mana")
    return ManaVal and ManaVal.Value or 0
end

local function getRebirths()
    local PD = plr:FindFirstChild("PlayerData")
    local rVal = PD and PD:FindFirstChild("Rebirth")
    if rVal and typeof(rVal.Value) == "number" then
        return rVal.Value
    end
    return 0
end

local function getBtnPos(inst)
    local m = inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
    if not m then return nil end
    return m.PrimaryPart and m.PrimaryPart.Position or m:GetPivot().Position
end

-- Only includes buttons with RebirthReq <= player's rebirths and are affordable
local function validBtn(inst)
    local m = inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
    if not (m and m:FindFirstChild("Button_Indicator", true)) then return false end
    local rebirthReq = m:GetAttribute("RebirthReq")
    if type(rebirthReq) ~= "number" then return false end
    if rebirthReq > getRebirths() then return false end
    if getMana() < (inst:GetAttribute("UnlockCost") or math.huge) then return false end
    return getBtnPos(inst) ~= nil
end

local function gatherCands(root)
    local res = {}
    for _, inst in ipairs(root:GetDescendants()) do
        if validBtn(inst) then
            table.insert(res, inst)
        end
    end
    return res
end

local function bringBtnAndTrigger(inst)
    if not hrp then return end
    local m = inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
    for _, p in ipairs(m:GetDescendants()) do
        if p:IsA("BasePart") then
            p.CanCollide = false
            p.Massless = true
        end
    end
    m:PivotTo(hrp.CFrame * CFrame.new(0, 0, -2))
    task.wait(0.05)
    local prompt = m:FindFirstChildOfClass("ProximityPrompt") or m:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        prompt.MaxActivationDistance = 15
        prompt.RequiresLineOfSight = false
        prompt:InputHoldBegin()
        task.wait(prompt.HoldDuration + 0.05)
        prompt:InputHoldEnd()
        VirtualInputManager:SendKeyEvent(true, "E", false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, "E", false, game)
    end
end

-- === Smart Debris Collector ===
local function teleportDebrisParts()
    if not debrisOn or not hrp then return end
    local debrisFolder = Workspace:FindFirstChild("Debris")
    if not debrisFolder then return end
    for _, obj in ipairs(debrisFolder:GetDescendants()) do
        if obj:IsA("BasePart") then
            local lowerName = string.lower(obj.Name)
            if string.find(lowerName, "crystal") or string.find(lowerName, "manana") then
                obj.Anchored = false
                obj.CanCollide = false
                obj.Massless = true
                obj.CFrame = hrp.CFrame
                task.wait(0.02)
            end
        end
    end
end

-- === Auto-resize ONLY this player's CollectZone ===
local function resizeMyCollectZone()
    task.spawn(function()
        local baseSize = Vector3.new(2000, 2000, 2000)
        local delta = Vector3.new(1, 1, 1)
        local flip = false
        while true do
            local myTycoon = Workspace:FindFirstChild("Map")
                and Workspace.Map:FindFirstChild("Tycoons")
                and Workspace.Map.Tycoons:FindFirstChild(plr.Name)
            if myTycoon then
                local cz = myTycoon:FindFirstChild("T_Collect_Zone")
                    and myTycoon.T_Collect_Zone:FindFirstChild("CollectZone")
                if cz and cz:IsA("BasePart") then
                    cz.Size = flip and (baseSize - delta) or (baseSize + delta)
                end
            end
            flip = not flip
            task.wait(0.5)
        end
    end)
end

resizeMyCollectZone() -- Start once at script launch

-- === Rebirth Action ===
local function doRebirth()
    rebirthing = true
    local repEv = ReplicatedStorage:WaitForChild("RemoteEvents")

    repEv.RebirthCallback:InvokeServer(plr)
    task.wait(2)

    local masteryFolder = plr:WaitForChild("PlayerData"):FindFirstChild("Mastery")
    if masteryFolder then
        local lowestValue = math.huge
        local candidates = {}
        for _, elem in ipairs(masteryFolder:GetChildren()) do
            if typeof(elem.Value) == "number" and elem.Value >= 0 then
                if elem.Value < lowestValue then
                    lowestValue = elem.Value
                    candidates = {elem.Name}
                elseif elem.Value == lowestValue then
                    table.insert(candidates, elem.Name)
                end
            end
        end
        if #candidates > 0 then
            local chosen = candidates[math.random(1, #candidates)]
            Library:Notify({
                Title = "Auto Rebirth",
                Description = string.format("Chose element '%s' (Mastery: %d)", chosen, lowestValue),
                Time = 3
            })
            repEv.ElementCallback:InvokeServer(chosen)
            repEv.PickCallback:InvokeServer()
        else
            Library:Notify({
                Title = "Auto Rebirth",
                Description = "No mastery elements ≥ 0 found!",
                Time = 3
            })
            repEv.PickCallback:InvokeServer()
        end
    else
        Library:Notify({
            Title = "Auto Rebirth",
            Description = "Mastery folder not found!",
            Time = 3
        })
        repEv.PickCallback:InvokeServer()
    end

    -- 🔄 Restart my CollectZone resizer after rebirth
    resizeMyCollectZone()

    rebirthing = false
end

-- === Main Loop ===
task.spawn(function()
    while true do
        local bpObj = plr:FindFirstChild("ButtonProgress")
        local unld = bpObj and bpObj:FindFirstChild("UnlockedButtons")
        local tot = bpObj and bpObj:FindFirstChild("TotalButtons")
        if unld and tot then
            if unld.Value == 0 then
                rebirthStarted = false
                rebirthStartTime = nil
                buttonPressCount = 0
                lastButtonValue = 0
                rebirthCooldown = false
            end
            if not rebirthStarted and unld.Value > 0 and not rebirthStartTime then
                rebirthStartTime = tick()
                rebirthStarted = true
                buttonPressCount = 1
                lastButtonValue = unld.Value
            end
            if rebirthStarted and unld.Value > lastButtonValue then
                buttonPressCount += (unld.Value - lastButtonValue)
                lastButtonValue = unld.Value
            end
            if rebirthStarted and unld.Value == tot.Value and not rebirthCooldown then
                rebirthCooldown = true
                rebirthEndTime = tick()
                local duration = rebirthEndTime - (rebirthStartTime or rebirthEndTime)
                Library:Notify({
                    Title = "Auto Rebirth",
                    Description = string.format("Cycle complete in %.2fs (%d buttons)", duration, buttonPressCount),
                    Time = 3
                })
                rebirthStarted = false
                rebirthStartTime, rebirthEndTime, lastButtonValue = nil, nil, 0
                buttonPressCount = 0
                if running then doRebirth() end
                task.delay(REBIRTH_COOLDOWN_TIME, function() rebirthCooldown = false end)
            end
        end

        teleportDebrisParts()

        if running and not busy and not rebirthing then
            busy = true
            local myTycoon = Workspace:FindFirstChild("Map")
                and Workspace.Map:FindFirstChild("Tycoons")
                and Workspace.Map.Tycoons:FindFirstChild(plr.Name)
            if myTycoon then
                local cands = gatherCands(myTycoon)
                if #cands > 0 then bringBtnAndTrigger(cands[1]) end
            end
            busy = false
        end
        task.wait(0.2)
    end
end)

-- UI bindings
TglButtons:OnChanged(function(v) running = v end)
TglDebris:OnChanged(function(v) debrisOn = v end)
