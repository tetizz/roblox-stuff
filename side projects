-- === Mastery Refresh ===
function refreshMastery()
    if not PlayerData then return end
    local masteryFolder = PlayerData:FindFirstChild("Mastery")
    if not masteryFolder then return end
    -- Delete old text
    MasteryLbl:SetText("")
    -- Build new string
    local lines = {}
    for _, stat in ipairs(masteryFolder:GetChildren()) do
        table.insert(lines, stat.Name..": "..tostring(stat.Value))
    end
    MasteryLbl:SetText(table.concat(lines, "\n"))
end

