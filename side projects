-- v1.9.35: robust ButtonProgress tracking, safe GUI tracking, fast loops, auto-rebirth, cleanup

-- === Version Guard + GUI Tracking ===
if getgenv().AutoTycoonRunning then
    warn("[Auto Tycoon] Old instance found — cleaning it up…")
    if getgenv().AutoTycoonGui and getgenv().AutoTycoonGui.Parent then
        pcall(function() getgenv().AutoTycoonGui:Destroy() end)
    end
    if getgenv().AutoTycoonCleanup then pcall(getgenv().AutoTycoonCleanup) end
    return
end
getgenv().AutoTycoonRunning = true
getgenv().AutoTycoonGui = nil

-- Track for cleanup
getgenv().AutoTycoonRefs = {conns = {}, tasks = {}}
local function trackConnection(conn) table.insert(getgenv().AutoTycoonRefs.conns, conn) return conn end
local function trackTask(thread) table.insert(getgenv().AutoTycoonRefs.tasks, thread) return thread end
getgenv().AutoTycoonCleanup = function()
    if getgenv().AutoTycoonGui and getgenv().AutoTycoonGui.Parent then
        pcall(function() getgenv().AutoTycoonGui:Destroy() end)
    end
    for _, c in ipairs(getgenv().AutoTycoonRefs.conns) do pcall(function() c:Disconnect() end) end
    for _, t in ipairs(getgenv().AutoTycoonRefs.tasks) do pcall(function() task.cancel(t) end) end
    getgenv().AutoTycoonRefs = {conns = {}, tasks = {}}
    warn("[Auto Tycoon] Old instance cleaned.")
end

