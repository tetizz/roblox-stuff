MasteryLbl.TextYAlignment = Enum.TextYAlignment.Top
MasteryLbl.TextWrapped = true
MasteryLbl.TextTruncate = Enum.TextTruncate.None

-- Vars & tracking
local SCAN_INT = 0.3
local running, autoWpnRunning, busy, rebirthing, didUpg = false, false, false, false, false
local char, hum, hrp
local PlayerData, ManaVal
local sessionStart = tick()
local rebirthStartTime, rebirthEndTime = nil, nil
local rebirthStarted = false
local buttonPressCount = 0
local rebirthDurations, rebirthButtonCounts = {}, {}
local REBIRTH_STATS_HISTORY = 10

-- Anti-AFK
local function antiAFK()
    while true do
        if hum and hrp then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
            hrp.CFrame = hrp.CFrame + Vector3.new(0, math.random(1, 2), 0)
        end
        task.wait(60)
    end
end
task.spawn(antiAFK)

local function notify(msg)
    Library:Notify({Title = "Auto Tycoon", Description = msg, Time = 2})
end

local function formatTime(sec)
    sec = math.floor(sec)
    local min = math.floor(sec / 60)
    sec = sec % 60
    return ("%dm %ds"):format(min, sec)
end

local function updateMasteryLabels(masteryStr)
    MasteryLbl:SetText(masteryStr)
    local textSize = TextService:GetTextSize(
        masteryStr,
        MasteryLbl.TextSize or 14,
        MasteryLbl.Font or Enum.Font.SourceSans,
        Vector2.new(MasteryLbl.AbsoluteSize.X, math.huge)
    )
    MasteryLbl:SetSize(Vector2.new(MasteryLbl.AbsoluteSize.X, textSize.Y + 12))
end

local function updateAutofarmStats()
    local lastDuration = rebirthDurations[#rebirthDurations]
    if lastDuration then
        RebirthTimeLbl:SetText(("Rebirth Duration: %s"):format(formatTime(lastDuration)))
    else
        RebirthTimeLbl:SetText("Rebirth Duration: N/A")
    end
    if #rebirthDurations > 0 then
        local sum = 0
        for _, v in ipairs(rebirthDurations) do sum += v end
        AverageTimeLbl:SetText(("Average Duration: %s"):format(formatTime(sum / #rebirthDurations)))
    else
        AverageTimeLbl:SetText("Average Duration: N/A")
    end
    local lastCount = rebirthButtonCounts[#rebirthButtonCounts]
    if lastCount and lastDuration then
        ButtonsPressedLbl:SetText(("Buttons Pressed: %d"):format(lastCount))
        ButtonsPerMinLbl:SetText(("Buttons/min: %.1f"):format(lastCount / (lastDuration / 60)))
    else
        ButtonsPressedLbl:SetText("Buttons Pressed: N/A")
        ButtonsPerMinLbl:SetText("Buttons/min: N/A")
    end
    local sessionTime = tick() - sessionStart
    SessionTimeLbl:SetText(("Session Time: %s"):format(formatTime(sessionTime)))
end

local function getMasteryStr()
    if not PlayerData then return "No PlayerData" end
    local mastery = PlayerData:FindFirstChild("Mastery")
    if not mastery then return "No Mastery" end
    local t = {}
    for _, c in ipairs(mastery:GetChildren()) do
        table.insert(t, string.format("%s: %s", c.Name, tostring(c.Value)))
    end
    return table.concat(t, "\n")
end

task.spawn(function()
    repeat PlayerData = plr:FindFirstChild("PlayerData") task.wait(0.1) until PlayerData
    repeat ManaVal = PlayerData:FindFirstChild("Mana") task.wait(0.1) until ManaVal
    updateMasteryLabels(getMasteryStr())
end)

local function bindChar(c)
    char = c
    hum = c:WaitForChild("Humanoid")
    hrp = c:WaitForChild("HumanoidRootPart")
end
if plr.Character then bindChar(plr.Character) end
plr.CharacterAdded:Connect(bindChar)

local function getMana()
    return (ManaVal and ManaVal.Value) or 0
end

local function attrAnywhere(m, k)
    if m:GetAttribute(k) ~= nil then return true end
    for _, d in ipairs(m:GetDescendants()) do
        if d:GetAttribute(k) ~= nil then return true end
    end
    return false
end

local function getBtnPos(inst)
    local m = inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
    if not m then return nil end
    if m.PrimaryPart then return m.PrimaryPart.Position end
    return m:GetPivot().Position
end

local function validBtn(inst)
    local m = inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
    if not m or not m:FindFirstChild("Button_Indicator", true) then return false end
    if not attrAnywhere(m, "Premium") and not attrAnywhere(m, "RebirthReq") then return false end
    if getMana() < (inst:GetAttribute("UnlockCost") or math.huge) then return false end
    if not getBtnPos(inst) then return false end
    return true, inst:GetAttribute("UnlockCost"), getBtnPos(inst)
end

local function gatherCands(root)
    local res = {}
    for _, inst in ipairs(root:GetDescendants()) do
        local ok, c = validBtn(inst)
        if ok then table.insert(res, {inst = inst, cost = c}) end
    end
    return res
end

local function bringBtn(inst)
    if not hrp then return end
    local m = inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
    if m and m.PrimaryPart then
        local offset = (hrp.CFrame * CFrame.new(0, 0, -2)).Position - m.PrimaryPart.Position
        for _, p in ipairs(m:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CanCollide = false
                p.Massless = true
                p.CFrame = p.CFrame + offset
            end
        end
    end
end

local function triggerPrompt(tgt)
    local prompt = tgt:FindFirstChildOfClass("ProximityPrompt") or (tgt.Parent and tgt.Parent:FindFirstChildOfClass("ProximityPrompt"))
    if prompt and prompt.Enabled then
        prompt:InputHoldBegin()
        task.wait(prompt.HoldDuration + 0.05)
        prompt:InputHoldEnd()
    end
end

local function teleportDebrisParts()
    local debris = Workspace:FindFirstChild("Debris")
    if not debris or not hrp then return end
    for _, name in ipairs({"Premium_Manana", "Manana", "Purple_Crystal", "Blue_Crystal"}) do
        local part = debris:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            part.CanCollide = false
            part.Massless = true
            part.CFrame = hrp.CFrame
            repeat task.wait(0.05) until not debris:FindFirstChild(name)
            break
        end
    end
end

local function doRebirth()
    rebirthing = true
    didUpg = false
    notify("Starting rebirth...")
    local repEv = ReplicatedStorage:WaitForChild("RemoteEvents")
    repEv.RebirthCallback:InvokeServer(plr)
    task.wait(3)
    if not didUpg then
        local points = PlayerData and PlayerData.UpgradePoints
        if points and points.Value > 0 then
            for _, s in ipairs({"Jump", "Speed", "Regen", "Health"}) do
                repEv.UpgradeCallback:InvokeServer(s)
            end
            didUpg = true
        end
    end
    repEv.PickCallback:InvokeServer()
    rebirthing = false
    updateMasteryLabels(getMasteryStr())
end

-- Returns true if player backpack has the specified weapon name
local function hasWeapon(name)
    local backpack = plr:FindFirstChild("Backpack")
    if not backpack then return false end
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool.Name == name then return true end
    end
    return false
end

-- Auto weapon pickup logic - scans all tycoon grandchildren SpellStands for weapons you don't own
local function autoGetWeapon()
    if not hrp then return end
    local tycoonsFolder = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Tycoons")
    if not tycoonsFolder then return end

    for _, tycoonModel in ipairs(tycoonsFolder:GetChildren()) do
        for _, grandchild in ipairs(tycoonModel:GetChildren()) do
            if grandchild:IsA("Model") and string.find(grandchild.Name, "SpellStand") then
                local prompts = {}
                for _, d in ipairs(grandchild:GetDescendants()) do
                    if d:IsA("ProximityPrompt") then
                        table.insert(prompts, d)
                    end
                end
                if #prompts < 2 then continue end

                local weaponName
                for _, prompt in ipairs(prompts) do
                    if prompt.ActionText and prompt.ActionText ~= "" then
                        weaponName = prompt.ActionText
                    end
                end
                if not weaponName then continue end

                if hasWeapon(weaponName) then continue end

                if not grandchild.PrimaryPart then
                    local prim = grandchild:FindFirstChildWhichIsA("BasePart")
                    if prim then grandchild.PrimaryPart = prim end
                end
                if grandchild.PrimaryPart then
                    grandchild:SetPrimaryPartCFrame(hrp.CFrame * CFrame.new(0, 0, -2))
                end

                for _, prompt in ipairs(prompts) do
                    if prompt.Enabled and (hrp.Position - prompt.Parent.Position).Magnitude <= prompt.MaxActivationDistance then
                        prompt:InputHoldBegin()
                        task.wait(prompt.HoldDuration + 0.1)
                        prompt:InputHoldEnd()
                    end
                end

                StatusLbl:SetText("Collected weapon: " .. weaponName)
                return
            end
        end
    end
end

task.spawn(function()
    local lastButtonValue = nil
    while true do
        updateAutofarmStats()
        local bp = plr:FindFirstChild("ButtonProgress")
        local unld = bp and bp:FindFirstChild("UnlockedButtons")
        local tot = bp and bp:FindFirstChild("TotalButtons")
        if unld and tot then
            ButtonsLbl:SetText(("Buttons unlocked: %d / %d"):format(unld.Value, tot.Value))
            if unld.Value == 0 then
                rebirthStarted = false
                rebirthStartTime = nil
                buttonPressCount = 0
                lastButtonValue = 0
            end
            if not rebirthStarted and unld.Value > 0 and not rebirthStartTime then
                rebirthStartTime = tick()
                rebirthStarted = true
                buttonPressCount = 1
                lastButtonValue = unld.Value
            end
            if rebirthStarted and unld.Value > lastButtonValue then
                buttonPressCount += (unld.Value - lastButtonValue)
                lastButtonValue = unld.Value
            end
            if rebirthStarted and unld.Value == tot.Value and rebirthStartTime then
                rebirthEndTime = tick()
                local dur = rebirthEndTime - rebirthStartTime
                table.insert(rebirthDurations, dur)
                table.insert(rebirthButtonCounts, buttonPressCount)
                while #rebirthDurations > REBIRTH_STATS_HISTORY do table.remove(rebirthDurations, 1) end
                while #rebirthButtonCounts > REBIRTH_STATS_HISTORY do table.remove(rebirthButtonCounts, 1) end
                updateAutofarmStats()
                rebirthStarted = false
                rebirthStartTime, rebirthEndTime, lastButtonValue = nil, nil, 0
                if running then
                    doRebirth()
                else
                    notify("All buttons unlocked. Auto Buttons is OFF; no auto rebirth.")
                end
            end
        else
            ButtonsLbl:SetText("Buttons unlocked: N/A")
        end
        ManaLbl:SetText("Mana: " .. tostring(getMana()))
        teleportDebrisParts()

        if running and not busy and not rebirthing then
            busy = true
            local tycoon = Workspace.Map.Tycoons:FindFirstChild(plr.Name)
            if tycoon then
                local cands = gatherCands(tycoon)
                if #cands > 0 then
                    local targ = cands[1]
                    StatusLbl:SetText("Bringing: " .. targ.inst.Name)
                    bringBtn(targ.inst)
                    task.wait(0.05)
                    triggerPrompt(targ.inst)
                end
            else
                StatusLbl:SetText("Tycoon not found")
            end
            busy = false
        end

        if autoWpnRunning and not busy and not rebirthing then
            busy = true
            autoGetWeapon()
            busy = false
        end

        task.wait(SliderScan.Value or SCAN_INT)
    end
end)

