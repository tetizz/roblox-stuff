local function getBtnPos(inst)
    local m = inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
    if not m then return nil end
    return m.PrimaryPart and m.PrimaryPart.Position or m:GetPivot().Position
end

local function validBtn(inst, mana, rebirths)
    local m = inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
    if not (m and m:FindFirstChild("Button_Indicator", true)) then return false end
    local rebirthReq = m:GetAttribute("RebirthReq")
    if type(rebirthReq) ~= "number" then return false end
    if rebirthReq > rebirths then return false end
    if mana < (inst:GetAttribute("UnlockCost") or math.huge) then return false end
    return getBtnPos(inst) ~= nil
end

local ButtonCache = {
    Root = nil,
    List = {},
    CheckedAt = 0,
    Interval = 1
}

local function getButtonCandidates(root)
    local t = tick()
    if ButtonCache.Root == root and (t - ButtonCache.CheckedAt) < ButtonCache.Interval then
        return ButtonCache.List
    end

    local list = {}
    for _, inst in ipairs(root:GetDescendants()) do
        if inst:GetAttribute("UnlockCost") ~= nil then
            local m = inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
            if m and m:FindFirstChild("Button_Indicator", true) then
                list[#list + 1] = inst
            end
        end
    end

    ButtonCache.Root = root
    ButtonCache.List = list
    ButtonCache.CheckedAt = t
    return list
end

local function findFirstValidBtn(root)
    local mana = getMana()
    local rebirths = getRebirths()

    for _, inst in ipairs(getButtonCandidates(root)) do
        if validBtn(inst, mana, rebirths) then
            return inst
        end
    end
end

