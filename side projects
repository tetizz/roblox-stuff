local ETALabel = StatsPanel:AddLabel("ETA: Calculating...")

local function updateStatsUI()
    if not AvgTimeLabel or not ETALabel or not TargetSlider then return end
    local avgRebirth = getAverageRebirthTime()
    if avgRebirth then
        AvgTimeLabel:SetText("Average Rebirth: " .. formatTime(avgRebirth))
    else
        AvgTimeLabel:SetText("Average Rebirth: Calculating...")
    end

    local rebirthVal = plr:FindFirstChild("PlayerData") and plr.PlayerData:FindFirstChild("Rebirth")
    local cur = (rebirthVal and rebirthVal.Value) or 0

    if TargetSlider.SetMin then
        TargetSlider:SetMin(cur + 1)
    end

    local tVal = TargetSlider.Value
    if tVal < cur + 1 then
        TargetSlider:SetValue(cur + 1)
    end
    if avgRebirth then
        local left = math.max(0, TargetSlider.Value - cur)
        local etaSec = left * avgRebirth
        local h = math.floor(etaSec / 3600)
        local m = math.floor((etaSec % 3600) / 60)
        local etaText = (h > 0 and string.format("%dh ", h) or "") .. string.format("%dm", m)
        ETALabel:SetText("ETA: " .. etaText)
    else
        ETALabel:SetText("ETA: Calculating...")
    end
end

if TargetSlider and TargetSlider.OnChanged then
    TargetSlider:OnChanged(function(value)
        local roundedValue = math.floor(value + 0.5)
        if roundedValue < TargetSlider.Min then
            roundedValue = TargetSlider.Min
        elseif roundedValue > TargetSlider.Max then
            roundedValue = TargetSlider.Max
        end
        if roundedValue ~= value then
            TargetSlider:SetValue(roundedValue)
        end
        updateStatsUI()
    end)
end

local running, debrisOn, collectResizerOn, autoWeatherOn = false, false, false, false
local busy, rebirthing = false, false

local persistedSettings = {
    autoWeatherOn = false,
