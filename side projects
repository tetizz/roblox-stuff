MasteryLbl.TextYAlignment = Enum.TextYAlignment.Top
MasteryLbl.TextWrapped = true
MasteryLbl.TextTruncate = Enum.TextTruncate.None

--=== Vars & Tracking ===
local SCAN_INT = 0.3
local running, autoWpnRunning, busy, rebirthing, didUpg = false, false, false, false, false
local char, hum, hrp
local PlayerData, ManaVal
local sessionStart = tick()
local rebirthStartTime, rebirthEndTime
local rebirthStarted = false
local buttonPressCount = 0
local rebirthDurations, rebirthButtonCounts = {}, {}
local REBIRTH_STATS_HISTORY = 10

--=== Helper Functions ===
local function notify(msg) Library:Notify({Title = "Auto Tycoon", Description = msg, Time = 2}) end
local function formatTime(sec) local m = math.floor(sec/60) sec=math.floor(sec%60) return ("%dm %ds"):format(m, sec) end

local function updateMasteryLabels(masteryStr)
    if not MasteryLbl then return end
    MasteryLbl:SetText(masteryStr)
    local width = (MasteryLbl.AbsoluteSize and MasteryLbl.AbsoluteSize.X) or 200
    local textSize = TextService:GetTextSize(masteryStr, MasteryLbl.TextSize or 14, MasteryLbl.Font or Enum.Font.SourceSans, Vector2.new(width, math.huge))
    MasteryLbl:SetSize(Vector2.new(width, textSize.Y + 12))
end

local function updateAutofarmStats()
    local lastDuration = rebirthDurations[#rebirthDurations]
    if lastDuration then RebirthTimeLbl:SetText(("Rebirth Duration: %s"):format(formatTime(lastDuration))) else RebirthTimeLbl:SetText("Rebirth Duration: N/A") end
    if #rebirthDurations > 0 then
        local sum = 0 for _, v in ipairs(rebirthDurations) do sum += v end
        AverageTimeLbl:SetText(("Average Duration: %s"):format(formatTime(sum/#rebirthDurations)))
    else AverageTimeLbl:SetText("Average Duration: N/A") end
    local lastCount = rebirthButtonCounts[#rebirthButtonCounts]
    if lastCount and lastDuration then
        ButtonsPressedLbl:SetText(("Buttons Pressed: %d"):format(lastCount))
        ButtonsPerMinLbl:SetText(("Buttons/min: %.1f"):format(lastCount / (lastDuration / 60)))
    else
        ButtonsPressedLbl:SetText("Buttons Pressed: N/A")
        ButtonsPerMinLbl:SetText("Buttons/min: N/A")
    end
    SessionTimeLbl:SetText(("Session Time: %s"):format(formatTime(tick() - sessionStart)))
end

local function getMasteryStr()
    if not PlayerData then return "No PlayerData" end
    local mastery = PlayerData:FindFirstChild("Mastery")
    if not mastery then return "No Mastery" end
    local t = {} for _, c in ipairs(mastery:GetChildren()) do table.insert(t, string.format("%s: %s", c.Name, tostring(c.Value))) end
    return table.concat(t, "\n")
end

--=== Init Data ===
task.spawn(function()
    repeat PlayerData = plr:FindFirstChild("PlayerData") task.wait(0.1) until PlayerData
    repeat ManaVal = PlayerData:FindFirstChild("Mana") task.wait(0.1) until ManaVal
    updateMasteryLabels(getMasteryStr())
end)

--=== Char bind ===
