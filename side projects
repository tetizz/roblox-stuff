    running = false,
    collectResizerOn = false,
}

local MAX_REBIRTH_HISTORY = 10
local rebirthData = {}
local rebirthCycleCount = 0

local function formatTime(seconds)
    local m = math.floor(seconds / 60)
    local s = math.floor(seconds % 60)
    return string.format("%dm %02ds", m, s)
end

local function getAverageRebirthTime()
    local sum, ct = 0, 0
    for _, v in ipairs(rebirthData) do
        if v.totalTime then sum = sum + v.totalTime; ct = ct + 1 end
    end
    if ct == 0 then return nil end
    return sum / ct
end

local function getMana()
    local PD = plr:FindFirstChild("PlayerData")
    local ManaVal = PD and PD:FindFirstChild("Mana")
    return ManaVal and ManaVal.Value or 0
end

local function getRebirths()
    local PD = plr:FindFirstChild("PlayerData")
    local rVal = PD and PD:FindFirstChild("Rebirth")
    return (rVal and typeof(rVal.Value) == "number") and rVal.Value or 0
end

local function getBtnPos(inst)
    local m = inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
    if not m then return nil end
    return m.PrimaryPart and m.PrimaryPart.Position or m:GetPivot().Position
end

local function validBtn(inst)
    local m = inst:IsA("Model") and inst or inst:FindFirstAncestorWhichIsA("Model")
    if not m then return false end
    if not m:FindFirstChild("Button_Indicator", true) then return false end
    local rebirthReq = m:GetAttribute("RebirthReq")
    if type(rebirthReq) ~= "number" then return false end
    if rebirthReq > getRebirths() then return false end
    if getMana() < (inst:GetAttribute("UnlockCost") or math.huge) then return false end
    if not getBtnPos(inst) then return false end
    return true
end

local function gatherCands(root)
    local res = {}
    for _, inst in ipairs(root:GetDescendants()) do
        if validBtn(inst) then
            table.insert(res, inst)
        end
    end
    return res
end

